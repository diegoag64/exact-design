use Icon from "./icons.contract"
use Tool, SmallTool, Field, FieldShell, TreeRow, PanelSection, SectionHead, FloatingBar, Segmented, Segment, RowButton, PrimaryButton, SecondaryButton, Dialog, Menu, IconButton, SmallButton, ToolbarButton, SectionHeading, FieldLabel, InlineField, MenuItem, MenuDivider, Divider, Kbd, PropertyField, VisibilityButton, screensWidth, inspectorWidth from "./ui.contract"

routes nav
  editor "/"
    project "/project"
    addScreen "/add-screen"

shape SnapTarget
  value: number
  guide: number
  start: number
  end: number
  gap: bool

fn propertyIcon(property: string, value: string): string = property == "flex-direction" ? (value.startsWith("row") ? "columns-2" : "rows-2") : property == "align-items" ? (value == "flex-start" ? "align-vertical-justify-start" : value == "center" ? "align-vertical-justify-center" : value == "flex-end" ? "align-vertical-justify-end" : value == "stretch" ? "move-vertical" : "align-vertical-justify-end") : value == "flex-start" ? "align-horizontal-justify-start" : value == "center" ? "align-horizontal-justify-center" : value == "flex-end" ? "align-horizontal-justify-end" : "between-horizontal-start"

fn deviceIcon(name: string): string = name.includes("Phone") or name == "Android" ? "smartphone" : name.includes("iPad") or name == "Tablet" ? "tablet" : "monitor"
fn propertyPrefix(property: string): string = property == "left" ? "X" : property == "top" ? "Y" : property == "width" ? "W" : property == "height" ? "H" : ""
fn propertyGlyph(property: string): string = property == "rotate" ? "rotate-cw" : property == "opacity" ? "blend" : property == "border-radius" ? "radius" : property == "font-size" ? "a-large-small" : property == "line-height" ? "baseline" : property == "letter-spacing" ? "whole-word" : property == "z-index" ? "layers" : property == "border-width" ? "minus" : property == "gap" or property == "row-gap" or property == "column-gap" ? "between-horizontal-start" : ""
fn compoundIcon(property: string): string = property == "padding" ? "square-dashed" : property == "margin" ? "scan" : property == "border-radius" ? "radius" : "between-horizontal-start"
fn fieldPrefix(label: string): string = label == "Top" ? "T" : label == "Right" ? "R" : label == "Bottom" ? "B" : label == "Left" ? "L" : label == "Top left" ? "TL" : label == "Top right" ? "TR" : label == "Bottom right" ? "BR" : label == "Bottom left" ? "BL" : label == "Row" ? "↕" : label == "Column" ? "↔" : label
fn swatchable(property: string, value: string): bool = (property == "color" or property.endsWith("-color")) and (value.startsWith("#") or value.startsWith("rgb") or value.startsWith("hsl"))
fn magnitude(n: number): number = max(n, -n)
fn panEase(t: number): number = 1 - (1 - t) * (1 - t) * (1 - t)
fn layerKind(kind: string): string = kind == "text" or kind == "span" ? "Text" : kind == "button" ? "Button" : kind == "row" ? "Row" : kind == "column" ? "Column" : kind == "scroll" ? "Scroll" : kind == "grid" ? "Grid" : kind == "image" or kind == "img" ? "Image" : kind == "screen" or kind == "main" ? "Screen" : kind == "input" ? "Input" : kind == "rectangle" ? "Rectangle" : "Container"
fn spacingName(property: string): string = property == "padding-top" ? "Top padding" : property == "padding-right" ? "Right padding" : property == "padding-bottom" ? "Bottom padding" : property == "padding-left" ? "Left padding" : property == "row-gap" ? "Vertical gap" : "Horizontal gap"

fn snappedDelta(targets: SnapTarget[], origin: number, delta: number, zoom: number): number = match first(sortBy(targets, t => magnitude(t.value - origin - delta))) { case some(t) => magnitude(t.value - origin - delta) <= 8 / zoom ? t.value - origin : delta, case none => delta }

shape Layer
  id: string
  kind: string
  name: string
  x: number
  y: number
  width: number
  height: number
  fill: string
  text: string
  fontSize: number
  radius: number
  widthMode: string
  right: number

shape NativeShot
  id: string
  state: string
  shot: string
  width: number
  height: number
  capturedAt: number
  error: string

shape NativeStatus
  state: string
  phase: string
  message: string
  error: string
  done: number
  total: number
  frames: NativeShot[]

shape CanvasView
  platform: string
  canAutoHeight: bool
  autoHeight: bool
  source: string
  previewSource: string
  layers: Layer[]
  id: string
  screenId: string
  screenName: string
  name: string
  x: number
  y: number
  width: number
  height: number
  hidden: bool

shape LibraryView
  id: string
  name: string
  x: number
  y: number
  width: number
  height: number
  hidden: bool

shape ScreenGroup
  id: string
  name: string
  route: string
  source: string
  hidden: bool
  views: LibraryView[]
  layers: Layer[]

shape Document
  platform: string
  nativeRequests: string
  previewSource: string
  previewRequests: string
  projectName: string
  projectUrl: string
  route: string
  groups: ScreenGroup[]
  frameX: number
  frameY: number
  snapX: SnapTarget[]
  snapY: SnapTarget[]
  source: string
  views: CanvasView[]
  active: string
  screenId: string
  frameSelected: bool
  width: number
  height: number
  screenName: string
  minX: number
  minY: number
  maxX: number
  maxY: number
  drawing: string
  name: string
  layers: Layer[]
  selected: string
  canUndo: bool
  canRedo: bool
  code: string
  status: string
  resizing: bool
  devices: DeviceOption[]
  deviceSets: DeviceSet[]

shape DeviceOption
  name: string
  slug: string
  kind: string
  platform: string
  width: number
  height: number
  label: string

shape DeviceSet
  name: string
  slug: string
  label: string
  count: number

shape Reply
  error: string
  ok: bool
  fit: bool
  minX: number
  minY: number
  maxX: number
  maxY: number

shape DiscoveredScreen
  name: string
  route: string
  dynamic: bool
  added: bool

shape Discovery
  owner: string
  routes: DiscoveredScreen[]
  error: string

shape HistoryChange
  id: string
  target: string
  property: string
  before: string
  after: string

shape HistoryEntry
  icon: string
  id: string
  number: number
  label: string
  target: string
  actor: string
  kind: string
  time: string
  timeLabel: string
  changes: HistoryChange[]

shape History
  entries: HistoryEntry[]
  error: string

shape DesignRow
  id: string
  name: string
  value: string
  shared: bool
  group: string
  options: LayoutOption[]
  property: string
  binding: string
  readonly: bool
  canOverride: bool
  added: bool
  reason: string
  fields: DesignField[]
  linked: bool

fn firstField(fields: DesignField[]): string = match first(fields) { case some(field) => field.value, case none => "" }

shape DesignField
  id: string
  label: string
  value: string

shape LayoutOption
  value: string
  label: string

shape SpacingInput
  property: string
  value: string
  shared: bool

shape SpacingBox
  key: string
  property: string
  x: number
  y: number
  width: number
  height: number
  labelX: number
  labelY: number
  value: string
  label: bool

shape SpacingMeasurement
  frame: string
  id: string
  plan: string
  boxes: SpacingBox[]

shape PreviewSignal
  revision: number
  updateRevision: number
  measurement: SpacingMeasurement

shape DesignReply
  operation: string
  historyChanged: bool
  instances: number
  draftCount: number
  draftState: string
  draftError: string
  canApply: bool
  ok: bool
  error: string
  session: string
  origin: string
  source: string
  component: string
  version: number
  selectionRevision: number
  message: string
  rows: DesignRow[]
  availableProperties: LayoutOption[]
  canUndo: bool
  applied: bool
  draftFiles: DraftFile[]
  bridgeOrigin: string
  tree: ElementNode[]
  crumbs: ElementNode[]
  selectedLabel: string
  restoring: bool
  selecting: bool
  spacingId: string
  spacingPlan: string
  spacingFrame: string
  spacingInputs: SpacingInput[]

shape DraftChange
  key: string
  location: string
  line: number
  property: string
  name: string
  icon: string
  element: string
  before: string
  after: string
  added: bool
  replaced: bool
  shared: bool
  swatchBefore: string
  swatchAfter: string

shape DraftFile
  file: string
  changes: DraftChange[]

shape ElementNode
  id: string
  label: string
  depth: number
  selected: bool
  kind: string
  ancestors: string[]
  hasChildren: bool

shape Viewport
  prefersReducedMotion: bool
  width: number
  height: number

shape PreviewSizes
  requests: string
  ready: bool
  signature: string
  loaded: number
  total: number

keyframes veilIn
  from opacity=0
keyframes veilOut
  to opacity=0 animation-timing-function="ease-in"
keyframes framePulse
  0% opacity=0.25 translate="0px 0px"
  35% opacity=1 translate="0px -3px"
  70% opacity=0.25 translate="0px 0px"
  100% opacity=0.25 translate="0px 0px"

shape Time
  epochAtZero: number

component Studio
  resource time = exactTime() as shape Time
  resource viewport = exactViewport() as shape Viewport
  resource doc = document() with time.epochAtZero as shape Document else empty(name="Untitled")
  state discoveryRevision = 0
  // Each press sends a fresh run token. nativeCapture lists the frame ids to capture again
  // (comma-separated); empty refreshes every frame that is not current.
  state nativeRun = ""
  state nativeCapture = ""
  state nativeSeen = ""
  resource native = native(doc.nativeRequests, nativeRun, nativeCapture) as shape NativeStatus else empty()
  action refreshNative
    nativeRun = `${time.epochAtZero + performanceNow()}`
    nativeCapture = ""
  action refreshNativeFrame(id: string)
    nativeRun = `${time.epochAtZero + performanceNow()}`
    nativeCapture = id
  action dismissNative
    nativeSeen = nativeRun
  // A finished refresh's message ("Native previews updated.", "… up to date.") shows briefly, like Saved.
  derive nativeDone = nativeRun != "" and nativeSeen != nativeRun and native.state == "idle" and native.message != "" and not pending(native)
  task nativeFade when nativeDone key=nativeRun
    after(2400, dismissNative)
  resource previews = previews(doc.previewRequests) as shape PreviewSizes else empty()
  resource renderedScene = scene(doc.drawing, previews.signature) with time.epochAtZero as shape Document else empty()
  derive scene = renderedScene.active != "" ? renderedScene : doc
  resource discovered = discover(doc.projectUrl, doc.groups.map(g => g.route), discoveryRevision) as shape Discovery else empty()
  resource history = history(doc.projectUrl) as shape History else empty()
  state timelineOpen = false persist
  state statusSeen = ""
  action dismissStatus
    statusSeen = doc.status
  action resetStatus
    statusSeen = ""
  task statusFade when doc.status == "Saved" and statusSeen != "Saved"
    after(2400, dismissStatus)
  task statusReset when doc.status == "" and statusSeen != ""
    after(1, resetStatus)
  state historySelected = ""
  action toggleTimeline
    timelineOpen = not timelineOpen
  action inspectHistory(id: string)
    historySelected = historySelected == id ? "" : id
  mutation changed as shape Reply queue refreshes doc, history then afterEdit
  mutation libraryChanged as shape Reply queue refreshes doc, history then afterLibrary
  mutation designChanged as shape DesignReply queue then afterDesign
  mutation hoverChanged as shape DesignReply queue
  resource previewSignal = previewSignal(designSession) as shape PreviewSignal else empty()
  derive spacingMeasured = editing ? some(previewSignal.measurement) : none
  state previewUpdateSeen = -1
  action previewUpdated
    previewUpdateSeen = previewSignal.updateRevision
    pollDesign()
  task pushedPreview when editing and not pending(designChanged) and previewSignal.updateRevision != previewUpdateSeen
    after(1, previewUpdated)
  state spacingProperty = ""
  state spacingValue = ""
  state designSession = ""
  state hoveredElement = ""
  action hoverElement(id: string, on: bool)
    if editing and (on or hoveredElement == id)
      let next = on ? id : ""
      hoveredElement = next
      send hoverChanged = design("hover", designSession, "", 0, next, "", time.epochAtZero + performanceNow())
  state collapsedElements = [""]
  state revealedLayerRevision = -1
  action revealSelectedLayer
    match designChanged
      case some(r)
        collapsedElements = collapsedElements.filter(id => not r.crumbs.map(c => c.id).includes(id))
        match first(r.tree.filter(e => e.selected))
          case some(selected)
            scrollIntoView(`layer-row-${selected.id}`, block="nearest", inline="nearest", behavior="instant")
          case none
            hand = hand
        revealedLayerRevision = r.selectionRevision
      case none
        hand = hand
  task revealLayerPanel when editing and leftOpen
    after(1, revealSelectedLayer)
  action toggleElement(id: string)
    collapsedElements = collapsedElements.includes(id) ? collapsedElements.filter(value => value != id) : collapsedElements.concat([id])
  state designOrigin = ""
  state designWriting = false
  state designVersion = 0
  derive editing = designSession != ""
  derive selectingElement = match designChanged { case some(r) => r.selecting, case none => false }
  derive designRows = match designChanged { case some(r) => r.rows, case none => [] }
  derive elementTree = match designChanged { case some(r) => r.tree, case none => [] }
  derive appCanUndo = match designChanged { case some(r) => r.canUndo, case none => false }
  state designError = ""
  action startEditing
    if doc.platform != "ios"
      booting = false
      hand = false
      collapsedElements = [""]
      revealedLayerRevision = -1
      previewUpdateSeen = -1
      designWriting = true
      rightPanel = "open"
      send designChanged = design("open", "", doc.source, 0, doc.active, "", time.epochAtZero + performanceNow())
  action finishEditing
    reviewOpen = false
    spacingProperty = ""
    hoveredElement = ""
    designWriting = true
    send designChanged = design("close", designSession, "", 0, "", "", time.epochAtZero + performanceNow())
    designSession = ""
  action toggleEditing
    if editing
      finishEditing()
    else
      startEditing()
  action pollDesign
    if not pending(designChanged)
      send designChanged = design("poll", designSession, "", 0, "", "", time.epochAtZero + performanceNow())
  task designPoll when editing and not selectingElement
    every(750, pollDesign)
  task selectionPoll when editing and selectingElement
    every(50, pollDesign)
  action overrideProperty(id: string)
    designWriting = true
    send designChanged = design("override", designSession, "", designVersion, id, "", time.epochAtZero + performanceNow())
  action addDesignProperty(property: string)
    if property != ""
      designWriting = true
      send designChanged = design("add-property", designSession, "", designVersion, property, "", time.epochAtZero + performanceNow())
  state collapsedDesignSections = ["Effects"]
  action toggleDesignSection(section: string)
    collapsedDesignSections = collapsedDesignSections.includes(section) ? collapsedDesignSections.filter(s => s != section) : collapsedDesignSections.concat([section])
  state independentFields = [""]
  action toggleFieldLink(id: string, binding: string, value: string, independent: bool)
    if independent
      independentFields = independentFields.filter(b => b != binding)
      designWriting = true
      send designChanged = design("field", designSession, "", designVersion, `${id}:all`, value, time.epochAtZero + performanceNow())
    else
      independentFields = independentFields.concat([binding])
  action editDesignField(row: string, part: string, value: string)
    designWriting = true
    send designChanged = design("field", designSession, "", designVersion, `${row}:${part}`, value, time.epochAtZero + performanceNow())
  action editDesign(row: string, value: string)
    designWriting = true
    send designChanged = design("edit", designSession, "", designVersion, row, value, time.epochAtZero + performanceNow())
  action editSpacing(value: string)
    spacingValue = value
  action openSpacing(property: string, value: string)
    spacingProperty = property
    spacingValue = value
    selectText("spacing-value")
  action cancelSpacing
    spacingProperty = ""
  action spacingKey(key: string)
    if key == "Escape"
      preventDefault()
      spacingProperty = ""
    if key == "Enter"
      preventDefault()
      designWriting = true
      send designChanged = design("spacing", designSession, "", designVersion, spacingProperty, spacingValue, time.epochAtZero + performanceNow())
      spacingProperty = ""
  action undoDesign
    designWriting = true
    send designChanged = design("undo", designSession, "", 0, "", "", time.epochAtZero + performanceNow())
  action applyDesign
    designWriting = true
    send designChanged = design("apply", designSession, "", 0, "", "", time.epochAtZero + performanceNow())
  state reviewOpen = false
  action toggleReview
    reviewOpen = not reviewOpen
  action revertDesign(key: string)
    designWriting = true
    send designChanged = design("revert", designSession, "", 0, key, "", time.epochAtZero + performanceNow())
  action discardDesign
    designWriting = true
    send designChanged = design("discard", designSession, "", 0, "", "", time.epochAtZero + performanceNow())
  action selectParent
    send designChanged = design("parent", designSession, "", 0, "", "", time.epochAtZero + performanceNow())
  action selectElement(id: string)
    send designChanged = design("select", designSession, "", designVersion, id, "", time.epochAtZero + performanceNow())
  action afterDesign
    match designChanged
      case some(r)
        if ["open", "close", "edit", "field", "spacing", "override", "add-property", "undo", "revert", "apply", "discard"].includes(r.operation)
          designWriting = false
        if r.ok and r.draftCount == 0
          reviewOpen = false
        if r.error != ""
          designError = r.error
        if r.ok
          if r.historyChanged
            refresh history
          if leftOpen and r.selectionRevision != revealedLayerRevision
            revealSelectedLayer()
          if r.version != designVersion or r.session == ""
            spacingProperty = ""
            designError = ""
          if r.origin != ""
            designOrigin = r.origin
            refresh doc
          designSession = r.session
          designVersion = r.version
      case none
        hand = hand
  state collapsed = [""] persist
  state addingViewport = false
  action toggleViewportMenu
    addingViewport = not addingViewport
  action addViewport(preset: string)
    addingViewport = false
    command("variant", preset)
  action addViewportSet(name: string)
    addingViewport = false
    startTidy()
    command("variants", name)
  action tidyUp
    command("arrange", "")
  state projectName = ""
  state projectUrl = ""
  state projectNameChanged = false
  state projectUrlChanged = false
  derive projectNameValue = projectNameChanged ? projectName : doc.projectName
  derive projectUrlValue = projectUrlChanged ? projectUrl : doc.projectUrl
  state screenName = ""
  state screenPath = "/"
  state screenPreset = "Phone"
  state screenKind = "blank"
  derive libraryError = match libraryChanged { case some(r) => r.error, case none => "" }
  action follow(url: string)
    nav = go(nav, url)
  action closeLibrary
    nav = back(nav)
  action projectSettings
    if editing
      finishEditing()
    projectNameChanged = false
    projectUrlChanged = false
    libraryChanged = none
    nav = go(nav, path("project"))
  action addScreen
    screenName = ""
    screenPath = "/"
    screenPreset = "Phone"
    screenKind = doc.projectUrl == "" ? "blank" : "add"
    libraryChanged = none
    nav = go(nav, path("addScreen"))
  action projectNameInput(value: string)
    projectName = value
    projectNameChanged = true
  action projectUrlInput(value: string)
    projectUrl = value
    projectUrlChanged = true
  action screenNameInput(value: string)
    screenName = value
  action screenPathInput(value: string)
    screenPath = value
  action choosePreset(value: string)
    screenPreset = value
  action chooseKind(value: string)
    screenKind = value
  action refreshDiscovery
    discoveryRevision = discoveryRevision + 1
  action chooseScreen(name: string, route: string)
    screenName = name
    screenPath = route
    libraryChanged = none
  action saveProject
    send libraryChanged = library("connect", projectNameValue, projectUrlValue, "", "", time.epochAtZero + performanceNow())
  action disconnectProject
    send libraryChanged = library("disconnect", "", "", "", "", time.epochAtZero + performanceNow())
  action addAllScreens
    startTidy()
    send libraryChanged = library("add-all", "", "", screenPreset, "", time.epochAtZero + performanceNow())
  action saveScreen
    if doc.deviceSets.filter(s => s.name == screenPreset).length > 0
      startTidy()
    send libraryChanged = library(screenKind, screenName, screenPath, screenPreset, "", time.epochAtZero + performanceNow())
  state hoveredRow = ""
  action hoverRow(id: string, on: bool)
    if on or hoveredRow == id
      hoveredRow = on ? id : ""
  action setVisibility(id: string, hidden: bool)
    send changed = edit((hidden ? "hide" : "show"), id, "", 0, 0, time.epochAtZero + performanceNow())
  action openView(id: string, hidden: bool, x: number, y: number, w: number, h: number)
    if hidden
      addingViewport = false
      send changed = edit("select", id, "", 0, 0, time.epochAtZero + performanceNow())
    else
      focusView(id, x, y, w, h)
  action toggleGroup(id: string)
    collapsed = collapsed.includes(id) ? collapsed.filter(value => value != id) : collapsed.concat([id])
  state fitWhenReady = false
  state fittedSignature = ""
  action finishLoadFit
    fitWhenReady = false
  task stopLoadFit when fitWhenReady
    after(2000, finishLoadFit)
  action fitLoadedScreens
    fittedSignature = previews.signature
    resetView()
  task fitLoaded when fitWhenReady and fittedSignature != previews.signature and previews.ready and previews.requests == doc.previewRequests and not pending(doc) and not pending(renderedScene)
    after(1, fitLoadedScreens)
  // After a bulk add, frames report content heights over several seconds. Tidy on each new measurement
  // for a short window (one merged undo step) and keep the camera fitted until the person pans or zooms.
  state tidyWhenReady = false
  state tidySignature = ""
  state tidyFit = false
  state tidyFitted = ""
  action startTidy
    tidyWhenReady = true
    tidySignature = ""
    tidyFit = true
    tidyFitted = ""
  action finishTidy
    tidyWhenReady = false
  task stopTidy when tidyWhenReady
    after(20000, finishTidy)
  action tidyLoadedScreens
    tidySignature = previews.signature
    command("arrange", "settle")
  task autoTidy when tidyWhenReady and previews.ready and previews.signature != tidySignature and previews.requests == doc.previewRequests and not pending(doc) and not pending(renderedScene) and not pending(libraryChanged) and not pending(changed)
    after(400, tidyLoadedScreens)
  action refitAfterTidy
    tidyFitted = tidySignature
    resetView()
  task tidyRefit when tidyFit and tidySignature != "" and tidyFitted != tidySignature and not pending(changed) and not pending(doc) and not pending(renderedScene)
    after(1, refitAfterTidy)
  // Page-load veil: covers the canvas from the first frame while live previews render, so frames appear together,
  // fitted. Its indicator fades in after a short delay, so a fast load shows only a blank canvas. It leaves the moment
  // every visible preview has reported, at once when there is none to wait for, and on a click or Edit app. A preview
  // can fail to report (an app error, a stopped app server), so it also leaves after 4 seconds without progress, or 15 in all.
  state booting = true
  state bootSeen = -1
  derive setupPending = setupUrl != "" and appliedSetup != setupKey and setupError == "" and not setupDismissed
  derive still = viewport.prefersReducedMotion
  action finishBoot
    booting = false
  task bootReady when booting and not pending(doc) and not setupPending and not setupRunning and previews.ready and previews.requests == doc.previewRequests and not pending(renderedScene)
    after(1, finishBoot)
  action trackBoot
    bootSeen = previews.loaded
  task bootProgress when booting and bootSeen != previews.loaded
    after(1, trackBoot)
  task bootStall when booting and bootSeen == previews.loaded and previews.total > 0
    after(4000, finishBoot)
  task bootTimeout when booting
    after(15000, finishBoot)
  derive addableScreens = discovered.routes.filter(r => not r.added and not r.dynamic).length
  // A setup link (`/?connect=<app url>&name=<name>&viewports=<set or device>&show=<screens>`) connects that project and adds
  // each of its screens once per browser; reloading the link leaves later edits alone. `show` lists the screens,
  // by name or route, that start visible; the others are added hidden so their previews do not load.
  derive setupUrl = top(nav).name == "editor" ? searchParam(top(nav), "connect") : ""
  derive setupName = searchParam(top(nav), "name") == "" ? "project" : searchParam(top(nav), "name")
  derive setupKey = `${setupUrl} ${searchParam(top(nav), "name")} ${searchParam(top(nav), "viewports")}${searchParam(top(nav), "show") == "" ? "" : " " + searchParam(top(nav), "show")}`
  state appliedSetup = "" persist
  state setupRunning = false
  state setupError = ""
  state setupDismissed = false
  action runSetup
    appliedSetup = setupKey
    setupError = ""
    setupRunning = true
    startTidy()
    send libraryChanged = library("setup", searchParam(top(nav), "name"), setupUrl, searchParam(top(nav), "viewports"), searchParam(top(nav), "show"), time.epochAtZero + performanceNow())
  action dismissSetupError
    setupError = ""
    setupDismissed = true
  // A failed setup (the app not started yet) runs again on the next load, unless its error was dismissed.
  task autoSetup when setupUrl != "" and appliedSetup != setupKey and setupError == "" and not setupDismissed and not pending(doc) and not pending(libraryChanged)
    after(1, runSetup)
  action afterLibrary
    match libraryChanged
      case some(r)
        if setupRunning
          setupRunning = false
          if not r.ok
            setupError = r.error
            appliedSetup = ""
            tidyWhenReady = false
        if r.ok
          if top(nav).name != "editor"
            nav = back(nav)
          if r.fit
            fitWhenReady = true
            fittedSignature = ""
            collapsed = [""]
            fitBounds(r.minX, r.minY, r.maxX, r.maxY)
      case none
        hand = hand
  state leftPanel = "auto" persist
  state rightPanel = "auto" persist
  derive leftOpen = (leftPanel == "open" or (leftPanel == "auto" and viewport.width >= 1000)) and (viewport.width >= 700 or rightPanel != "open")
  derive rightOpen = rightPanel == "open" or (rightPanel == "auto" and viewport.width >= 700)
  derive panelOverlay = (leftOpen and viewport.width < 1000) or (rightOpen and viewport.width < 700)
  state zoom = 0.85 persist
  // Canvas previews skip backdrop blurs and CSS animations, trading fidelity for less GPU work.
  state reducedEffects = false persist
  state px = 64 persist
  state py = 80 persist
  state panning = false
  state panFromX = 0
  state panFromY = 0
  state panStarted = 0
  state panProgress = 1
  derive cameraX = panning ? panFromX + (px - panFromX) * panEase(panProgress) : px
  derive cameraY = panning ? panFromY + (py - panFromY) * panEase(panProgress) : py
  derive canvasWidth = viewport.width - (leftOpen and viewport.width >= 1000 ? screensWidth() : 0) - (rightOpen and viewport.width >= 700 ? inspectorWidth() : 0)
  derive canvasCenterX = ((leftOpen and viewport.width < 1000 ? screensWidth() : 0) + canvasWidth - (rightOpen and viewport.width < 700 ? inspectorWidth() : 0)) / 2
  action advancePan
    let next = viewport.prefersReducedMotion ? 1 : min(1, max(0, (performanceNow() - panStarted) / 280))
    panProgress = next
    if next >= 1
      panning = false
  task panFrames when panning
    every(16, advancePan)
  action cancelPan
    let x = cameraX
    let y = cameraY
    panning = false
    px = x
    py = y
  state dragging = false
  state hand = false
  state sx = 0
  state sy = 0
  state dx = 0
  state dy = 0
  state codeOpen = false
  state preview = false
  state clicks = 0
  state freeDrag = false
  derive snapping = dragging and doc.frameSelected and not doc.resizing and not hand and not freeDrag and (dx != 0 or dy != 0)
  derive dragX = snapping ? snappedDelta(scene.snapX, scene.frameX, dx, zoom) : dx
  derive dragY = snapping ? snappedDelta(scene.snapY, scene.frameY, dy, zoom) : dy
  action toggleLeft
    cancelPan()
    leftPanel = leftOpen ? "closed" : "open"
    if viewport.width >= 1000
      px = cameraX + (leftOpen ? screensWidth() : -screensWidth())
    else
      if not leftOpen and viewport.width < 700
        rightPanel = "closed"
  action toggleRight
    cancelPan()
    rightPanel = rightOpen ? "closed" : "open"
    if not rightOpen and viewport.width < 700
      leftPanel = "closed"
  action command(op: string, key: string)
    if editing and op == "undo"
      undoDesign()
    else
      if not editing or op == "save"
        send changed = edit(op, key, "", 0, 0, time.epochAtZero + performanceNow())
  action prop(key: string, value: string)
    send changed = edit("property", key, value, 0, 0, time.epochAtZero + performanceNow())
  action down(e: PointerEvent)
    cancelPan()
    fitWhenReady = false
    tidyFit = false
    if e.button == 0
      freeDrag = e.altKey
      dragging = true
      sx = e.offsetX
      sy = e.offsetY
      dx = 0
      dy = 0
      if not hand
        send changed = edit("hit", "", `${zoom}`, (e.offsetX - cameraX) / zoom, (e.offsetY - cameraY) / zoom, time.epochAtZero + performanceNow())
  action move(e: PointerEvent)
    if dragging
      freeDrag = e.altKey
      dx = (e.offsetX - sx) / zoom
      dy = (e.offsetY - sy) / zoom
  action up(e: PointerEvent)
    if dragging
      if hand
        px = px + e.offsetX - sx
        py = py + e.offsetY - sy
      else
        send changed = edit("move", (e.altKey ? "free" : "snap"), `${zoom}`, (e.offsetX - sx) / zoom, (e.offsetY - sy) / zoom, time.epochAtZero + performanceNow())
      dragging = false
      dx = 0
      dy = 0
  action wheel(e: WheelEvent)
    cancelPan()
    fitWhenReady = false
    tidyFit = false
    preventDefault()
    if e.ctrlKey or e.metaKey
      let z = min(3, max(0.01, zoom * (1 - e.deltaY * 0.005)))
      let old = zoom
      zoom = z
      px = e.offsetX - (e.offsetX - cameraX) * z / old
      py = e.offsetY - (e.offsetY - cameraY) * z / old
    else
      px = cameraX - e.deltaX
      py = cameraY - e.deltaY
  action toggleReducedEffects
    reducedEffects = not reducedEffects
  action zoomIn
    cancelPan()
    zoom = min(3, zoom + 0.1)
  action zoomOut
    cancelPan()
    zoom = max(0.01, zoom - 0.1)
  action fitBounds(x: number, y: number, right: number, bottom: number)
    cancelPan()
    let available = viewport.width - ((leftOpen and viewport.width >= 1000 ? screensWidth() : 0) + (rightOpen and viewport.width >= 700 ? inspectorWidth() : 0)) - 96
    let z = min(1, max(0.01, min(available / max(1, right - x), (viewport.height - 220 - (timelineOpen ? (historySelected == "" ? 96 : 240) : 0)) / max(1, bottom - y))))
    zoom = z
    px = 48 - x * z
    py = 64 - y * z
  action fitSelection
    if not editing and not doc.frameSelected
      match first(doc.layers.filter(n => n.id == doc.selected))
        case some(n)
          fitBounds(scene.frameX + n.x, scene.frameY + n.y, scene.frameX + n.x + n.width, scene.frameY + n.y + n.height)
        case none
          resetView()
    else
      match first(scene.views.filter(v => v.id == doc.active))
        case some(v)
          fitBounds(v.x, v.y, v.x + v.width, v.y + v.height)
        case none
          resetView()
  action canvasMenu(e: PointerEvent)
    if not editing
      send changed = edit("hit", "", `${zoom}`, (e.offsetX - cameraX) / zoom, (e.offsetY - cameraY) / zoom, time.epochAtZero + performanceNow())
  action resetView
    fitBounds(scene.minX, scene.minY, scene.maxX, scene.maxY)
  action afterEdit
    match changed
      case some(r)
        if r.fit
          fitWhenReady = true
          fittedSignature = ""
          fitBounds(r.minX, r.minY, r.maxX, r.maxY)
      case none
        hand = hand
  action focusView(id: string, x: number, y: number, w: number, h: number)
    fitWhenReady = false
    addingViewport = false
    send changed = edit("select", id, "", 0, 0, time.epochAtZero + performanceNow())
    let fromX = cameraX
    let fromY = cameraY
    panFromX = fromX
    panFromY = fromY
    let targetX = canvasCenterX - (x + w / 2) * zoom
    let targetY = 64 - y * zoom
    px = targetX
    py = targetY
    panStarted = performanceNow()
    panProgress = 0
    panning = not viewport.prefersReducedMotion and (magnitude(targetX - fromX) > 0.5 or magnitude(targetY - fromY) > 0.5)
  action focusScreen(id: string)
    match first(scene.groups.filter(g => g.id == id))
      case some(group)
        match first(group.views.filter(v => v.id == doc.active))
          case some(v)
            focusView(v.id, v.x, v.y, v.width, v.height)
          case none
            match first(group.views)
              case some(v)
                focusView(v.id, v.x, v.y, v.width, v.height)
              case none
                hand = hand
      case none
        hand = hand
  action cancelDrag
    if dragging and hand
      px = px + dx * zoom
      py = py + dy * zoom
    dragging = false
    dx = 0
    dy = 0
    freeDrag = false
  action selectTool
    cancelDrag()
    hand = false
  action handTool
    cancelDrag()
    hand = true
  action toggleCode
    codeOpen = not codeOpen
  action copyCode
    copyText(doc.code)
  action togglePreview
    preview = not preview
    clicks = 0
  action previewClick
    clicks = clicks + 1
  view
    main hatch="preview-engines" data-canvas-editing=editing data-preview-effects=(reducedEffects ? "reduced" : "full") navigationKey=`${top(nav).id}` navigationBack="closeLibrary" navigate=follow testId="editor" width="100%" height="100%" display="flex" flex-direction="column" background-color="surface.canvas" color="ink.primary" font="type.body"
      column id="studio-menu" popover="auto" role="menu" aria-label="Canvas actions" class=Menu
        MenuItem(label="Undo", icon="undo-2", shortcut="⌘Z", disabled=(editing ? not appCanUndo : not doc.canUndo), destructive=false, menu="studio-menu", testId="menu-undo", press=command("undo", ""))
        if not editing
          MenuItem(label="Redo", icon="redo-2", shortcut="⇧⌘Z", disabled=not doc.canRedo, destructive=false, menu="studio-menu", testId="menu-redo", press=command("redo", ""))
        MenuDivider()
        if editing
          MenuItem(label="Select parent", icon="corner-up-left", shortcut="", disabled=selectingElement, destructive=false, menu="studio-menu", testId="menu-parent", press=selectParent)
          MenuItem(label="Finish editing", icon="check", shortcut="Esc", disabled=designWriting, destructive=false, menu="studio-menu", testId="menu-finish", press=finishEditing)
        else
          if doc.source != "" and doc.platform != "ios"
            MenuItem(label="Edit app design", icon="mouse-pointer-2", shortcut="", disabled=designWriting, destructive=false, menu="studio-menu", testId="menu-edit", press=startEditing)
          if doc.platform == "ios"
            MenuItem(label="Refresh preview", icon="refresh-cw", shortcut="", disabled=(native.state == "working"), destructive=false, menu="studio-menu", testId="menu-native-refresh", press=refreshNativeFrame(doc.active))
            MenuItem(label="Refresh all native previews", icon="refresh-cw", shortcut="", disabled=(native.state == "working"), destructive=false, menu="studio-menu", testId="menu-native-refresh-all", press=refreshNative)
          if doc.frameSelected
            MenuItem(label="Duplicate screen", icon="copy", shortcut="", disabled=false, destructive=false, menu="studio-menu", testId="menu-duplicate", press=command("duplicate", ""))
            for preset in ["Phone", "Tablet", "Desktop"] key=preset
              MenuItem(label=`Add ${preset.toLowerCase()} viewport`, icon=deviceIcon(preset), shortcut="", disabled=false, destructive=false, menu="studio-menu", testId=`menu-variant-${preset.toLowerCase()}`, press=addViewport(preset))
            MenuItem(label="Add every size", icon="monitor-smartphone", shortcut="", disabled=false, destructive=false, menu="studio-menu", testId="menu-variant-every-size", press=addViewportSet("Every size"))
            for v in scene.views.filter(v => v.id == doc.active) key=v.id
              MenuItem(label=(v.hidden ? "Show viewport" : "Hide viewport"), icon=(v.hidden ? "eye" : "eye-off"), shortcut="", disabled=false, destructive=false, menu="studio-menu", testId="menu-visibility", press=setVisibility(v.id, not v.hidden))
          if doc.selected != ""
            MenuItem(label="Delete", icon="trash-2", shortcut="⌫", disabled=doc.frameSelected and doc.views.length == 1, destructive=true, menu="studio-menu", testId="menu-delete", press=command("delete", ""))
        MenuDivider()
        if not editing
          MenuItem(label="Tidy up", icon="layout-grid", shortcut="", disabled=false, destructive=false, menu="studio-menu", testId="menu-tidy", press=tidyUp)
        MenuItem(label="Zoom to fit", icon="maximize", shortcut="⇧1", disabled=false, destructive=false, menu="studio-menu", testId="menu-fit", press=resetView)
        MenuItem(label=(editing or doc.frameSelected ? "Zoom to screen" : "Zoom to selection"), icon="scan", shortcut="⇧2", disabled=false, destructive=false, menu="studio-menu", testId="menu-fit-selection", press=fitSelection)
        MenuDivider()
        MenuItem(label="Add screen", icon="plus", shortcut="", disabled=editing, destructive=false, menu="studio-menu", testId="menu-add", press=addScreen)
        MenuItem(label=(leftOpen ? "Hide layers panel" : "Show layers panel"), icon="panel-left", shortcut="", disabled=false, destructive=false, menu="studio-menu", testId="menu-layers", press=toggleLeft)
        MenuItem(label=(rightOpen ? "Hide inspector" : "Show inspector"), icon="panel-right", shortcut="", disabled=false, destructive=false, menu="studio-menu", testId="menu-inspector", press=toggleRight)
      for entry in stack(nav) key=entry.id
        if entry.name == "editor"
          column navigationKey=`${entry.id}` position="absolute" inset=0
            row flex=1 min-height=0 position="relative"
              if leftOpen
                column testId="screens-panel" position=(viewport.width >= 1000 ? "relative" : "absolute") left=0 top=0 bottom=0 z-index=3 background-color="surface.panel" width=screensWidth() flex-shrink=0 box-sizing="border-box" border-right="1px solid line.subtle"
                  FileHeader(name=(doc.projectName == "" ? doc.name : doc.projectName), subtitle=(doc.projectUrl == "" ? "No project connected" : doc.projectUrl), compact=false, open=true, disabled=false, connect=projectSettings, toggle=toggleLeft)
                  if editing
                    row height=40 flex-shrink=0 box-sizing="border-box" align-items="center" gap=8 padding="0 12px 0 16px"
                      SectionHeading(label="Layers")
                      text `${elementTree.length}` font="type.caption" color="ink.muted" font-variant-numeric="tabular-nums" data-tip="Rendered elements in this viewport"
                    scroll flex=1 min-height=0 testId="element-tree"
                      column padding="0 8px 12px" gap=1
                        for element, i in elementTree key=element.id
                          if element.ancestors.filter(id => collapsedElements.includes(id)).length == 0
                            row class=TreeRow contextmenu=selectElement(element.id) contextPopover="studio-menu" id=`layer-row-${element.id}` hover=hoverElement(element.id) height=28 flex-shrink=0 align-items="center" padding-left=(4 + min(element.depth, 8) * 12) background-color=(element.selected ? "surface.selected" : "transparent")
                              if element.hasChildren
                                button press=toggleElement(element.id) class=SmallTool width=16 height=28 padding=0 color="ink.muted" aria-label=`Toggle ${element.label}` aria-expanded=(not collapsedElements.includes(element.id)) data-tip=(collapsedElements.includes(element.id) ? "Expand" : "Collapse") testId=`fold-element-${i}`
                                  Icon(name="chevron-right", size=12, angle=(collapsedElements.includes(element.id) ? 0 : 90))
                              else
                                column width=16 flex-shrink=0
                              button press=selectElement(element.id) testId=`element-${i}` aria-label=(element.label == layerKind(element.kind) ? element.label : `${layerKind(element.kind)}: ${element.label}`) data-tip=element.label aria-pressed=element.selected display="flex" flex=1 min-width=0 align-items="center" gap=6 height=28 padding="0 8px 0 4px" border-width=0 background-color="transparent" color=(element.selected ? "ink.selected" : "ink.primary")
                                column color=(element.selected ? "ink.selected" : "ink.muted") flex-shrink=0
                                  ElementIcon(kind=element.kind)
                                text element.label font="type.body" font-weight=(element.selected ? 500 : 400) text-align="left" min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
                  else
                    row height=40 flex-shrink=0 box-sizing="border-box" align-items="center" gap=4 padding="0 12px 0 16px"
                      SectionHeading(label="Screens")
                      SmallButton(icon="layout-grid", label="Tidy up", hint="Tidy up · Arrange the canvas in one row per screen", selected=false, disabled=false, testId="tidy-up", press=tidyUp)
                      SmallButton(icon="plus", label="Add screen", hint="Add screen · Choose a route from your project or start a blank screen", selected=false, disabled=false, testId="add-screen", press=addScreen)
                    scroll flex=1 min-height=0
                      column padding="0 8px 12px" gap=1
                        if scene.groups.length == 0
                          text "No screens yet. Add one to start." padding="8px" font="type.caption" color="ink.muted"
                        for group in scene.groups key=group.id
                          row class=TreeRow hover=hoverRow(group.id) height=28 flex-shrink=0 align-items="center" padding="0 2px 0 4px"
                            button press=toggleGroup(group.id) testId=`fold-group-${group.id}` class=SmallTool width=16 height=28 padding=0 color="ink.muted" aria-label=`Toggle ${group.name}` aria-expanded=(not collapsed.includes(group.id)) data-tip=(collapsed.includes(group.id) ? "Show viewports" : "Hide viewports")
                              Icon(name="chevron-right", size=12, angle=(collapsed.includes(group.id) ? 0 : 90))
                            button press=focusScreen(group.id) testId=`group-${group.id}` aria-label=group.name data-tip=(group.hidden ? "Hidden screen · Show it to see it on the canvas" : "Go to screen · Pan the canvas to this screen") display="flex" flex=1 min-width=0 align-items="center" gap=6 height=28 padding="0 4px" border-width=0 background-color="transparent" color=(group.hidden ? "ink.muted" : "ink.primary")
                              column color="ink.muted" flex-shrink=0
                                Icon(name=(group.source == "" ? "frame" : "globe"), size=14, angle=0)
                              text group.name font="type.body" font-weight=500 flex=1 min-width=0 text-align="left" overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
                            VisibilityButton(name="screen", hidden=group.hidden, revealed=(hoveredRow == group.id), testId=`visibility-${group.id}`, press=setVisibility(group.id, not group.hidden))
                          if not collapsed.includes(group.id)
                            for v in group.views key=v.id
                              row class=TreeRow hover=hoverRow(v.id) contextmenu=command("select", v.id) contextPopover="studio-menu" height=28 flex-shrink=0 align-items="center" padding-right=2 background-color=(doc.active == v.id and doc.frameSelected ? "surface.selected" : "transparent")
                                button press=openView(v.id, v.hidden, v.x, v.y, v.width, v.height) testId=`view-${v.id}` aria-label=`${group.name}, ${v.name}` display="flex" flex=1 min-width=0 align-items="center" gap=6 height=28 padding="0 4px 0 30px" border-width=0 background-color="transparent" color=(doc.active == v.id and doc.frameSelected ? "ink.selected" : (v.hidden ? "ink.muted" : "ink.primary"))
                                  column color=(doc.active == v.id and doc.frameSelected ? "ink.selected" : "ink.muted") flex-shrink=0
                                    Icon(name=deviceIcon(v.name), size=14, angle=0)
                                  text v.name font="type.body" flex=1 min-width=0 text-align="left" overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
                                  text `${v.width} × ${v.height}` font="type.caption" color=(doc.active == v.id and doc.frameSelected ? "ink.selected" : "ink.muted") font-variant-numeric="tabular-nums"
                                VisibilityButton(name="viewport", hidden=v.hidden, revealed=(hoveredRow == v.id), testId=`visibility-${v.id}`, press=setVisibility(v.id, not v.hidden))
                            for n in group.layers key=n.id
                              button contextmenu=command("select", n.id) contextPopover="studio-menu" class=TreeRow press=command("select", n.id) testId=`layer-${n.id}` aria-label=n.name display="flex" flex-shrink=0 align-items="center" gap=6 height=28 padding="0 8px 0 44px" border-width=0 background-color=(doc.selected == n.id ? "surface.selected" : "transparent") color=(doc.selected == n.id ? "ink.selected" : "ink.primary")
                                column color=(doc.selected == n.id ? "ink.selected" : "ink.muted") flex-shrink=0
                                  ElementIcon(kind=n.kind)
                                text n.name font="type.body" flex=1 min-width=0 text-align="left" overflow="hidden" white-space="nowrap" text-overflow="ellipsis"

              column id="canvas-stage" outline="none" tabindex=-1 contextmenu=canvasMenu contextPopover="studio-menu" testId="canvas-stage" wheel=wheel flex=1 min-width=0 min-height=0 position="relative" overflow="clip" background-color="surface.canvas"
                for v in scene.views.filter(v => not v.hidden) key=v.id
                  column position="absolute" left=0 top=0 translate=`${(hand ? cameraX + dx * zoom : cameraX) + (v.x + (not hand and doc.frameSelected and doc.active == v.id and not doc.resizing ? dragX : 0)) * zoom}px ${(hand ? cameraY + dy * zoom : cameraY) + (v.y + (not hand and doc.frameSelected and doc.active == v.id and not doc.resizing ? dragY : 0)) * zoom}px` width=max(100, v.width + (not hand and doc.frameSelected and doc.active == v.id and doc.resizing ? dragX : 0)) height=max(100, v.height + (not hand and doc.frameSelected and doc.active == v.id and doc.resizing ? dragY : 0)) scale=zoom transform-origin="top left" pointer-events=(editing and not hand and v.source.startsWith(designOrigin + "/") ? "auto" : "none") inert=(not editing or hand or not v.source.startsWith(designOrigin + "/")) background-color="paper" border="none" box-shadow="none" testId=`frame-${v.id}`
                    if v.platform == "ios"
                      NativeFrame(id=v.id, name=v.name, status=native)
                    else
                      ScreenView(source=v.previewSource, layers=v.layers, prefix=v.id, selected=(doc.screenId == v.screenId and not doc.frameSelected ? doc.selected : ""), dx=(hand ? 0 : dragX), dy=(hand ? 0 : dragY), resizing=doc.resizing, activate=previewClick)
                canvas pointer-events=(editing and not hand ? "none" : "auto") surface=design(scene.drawing, doc.selected, zoom, (hand ? cameraX + dx * zoom : cameraX), (hand ? cameraY + dy * zoom : cameraY), (hand ? 0 : dragX), (hand ? 0 : dragY), doc.resizing, snapping) position="relative" flex=1 width="100%" min-height=0 pointerdown=down pointermove=move pointerup=up cursor=(hand ? (dragging ? "grabbing" : "grab") : (dragging ? (doc.resizing ? "nwse-resize" : "move") : "default")) touch-action="none" testId="canvas" aria-label="Design canvas"
                if booting
                  column position="absolute" inset=0 z-index=1 display="flex" flex-direction="column" align-items="center" justify-content="center" background-color="surface.canvas" role="status" aria-label="Loading screens" pointerdown=finishBoot testId="canvas-loading" -exact-exit-animation=(still or previews.total == 0 ? "none" : "veilOut 280ms ease-in both")
                    if previews.total > 0
                      column align-items="center" gap=14 testId="canvas-loading-indicator" animation=(still ? "none" : "veilIn 240ms ease-out 300ms both")
                        row align-items="flex-end" gap=5 height=30 aria-hidden=true
                          for w, i in [12, 20, 32] key=w
                            column width=w height=(i == 1 ? 26 : 22) box-sizing="border-box" border="1.5px solid accent" border-radius=(i == 2 ? 3 : 4) opacity=(still ? 0.6 : 0.25) animation=(still ? "none" : `framePulse 1.2s ease-in-out ${i * 160}ms infinite`)
                        column align-items="center" gap=3
                          text "Loading screens" font="type.heading" font-weight=600 color="ink.primary"
                          text `${previews.loaded} of ${previews.total} previews ready` font="type.caption" color="ink.secondary" font-variant-numeric="tabular-nums" testId="canvas-loading-progress"
                        column width=140 height=3 border-radius=2 background-color="line.subtle" overflow="hidden" aria-hidden=true
                          column height=3 width=140 flex-shrink=0 border-radius=2 background-color="accent" translate=`${(max(0.04, previews.loaded / previews.total) - 1) * 140}px 0px` transition=(still ? "none" : "translate 320ms ease-out")
                if editing and not hand and not designWriting and not panelOverlay
                  match designChanged
                    case some(result)
                      match spacingMeasured
                        case some(measured)
                          if measured.id != "" and measured.id == result.spacingId and measured.plan == result.spacingPlan and measured.frame == result.spacingFrame
                            for v in scene.views.filter(v => v.id == measured.frame) key=v.id
                              column position="absolute" inset=0 pointer-events="none" testId="spacing-overlay"
                                for box in measured.boxes key=box.key
                                  column position="absolute" left=(cameraX + (v.x + box.x) * zoom) top=(cameraY + (v.y + box.y) * zoom) width=(box.width * zoom) height=(box.height * zoom) background-color="spacing.wash" border="1px solid spacing.edge" box-sizing="border-box" aria-hidden=true
                                  if box.label and max(box.width, box.height) * zoom >= 32
                                    for targets in [result.spacingInputs.filter(p => p.property == box.property)] key=box.property
                                      if targets.length == 0
                                        text box.value position="absolute" left=(cameraX + (v.x + box.labelX) * zoom) top=(cameraY + (v.y + box.labelY) * zoom) translate="-50% -50%" font-size="0.625rem" font-weight=500 color="spacing.ink" background-color="surface.panel" padding=3 border-radius=4 pointer-events="auto" data-tip=`${spacingName(box.property)} · Computed` testId=`spacing-readonly-${box.property}`
                                      else
                                        for target in targets key=target.property
                                          if spacingProperty == target.property
                                            input id="spacing-value" value=spacingValue input=editSpacing key=spacingKey blur=cancelSpacing position="absolute" left=(cameraX + (v.x + box.labelX) * zoom) top=(cameraY + (v.y + box.labelY) * zoom) translate="-50% -50%" width=72 height=26 padding=4 box-sizing="border-box" border="1px solid spacing.ink" border-radius=5 background-color="surface.panel" color="ink.primary" font="type.caption" text-align="center" pointer-events="auto" aria-label=spacingName(box.property) data-tip="Enter to apply · Escape to cancel" testId="spacing-value"
                                          else
                                            button press=openSpacing(target.property, target.value) position="absolute" left=(cameraX + (v.x + box.labelX) * zoom) top=(cameraY + (v.y + box.labelY) * zoom) translate="-50% -50%" display="flex" align-items="center" justify-content="center" box-sizing="border-box" min-width="1.5rem" min-height="1.25rem" padding="0.1875rem" border="1px solid spacing.edge" border-radius=4 background-color="surface.panel" color="spacing.ink" font-size="0.625rem" font-weight=600 pointer-events="auto" aria-label=`Edit ${spacingName(box.property)}` data-tip=(target.shared ? `${spacingName(box.property)} · Shared style` : spacingName(box.property)) testId=`spacing-${box.property}`
                                              text box.value
                        case none
                          column display="none"
                    case none
                      column display="none"
                row position="absolute" top=12 left=(leftOpen and viewport.width < 1000 ? screensWidth() + 12 : 12) right=(rightOpen and viewport.width < 700 ? inspectorWidth() + 12 : 12) z-index=2 flex-wrap="wrap" gap=8 align-items="flex-start" pointer-events="none"
                  if not leftOpen
                    column class=FloatingBar align-items="stretch" width=(viewport.width >= 700 ? "232px" : "auto") max-width="100%" min-width=0 flex-shrink=1 padding=0 pointer-events="auto"
                      FileHeader(name=(doc.projectName == "" ? doc.name : doc.projectName), subtitle="", compact=true, open=false, disabled=false, connect=projectSettings, toggle=toggleLeft)
                  if not rightOpen
                    column class=FloatingBar align-items="stretch" margin-left="auto" max-width="100%" flex-shrink=0 padding=0 pointer-events="auto"
                      ActionBar(compact=true, narrow=(viewport.width < 700), minimal=(leftOpen and viewport.width < 700), canUndo=(editing ? appCanUndo : doc.canUndo), canRedo=(not editing and doc.canRedo), canExport=(doc.source == ""), canPreview=not editing, open=false, undo=command("undo", ""), redo=command("redo", ""), save=command("save", ""), preview=togglePreview, exportCode=toggleCode, toggle=toggleRight)
                if native.state == "working" or native.error != "" or nativeDone
                  row class=FloatingBar position="absolute" bottom=148 left="50%" translate="-50% 0" padding="8px 12px" gap=8 max-width="calc(100% - 32px)" z-index=2 role="status"
                    Icon(name=(native.error != "" ? "circle-alert" : native.state == "working" ? "refresh-cw" : "check"), size=14, angle=0)
                    text (native.error != "" ? native.error : native.message) font="type.body" testId="native-progress"
                if doc.status != "" and doc.status != statusSeen
                  row class=FloatingBar position="absolute" bottom=68 left="50%" translate="-50% 0" height=32 padding="0 12px" gap=8 max-width="calc(100% - 32px)" min-width=0 z-index=2 role="status" color=(doc.status == "Saved" ? "ink.secondary" : "ink.danger")
                    Icon(name=(doc.status == "Saved" ? "check" : "circle-alert"), size=14, angle=0)
                    text doc.status testId="save-status" font="type.body" color="ink.primary" overflow="hidden" white-space="nowrap" text-overflow="ellipsis" min-width=0
                if setupRunning
                  row class=FloatingBar position="absolute" bottom=108 left="50%" translate="-50% 0" height=36 padding="0 12px" gap=8 z-index=2 role="status" color="ink.secondary" testId="setup-status"
                    Icon(name="refresh-cw", size=14, angle=0)
                    text `Setting up ${setupName}…` font="type.body" color="ink.primary" white-space="nowrap"
                if setupError != ""
                  row class=FloatingBar position="absolute" bottom=108 left="50%" translate="-50% 0" max-width="calc(100% - 32px)" min-height=36 padding="4px 4px 4px 12px" gap=8 z-index=2 role="alert" testId="setup-error"
                    column color="ink.danger" flex-shrink=0
                      Icon(name="circle-alert", size=14, angle=0)
                    text `Couldn't set up ${setupName}: ${setupError}` font="type.body" color="ink.primary" flex=1 min-width=0
                    button press=runSetup class=SecondaryButton height=26 padding="0 10px" testId="setup-retry"
                      text "Retry"
                    SmallButton(icon="x", label="Dismiss", hint="", selected=false, disabled=false, testId="setup-dismiss", press=dismissSetupError)
                row class=FloatingBar display=(panelOverlay ? "none" : "flex") position="absolute" bottom=16 left="50%" translate="-50% 0" z-index=2
                  ToolbarButton(icon="mouse-pointer-2", label="Select", hint="Select (V) · Select and move screens and layers", shortcut="v", selected=not hand, disabled=false, testId="select-tool", press=selectTool)
                  ToolbarButton(icon="hand", label="Pan", hint="Pan (H) · Drag to move around the canvas · Hold Space to pan from any tool", shortcut="h", selected=hand, disabled=false, testId="hand-tool", press=handTool)
                  if not editing
                    Divider()
                    ToolbarButton(icon="frame", label="New screen", hint="New screen · Add a screen from your project or a blank one", shortcut="", selected=false, disabled=false, testId="new-screen", press=addScreen)
                    ToolbarButton(icon="square", label="Rectangle", hint="Rectangle · Add a rectangle to this screen", shortcut="", selected=false, disabled=(doc.source != ""), testId="add-rectangle", press=command("add", "rectangle"))
                    ToolbarButton(icon="type", label="Text", hint="Text · Add a text layer to this screen", shortcut="", selected=false, disabled=(doc.source != ""), testId="add-text", press=command("add", "text"))
                    ToolbarButton(icon="rectangle-horizontal", label="Button", hint="Button · Add a button to this screen", shortcut="", selected=false, disabled=(doc.source != ""), testId="add-button", press=command("add", "button"))
                  Divider()
                  ToolbarButton(icon="history", label="Timeline", hint="Design timeline · Browse the history of design edits", shortcut="", selected=timelineOpen, disabled=false, testId="toggle-timeline", press=toggleTimeline)
                row class=FloatingBar display=(panelOverlay ? "none" : "flex") position="absolute" right=16 bottom=(viewport.width >= 1000 ? 16 : 72) z-index=2
                  SmallButton(icon="zap", label="Reduce preview effects", hint=(reducedEffects ? "Restore preview effects · Show blur and animations in canvas previews again" : "Reduce preview effects · Hide blur and animations in canvas previews to save GPU and battery · Full-screen Preview is unchanged"), selected=reducedEffects, disabled=false, testId="reduce-effects", press=toggleReducedEffects)
                  Divider()
                  SmallButton(icon="minus", label="Zoom out", hint="", selected=false, disabled=false, testId="zoom-out", press=zoomOut)
                  button press=resetView class=SmallTool width=48 aria-label="Fit all screens" data-tip="Fit all screens (⇧1) · Zoom to show every screen" testId="zoom" color="ink.primary"
                    text `${round(zoom * 100)}%` font="type.caption" font-variant-numeric="tabular-nums"
                  SmallButton(icon="plus", label="Zoom in", hint="", selected=false, disabled=false, testId="zoom-in", press=zoomIn)
              if rightOpen
                scroll testId="inspector-panel" position=(viewport.width >= 700 ? "relative" : "absolute") right=0 top=0 bottom=0 z-index=3 background-color="surface.panel" width=inspectorWidth() flex-shrink=0 box-sizing="border-box" border-left="1px solid line.subtle"
                  column gap=0
                    ActionBar(compact=false, narrow=(viewport.width < 700), minimal=false, canUndo=(editing ? appCanUndo : doc.canUndo), canRedo=(not editing and doc.canRedo), canExport=(doc.source == ""), canPreview=not editing, open=true, undo=command("undo", ""), redo=command("redo", ""), save=command("save", ""), preview=togglePreview, exportCode=toggleCode, toggle=toggleRight)
                    row height=40 flex-shrink=0 box-sizing="border-box" align-items="center" gap=8 padding="0 12px 0 16px" border-bottom="1px solid line.subtle"
                      text "Design" font="type.body" font-weight=600 flex=1
                      if (doc.source != "" and doc.platform != "ios") or editing
                        if editing
                          button press=toggleEditing disabled=designWriting class=PrimaryButton height=24 padding="0 8px" aria-label="Finish editing app" data-tip="Finish editing (Esc)" testId="edit-app"
                            Icon(name="check", size=14, angle=0)
                            text "Done" font="type.caption" font-weight=500
                        else
                          button press=toggleEditing disabled=designWriting class=SecondaryButton height=24 padding="0 8px" aria-label="Edit app design" data-tip="Edit app design · Select and edit elements in this app" testId="edit-app"
                            Icon(name="mouse-pointer-2", size=14, angle=0)
                            text "Edit app" font="type.caption" font-weight=500
                    if designError != ""
                      row margin="12px 12px 0 16px" padding="8px 10px" gap=8 align-items="flex-start" border-radius="radius.control" background-color="surface.field" color="ink.danger"
                        Icon(name="circle-alert", size=14, angle=0)
                        text designError role="alert" flex=1 min-width=0 font="type.caption" color="ink.primary" testId="design-error"
                    if editing
                      column gap=0
                        match designChanged
                          case some(result)
                            if result.draftCount > 0
                              column class=PanelSection background-color="surface.notice" gap=10
                                row align-items="center" gap=8
                                  row min-width="1.25rem" min-height="1.25rem" padding="0 0.25rem" box-sizing="border-box" flex-shrink=0 border-radius="0.625rem" align-items="center" justify-content="center" background-color="surface.action" color="ink.on-action" aria-hidden=true
                                    text `${result.draftCount}` font-size="0.625rem" font-weight=700 font-variant-numeric="tabular-nums"
                                  column flex=1 min-width=0 gap=0
                                    text `${result.draftCount} unsaved ${result.draftCount == 1 ? "change" : "changes"}` font="type.body" font-weight=600 testId="draft-count"
                                    text "Not written to code yet" font="type.caption" color="ink.secondary"
                                  if result.canUndo
                                    SmallButton(icon="undo-2", label="Undo draft change", hint="Undo draft change · Step back one unapplied edit", selected=false, disabled=designWriting, testId="undo-app-design", press=undoDesign)
                                  SmallButton(icon="trash-2", label="Discard all changes", hint="Discard all changes · Drop every unapplied edit without writing code", selected=false, disabled=designWriting, testId="discard-design", press=discardDesign)
                                row gap=8
                                  button press=toggleReview class=SecondaryButton flex=1 background-color="surface.panel" aria-label="Review changes" data-tip="Review every change before writing code" testId="review-design"
                                    Icon(name="git-compare", size=14, angle=0)
                                    text "Review"
                                  button press=applyDesign class=PrimaryButton flex=1 disabled=(not result.canApply or designWriting) aria-label="Apply to code" data-tip="Validate and write these changes to source" testId="apply-design"
                                    Icon(name="code-2", size=14, angle=0)
                                    text "Apply"
                                if result.draftError != ""
                                  row gap=6 align-items="flex-start" color="ink.danger"
                                    Icon(name="circle-alert", size=14, angle=0)
                                    text result.draftError role="alert" flex=1 min-width=0 font="type.caption" color="ink.primary" testId="draft-error"
                            for selected in result.crumbs.filter(c => c.selected) key=selected.id
                              column class=PanelSection gap=8
                                for parent in result.crumbs.filter(c => c.depth == selected.depth - 1) key=parent.id
                                  button press=selectElement(parent.id) class=RowButton height=24 padding="0 4px" margin-left=-4 width="calc(100% + 4px)" gap=6 color="ink.secondary" aria-label=`Select parent: ${parent.label}` data-tip=`Select parent: ${parent.label}` testId="element-parent"
                                    Icon(name="corner-up-left", size=12, angle=0)
                                    text parent.label font="type.caption" min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
                                row align-items="center" gap=10
                                  row width=32 height=32 flex-shrink=0 border-radius=6 align-items="center" justify-content="center" background-color="surface.field" color="ink.secondary"
                                    ElementIcon(kind=selected.kind)
                                  column flex=1 min-width=0 gap=0
                                    text selected.label font="type.heading" font-weight=600 min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis" data-tip=selected.label testId="selected-element-name"
                                    text layerKind(selected.kind) font="type.caption" color="ink.secondary" testId=(selected.label != layerKind(selected.kind) ? "selected-element-kind" : "selected-element-type")
                                if result.source != ""
                                  row gap=6 align-items="center" color="ink.muted" min-width=0 data-tip=result.source
                                    Icon(name="file-code", size=12, angle=0)
                                    text result.source font="type.mono" color="ink.muted" overflow="hidden" white-space="nowrap" text-overflow="ellipsis" min-width=0 testId="design-source"
                                if result.instances > 1
                                  row gap=6 align-items="center" align-self="flex-start" padding="2px 8px" border-radius=10 background-color="surface.notice" color="ink.selected" data-tip="These elements share one source template. Editing it updates every instance."
                                    Icon(name="component", size=12, angle=0)
                                    text `Shared template · ${result.instances} instances` font="type.caption"
                            if result.source != ""
                              if result.crumbs.length == 0
                                column class=PanelSection
                                  button press=selectParent class=RowButton testId="design-parent"
                                    Icon(name="square-mouse-pointer", size=14, angle=0)
                                    text "Select component"
                            if result.rows.length == 0
                              column padding="24px 16px" gap=10 align-items="center"
                                row width=40 height=40 border-radius=10 align-items="center" justify-content="center" background-color="surface.field" color="ink.muted"
                                  Icon(name=(result.applied ? "check" : "mouse-pointer-click"), size=18, angle=0)
                                text (result.restoring ? result.message : result.applied ? "Applied to source." : result.message) font="type.body" color="ink.secondary" text-align="center" testId="design-message"
                            if result.canUndo and result.draftCount == 0
                              column class=PanelSection
                                button press=undoDesign disabled=designWriting class=RowButton testId="undo-app-design"
                                  Icon(name="undo-2", size=14, angle=0)
                                  text "Undo draft change"
                          case none
                            column padding="24px 16px" gap=10 align-items="center"
                              row width=40 height=40 border-radius=10 align-items="center" justify-content="center" background-color="surface.field" color="ink.muted"
                                Icon(name="mouse-pointer-click", size=18, angle=0)
                              text "Select an element in a screen." font="type.body" color="ink.secondary"
                        for group in ["Position", "Layout", "Spacing", "Text", "Typography", "Appearance", "Fill", "Stroke", "Effects"] key=group
                          if designRows.filter(p => p.group == group).length > 0
                            column class=PanelSection gap=(collapsedDesignSections.includes(group) ? 0 : 10) padding-bottom=(collapsedDesignSections.includes(group) ? 12 : 16)
                              button press=toggleDesignSection(group) class=RowButton height=24 padding=0 margin-left=0 gap=4 background-color="transparent" aria-label=`${collapsedDesignSections.includes(group) ? "Expand" : "Collapse"} ${group}` aria-expanded=not collapsedDesignSections.includes(group)
                                SectionHeading(label=group)
                                column color="ink.muted" width=24 height=24 align-items="center" justify-content="center"
                                  Icon(name="chevron-down", size=14, angle=(collapsedDesignSections.includes(group) ? -90 : 0))
                              if not collapsedDesignSections.includes(group)
                                row flex-wrap="wrap" row-gap=10 column-gap=8 align-items="flex-start"
                                  for property in designRows.filter(p => p.group == group) key=`${property.binding}-${property.id}`
                                    column gap=4 min-width=0 width=((group == "Typography" and property.property != "font-family" and property.property != "color") or (group == "Layout" and (property.property.includes("width") or property.property.includes("height"))) or (group == "Position" and property.property != "position") or (group == "Appearance" and property.fields.length == 0) or (group == "Stroke" and property.property != "border-color") ? "calc(50% - 4px)" : "100%")
                                      if not (propertyPrefix(property.property) != "" and not property.readonly and property.fields.length == 0 and property.options.length == 0)
                                        row align-items="center" gap=2 height=20
                                          text property.name font="type.caption" color="ink.secondary" flex=1 min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis" data-tip=`${property.property} · ${property.added ? "Editing adds a local property" : property.binding}`
                                          if property.shared
                                            column color="ink.selected" width=20 height=20 align-items="center" justify-content="center" data-tip=`Shared style · ${property.binding} · updates every use` aria-label="Shared source style"
                                              Icon(name="component", size=12, angle=0)
                                          if property.fields.length > 0 and not property.readonly
                                            button press=toggleFieldLink(property.id, property.binding, firstField(property.fields), not property.linked or independentFields.includes(property.binding)) class=SmallTool width=20 height=20 padding=3 aria-label=`${property.linked and not independentFields.includes(property.binding) ? "Unlink" : "Link"} ${property.name}` aria-pressed=(property.linked and not independentFields.includes(property.binding)) data-tip=(property.linked and not independentFields.includes(property.binding) ? "Linked · one value changes all" : "Independent values · link using the first value") color=(property.linked and not independentFields.includes(property.binding) ? "ink.selected" : "ink.muted") disabled=designWriting
                                              Icon(name=(property.linked and not independentFields.includes(property.binding) ? "link-2" : "link-2-off"), size=14, angle=0)
                                      if property.readonly
                                        column gap=4
                                          row class=FieldShell
                                            row width=26 align-self="stretch" flex-shrink=0 align-items="center" justify-content="center" color="ink.muted" pointer-events="none" aria-hidden=true
                                              Icon(name="lock", size=12, angle=0)
                                            input value=property.value readonly=true class=Field flex=1 background-color="transparent" padding-left=0 aria-label=property.name data-tip=property.reason color="ink.muted"
                                          row align-items="center" gap=4 min-height=20
                                            text property.reason font="type.caption" color="ink.muted" flex=1 min-width=0
                                            if property.canOverride
                                              button press=overrideProperty(property.id) class=SmallTool width="auto" height=20 padding="0 6px" gap=4 aria-label=`Override ${property.name}` data-tip="Replace the source expression with a static value when you edit this field" color="ink.selected"
                                                Icon(name="pencil", size=12, angle=0)
                                                text "Override" font="type.caption"
                                      else if property.fields.length > 0
                                        if property.linked and not independentFields.includes(property.binding)
                                          InlineField(prefix="", icon=compoundIcon(property.property), value=firstField(property.fields), accessibleLabel=`${property.name} all`, hint=(property.property == "gap" ? "Both axes" : "All sides"), testId=`design-field-${property.id}-all`, disabled=designWriting, change=editDesignField(property.id, "all"))
                                        else
                                          row flex-wrap="wrap" gap=8
                                            for field in property.fields key=field.id
                                              column width="calc(50% - 4px)"
                                                InlineField(prefix=fieldPrefix(field.label), icon="", value=field.value, accessibleLabel=`${property.name} ${field.label}`, hint=field.label, testId=`design-field-${property.id}-${field.id}`, disabled=designWriting, change=editDesignField(property.id, field.id))
                                      else if property.property == "text-content"
                                        textarea value=property.value change=editDesign(property.id) class=Field height=72 padding=8 resize="vertical" aria-label="Text content" disabled=designWriting
                                      else if property.property == "flex-direction" or property.property == "align-items" or property.property == "justify-content"
                                        row class=Segmented
                                          for choice in property.options key=choice.value
                                            button press=editDesign(property.id, choice.value) class=Segment aria-label=`${property.name}: ${choice.label}` data-tip=choice.label aria-pressed=(property.value == choice.value) disabled=designWriting
                                              Icon(name=propertyIcon(property.property, choice.value), size=14, angle=(choice.value.includes("reverse") ? 180 : 0))
                                      else if property.options.length > 0
                                        select value=property.value change=editDesign(property.id) class=Field aria-label=property.name testId=`design-property-${property.id}` disabled=designWriting
                                          for choice in property.options key=choice.value
                                            option choice.label value=choice.value
                                      else
                                        row class=FieldShell
                                          if swatchable(property.property, property.value)
                                            column width=14 height=14 flex-shrink=0 margin="0 6px 0 7px" box-sizing="border-box" border-radius=3 border="1px solid line.strong" background-color=property.value pointer-events="none" aria-hidden=true
                                          else if propertyPrefix(property.property) != "" or propertyGlyph(property.property) != ""
                                            row width=26 align-self="stretch" flex-shrink=0 align-items="center" justify-content="center" color="ink.muted" pointer-events="none" aria-hidden=true
                                              if propertyGlyph(property.property) != ""
                                                Icon(name=propertyGlyph(property.property), size=14, angle=0)
                                              else
                                                text propertyPrefix(property.property) font="type.caption"
                                          input value=property.value change=editDesign(property.id) class=Field flex=1 background-color="transparent" padding-left=(swatchable(property.property, property.value) or propertyPrefix(property.property) != "" or propertyGlyph(property.property) != "" ? 0 : 8)  aria-label=property.name testId=`design-property-${property.id}` disabled=designWriting data-tip=property.binding
                        match designChanged
                          case some(result)
                            if result.source != "" and result.availableProperties.length > 0
                              column class=PanelSection border-bottom="none"
                                row class=FieldShell
                                  row width=26 align-self="stretch" flex-shrink=0 align-items="center" justify-content="center" color="ink.secondary" pointer-events="none" aria-hidden=true
                                    Icon(name="plus", size=14, angle=0)
                                  select value="" change=addDesignProperty class=Field flex=1 background-color="transparent" padding-left=0 aria-label="Add property" disabled=designWriting
                                    option "Add property…" value=""
                                    for property in result.availableProperties key=property.value
                                      option property.label value=property.value
                          case none
                            column display="none"
                    if not editing
                      if doc.selected == ""
                        column padding="32px 20px" gap=10 align-items="center" testId="inspector-empty"
                          row width=40 height=40 border-radius=10 align-items="center" justify-content="center" background-color="surface.field" color="ink.muted"
                            Icon(name="mouse-pointer-click", size=18, angle=0)
                          text "Nothing selected" font="type.body" font-weight=600
                          text "Select a screen or layer on the canvas to see its properties." font="type.caption" color="ink.secondary" text-align="center" max-width=180
                          row gap=12 padding-top=6 align-items="center" font="type.caption" color="ink.muted"
                            row gap=4 align-items="center"
                              Kbd(label="V")
                              text "Select"
                            row gap=4 align-items="center"
                              Kbd(label="H")
                              text "Pan"
                            row gap=4 align-items="center"
                              Kbd(label="⇧1")
                              text "Fit"
                      if doc.frameSelected
                        for v in scene.views.filter(v => v.id == doc.active) key=v.id
                          column class=PanelSection
                            row class=SectionHead
                              SectionHeading(label="Screen")
                              SmallButton(icon="copy", label="Duplicate screen", hint="Duplicate screen · Make an independent copy of this screen", selected=false, disabled=false, testId="duplicate-screen", press=command("duplicate", ""))
                            column gap=4
                              FieldLabel(label="Name")
                              input value=v.screenName change=prop("name") class=Field aria-label="Screen name" testId="screen-name"
                            column gap=4
                              FieldLabel(label=(doc.route != "" ? "Route" : "Preview URL"))
                              if doc.route != ""
                                InlineField(prefix="", icon="route", value=doc.route, accessibleLabel="Screen route", hint="Route in the connected project", testId="screen-route", disabled=false, change=prop("route"))
                              else
                                row class=FieldShell
                                  row width=26 align-self="stretch" flex-shrink=0 align-items="center" justify-content="center" color="ink.muted" pointer-events="none" aria-hidden=true
                                    Icon(name="globe", size=14, angle=0)
                                  input value=v.source change=prop("source") class=Field flex=1 background-color="transparent" padding-left=0 placeholder="https://…" aria-label="Preview URL" testId="preview-url"
                          column class=PanelSection
                            row class=SectionHead
                              SectionHeading(label="Viewport")
                              SmallButton(icon="plus", label="Add viewport", hint="Add viewport · Show this screen at another device size", selected=addingViewport, disabled=false, testId="add-viewport", press=toggleViewportMenu)
                              SmallButton(icon="trash-2", label="Delete viewport", hint="Delete viewport · Remove this size from the canvas", selected=false, disabled=(doc.views.length == 1), testId="delete", press=command("delete", ""))
                            if addingViewport
                              column gap=1 padding=4 border-radius="radius.control" background-color="surface.field"
                                for set in doc.deviceSets key=set.slug
                                  button press=addViewportSet(set.name) class=RowButton height=26 aria-label=`Add ${set.name} set` data-tip=`Add each size in ${set.name} that this screen does not show yet` testId=`variant-set-${set.slug}`
                                    column color="ink.selected"
                                      Icon(name="monitor-smartphone", size=14, angle=0)
                                    text set.label flex=1 min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
                                column height=1 margin="3px 4px" background-color="line.subtle" aria-hidden=true
                                scroll max-height=232
                                  column gap=1
                                    for device in doc.devices key=device.slug
                                      button press=addViewport(device.name) class=RowButton height=26 aria-label=`Add ${device.name} viewport` testId=`variant-${device.slug}`
                                        column color="ink.muted"
                                          Icon(name=deviceIcon(device.name), size=14, angle=0)
                                        text device.name flex=1 min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
                                        text `${device.width} × ${device.height}` font="type.caption" color="ink.muted" font-variant-numeric="tabular-nums"
                            row class=FieldShell
                              row width=26 align-self="stretch" flex-shrink=0 align-items="center" justify-content="center" color="ink.muted" pointer-events="none" aria-hidden=true
                                Icon(name=deviceIcon(v.name), size=14, angle=0)
                              select value=v.name change=prop("preset") class=Field flex=1 background-color="transparent" padding-left=0 aria-label="Viewport preset" testId="viewport-preset"
                                if v.name == "Custom"
                                  option "Custom" value="Custom" disabled=true
                                for device in doc.devices key=device.slug
                                  option device.label value=device.name
                            row gap=8 align-items="center"
                              if v.platform == "ios"
                                InlineField(prefix="W", icon="", value=`${v.width}`, accessibleLabel="Viewport width", hint="Viewport width · Fixed by the simulator's screen", testId="frame-width", disabled=true, change=prop("width"))
                                InlineField(prefix="H", icon="", value=`${v.height}`, accessibleLabel="Viewport height", hint="Viewport height · Fixed by the simulator's screen", testId="frame-height", disabled=true, change=prop("height"))
                              else
                                PropertyField(label="W", accessibleLabel="Viewport width", value=`${v.width}`, change=prop("width"), testId="frame-width")
                                PropertyField(label="H", accessibleLabel="Viewport height", value=`${v.height}`, change=prop("height"), testId="frame-height")
                              if v.canAutoHeight
                                button press=prop("heightMode", "content") class=SmallTool width=28 height=28 aria-label="Fit screen height to content" aria-pressed=v.autoHeight data-tip=(v.autoHeight ? "Height fits content · enter a height to fix it" : "Fit height to content") background-color=(v.autoHeight ? "surface.selected" : "surface.field") color=(v.autoHeight ? "ink.selected" : "ink.secondary") testId="auto-height"
                                  Icon(name="fold-vertical", size=14, angle=0)
                            if v.platform == "ios"
                              column gap=4
                                button press=refreshNativeFrame(v.id) disabled=(native.state == "working") class=SecondaryButton data-tip="Refresh preview · Capture this frame again in the iOS Simulator" testId="native-refresh"
                                  Icon(name="refresh-cw", size=16, angle=0)
                                  text "Refresh preview"
                                button press=refreshNative disabled=(native.state == "working") class=RowButton color="ink.secondary" data-tip="Refresh all native previews · Capture frames whose screenshot is missing or stale" testId="native-refresh-all"
                                  Icon(name="refresh-cw", size=14, angle=0)
                                  text "Refresh all native previews"
                      for n in doc.layers.filter(n => n.id == doc.selected) key=n.id
                        column class=PanelSection
                          row class=SectionHead gap=8
                            column color="ink.secondary"
                              ElementIcon(kind=n.kind)
                            SectionHeading(label=layerKind(n.kind))
                            SmallButton(icon="trash-2", label="Delete selection", hint="", selected=false, disabled=false, testId="delete", press=command("delete", ""))
                          input value=n.name change=prop("name") class=Field aria-label="Layer name" testId="name"
                        column class=PanelSection
                          row class=SectionHead
                            SectionHeading(label="Position")
                          row gap=8
                            PropertyField(label="X", accessibleLabel="X position", value=`${n.x}`, change=prop("x"), testId="x")
                            PropertyField(label="Y", accessibleLabel="Y position", value=`${n.y}`, change=prop("y"), testId="y")
                        column class=PanelSection
                          row class=SectionHead
                            SectionHeading(label="Layout")
                          row gap=8
                            PropertyField(label="W", accessibleLabel="Width", value=`${n.width}`, change=prop("width"), testId="width")
                            PropertyField(label="H", accessibleLabel="Height", value=`${n.height}`, change=prop("height"), testId="height")
                          row class=Segmented
                            button press=prop("widthMode", "fixed") class=Segment aria-pressed=(n.widthMode == "fixed") aria-label="Fixed width" data-tip="Keep this width in every viewport" testId="width-fixed"
                              Icon(name="move-horizontal", size=14, angle=0)
                              text "Fixed"
                            button press=prop("widthMode", "fill") class=Segment aria-pressed=(n.widthMode == "fill") aria-label="Fill width" data-tip="Stretch with the viewport" testId="width-fill"
                              Icon(name="stretch-horizontal", size=14, angle=0)
                              text "Fill"
                        column class=PanelSection
                          row class=SectionHead
                            SectionHeading(label="Fill")
                          row class=FieldShell
                            column width=14 height=14 flex-shrink=0 margin="0 6px 0 7px" box-sizing="border-box" border-radius=3 border="1px solid line.strong" background-color=n.fill pointer-events="none" aria-hidden=true
                            input value=n.fill change=prop("fill") class=Field flex=1 background-color="transparent" padding-left=0 aria-label="Fill color" testId="fill"
                        if n.kind != "text"
                          column class=PanelSection
                            row class=SectionHead
                              SectionHeading(label="Appearance")
                            row gap=8
                              InlineField(prefix="", icon="radius", value=`${n.radius}`, accessibleLabel="Border radius", hint="Border radius", testId="radius", disabled=false, change=prop("radius"))
                              column flex=1
                        if n.kind != "rectangle"
                          column class=PanelSection
                            row class=SectionHead
                              SectionHeading(label="Text")
                            input value=n.text change=prop("text") class=Field aria-label="Text content" testId="text-content"
                            row gap=8
                              InlineField(prefix="", icon="a-large-small", value=`${n.fontSize}`, accessibleLabel="Font size", hint="Font size", testId="font-size", disabled=false, change=prop("fontSize"))
                              column flex=1
            if timelineOpen
              column height=(historySelected == "" ? 104 : 248) flex-shrink=0 background-color="surface.panel" border-top="1px solid line.subtle" testId="design-timeline"
                row height=40 flex-shrink=0 box-sizing="border-box" align-items="center" padding="0 8px 0 16px" gap=8
                  column color="ink.secondary"
                    Icon(name="history", size=14, angle=0)
                  text "Timeline" font="type.body" font-weight=600
                  text `${history.entries.length} ${history.entries.length == 1 ? "change" : "changes"}` font="type.caption" color="ink.secondary" padding="1px 8px" border-radius=10 background-color="surface.field"
                  row flex=1
                  IconButton(icon="x", label="Close timeline", hint="Close timeline", shortcut="", selected=false, disabled=false, testId="close-timeline", press=toggleTimeline)
                if history.error != ""
                  row padding="8px 16px" gap=8 align-items="center" color="ink.danger"
                    Icon(name="circle-alert", size=14, angle=0)
                    text history.error role="alert" color="ink.primary"
                else if history.entries.length == 0
                  row padding="8px 16px" gap=8 align-items="center" color="ink.muted"
                    Icon(name="info", size=14, angle=0)
                    text "Your design changes will appear here." font="type.caption"
                else
                  row overflow-x="auto" height=56 flex-shrink=0 align-items="center" padding="0 16px" gap=0 aria-label="Design history"
                    for point in history.entries key=point.id
                      button press=inspectHistory(point.id) class=Segment flex="none" width="auto" min-width=44 height=30 flex-shrink=0 padding="0 10px" gap=6 border-radius=15 border="1px solid line.subtle" aria-label=`Change ${point.number}: ${point.label}` aria-pressed=(historySelected == point.id) data-tip=`${point.label} · ${point.target} · ${point.timeLabel}` background-color=(historySelected == point.id ? "surface.selected" : "surface.field") color=(historySelected == point.id ? "ink.selected" : "ink.secondary")
                        Icon(name=point.icon, size=14, angle=0)
                        text `${point.number}` font="type.caption" font-variant-numeric="tabular-nums"
                      if point.number < history.entries.length
                        column width=12 height=1 background-color="line.strong" flex-shrink=0
                  for point in history.entries.filter(p => p.id == historySelected) key=point.id
                    column flex=1 min-height=0 overflow-y="auto" padding="10px 16px 12px" gap=8 border-top="1px solid line.subtle" testId="timeline-detail"
                      row gap=8 align-items="center" flex-wrap="wrap"
                        column color="ink.secondary"
                          Icon(name=point.icon, size=14, angle=0)
                        text point.label font-weight=600
                        text point.target color="ink.secondary"
                        text `${point.actor == "ai" ? "AI" : "You"} · ${point.timeLabel}` data-tip=point.time color="ink.muted" font="type.caption"
                      for change in point.changes key=change.id
                        row gap=8 align-items="center" flex-wrap="wrap" min-height=24
                          text change.property width=120 font="type.caption" color="ink.secondary" data-tip=change.target overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
                          text change.before max-width=320 overflow-x="auto" white-space="pre-wrap" font="type.mono" padding="1px 6px" border-radius=4 background-color="surface.diff-remove" color="ink.diff-remove"
                          column color="ink.muted"
                            Icon(name="arrow-right", size=12, angle=0)
                          text change.after max-width=320 overflow-x="auto" white-space="pre-wrap" font="type.mono" padding="1px 6px" border-radius=4 background-color="surface.diff-add" color="ink.diff-add"
                          text change.target max-width=280 overflow="hidden" white-space="nowrap" text-overflow="ellipsis" data-tip=change.target font="type.mono" color="ink.muted"
            if codeOpen
              column position="absolute" inset=0 z-index=10 background-color="surface.scrim" align-items="center" justify-content="center" padding=24 box-sizing="border-box"
                column class=Dialog width=680 height=540 max-height="85%"
                  DialogHeader(icon="code-2", title="Contract source", subtitle=`Generated from ${doc.screenName} · paste into your app`, close=toggleCode, closeLabel="Close export", closeId="close-export")
                  column flex=1 min-height=0 padding=16 gap=12
                    textarea value=doc.code readonly=true flex=1 width="100%" min-height=0 font="type.mono" border="1px solid line.subtle" border-radius="radius.panel" background-color="surface.field" color="ink.primary" padding=12 box-sizing="border-box" resize="none" aria-label="Contract source" testId="code"
                  row padding="12px 16px" gap=8 align-items="center" border-top="1px solid line.subtle"
                    text "Buttons are exported without actions; connect them in your app." font="type.caption" color="ink.muted" flex=1 min-width=0
                    button press=copyCode class=PrimaryButton aria-label="Copy Contract" testId="copy-code"
                      Icon(name="copy", size=14, angle=0)
                      text "Copy"
            if reviewOpen and editing
              match designChanged
                case some(result)
                  column position="absolute" inset=0 z-index=10 background-color="surface.scrim" align-items="center" justify-content="center" padding=24 box-sizing="border-box" testId="review-scrim"
                    column class=Dialog width=640 max-height="85%" aria-label="Review changes" testId="review-dialog"
                      DialogHeader(icon="git-compare", title="Review changes", subtitle=`${result.draftCount} ${result.draftCount == 1 ? "change" : "changes"} in ${result.draftFiles.length} ${result.draftFiles.length == 1 ? "file" : "files"} · nothing is written until you apply`, close=toggleReview, closeLabel="Close review", closeId="close-review")
                      scroll flex=1 min-height=0
                        column padding=16 gap=12
                          if result.draftFiles.length == 0
                            text "There are no pending changes." font="type.body" color="ink.secondary" padding=8
                          for file, f in result.draftFiles key=file.file
                            column border="1px solid line.subtle" border-radius="radius.panel" overflow="hidden" flex-shrink=0
                              row height=36 box-sizing="border-box" padding="0 12px" gap=8 align-items="center" background-color="surface.field"
                                column color="ink.secondary"
                                  Icon(name="file-code", size=14, angle=0)
                                text file.file font="type.mono" color="ink.primary" flex=1 min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis" data-tip=file.file
                                text `${file.changes.length} ${file.changes.length == 1 ? "change" : "changes"}` font="type.caption" color="ink.muted"
                              for change, c in file.changes key=change.key
                                row padding="12px 8px 12px 12px" gap=12 align-items="flex-start" border-top="1px solid line.subtle" testId=`review-change-${f}-${c}`
                                  row width=28 height=28 flex-shrink=0 border-radius=6 align-items="center" justify-content="center" background-color="surface.field" color="ink.secondary"
                                    Icon(name=change.icon, size=14, angle=0)
                                  column flex=1 min-width=0 gap=6
                                    row gap=6 align-items="center" min-height=20 flex-wrap="wrap"
                                      text change.name font="type.body" font-weight=600
                                      if change.element != ""
                                        text `on ${change.element}` font="type.body" color="ink.secondary" min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
                                      if change.added
                                        text "New" font="type.caption" padding="0 6px" border-radius=8 background-color="surface.diff-add" color="ink.diff-add" data-tip="Adds a property that was not set in source"
                                      if change.replaced
                                        text "Replaces expression" font="type.caption" padding="0 6px" border-radius=8 background-color="surface.notice" color="ink.selected" data-tip="Replaces a responsive or data-driven expression with a static value"
                                      if change.shared
                                        text "Shared style" font="type.caption" padding="0 6px" border-radius=8 background-color="surface.notice" color="ink.selected" data-tip="Updates every element that uses this style"
                                      row flex=1
                                      text `L${change.line}` font="type.mono" color="ink.muted" data-tip=change.location
                                    column border="1px solid line.subtle" border-radius=6 overflow="hidden"
                                      if not change.added
                                        row gap=8 padding="4px 8px" align-items="center" background-color="surface.diff-remove" color="ink.diff-remove"
                                          text "−" font="type.mono" width=10 flex-shrink=0 aria-hidden=true
                                          if change.swatchBefore != ""
                                            column width=12 height=12 flex-shrink=0 border-radius=3 border="1px solid line.strong" box-sizing="border-box" background-color=change.swatchBefore aria-hidden=true
                                          text `${change.property}=${change.before}` font="type.mono" flex=1 min-width=0 white-space="pre-wrap" aria-label=`Before: ${change.before}`
                                      row gap=8 padding="4px 8px" align-items="center" background-color="surface.diff-add" color="ink.diff-add"
                                        text "+" font="type.mono" width=10 flex-shrink=0 aria-hidden=true
                                        if change.swatchAfter != ""
                                          column width=12 height=12 flex-shrink=0 border-radius=3 border="1px solid line.strong" box-sizing="border-box" background-color=change.swatchAfter aria-hidden=true
                                        text `${change.property}=${change.after}` font="type.mono" flex=1 min-width=0 white-space="pre-wrap" aria-label=`After: ${change.after}`
                                  SmallButton(icon="rotate-ccw", label=`Revert ${change.name}`, hint=`Revert ${change.name} · Remove this change from the draft`, selected=false, disabled=designWriting, testId=`review-revert-${f}-${c}`, press=revertDesign(change.key))
                      if result.draftError != ""
                        row padding="8px 16px" gap=8 align-items="flex-start" color="ink.danger" border-top="1px solid line.subtle"
                          Icon(name="circle-alert", size=14, angle=0)
                          text result.draftError role="alert" flex=1 font="type.caption" color="ink.primary"
                      row padding="12px 16px" gap=8 align-items="center" border-top="1px solid line.subtle"
                        button press=discardDesign class=SecondaryButton color="ink.danger" disabled=designWriting testId="review-discard"
                          Icon(name="trash-2", size=14, angle=0)
                          text "Discard all"
                        row flex=1
                        button press=toggleReview class=SecondaryButton testId="review-cancel"
                          text "Keep editing"
                        button press=applyDesign class=PrimaryButton disabled=(not result.canApply or designWriting) aria-label=`Apply ${result.draftCount} ${result.draftCount == 1 ? "change" : "changes"} to code` testId="review-apply"
                          Icon(name="code-2", size=14, angle=0)
                          text `Apply ${result.draftCount} ${result.draftCount == 1 ? "change" : "changes"}`
                case none
                  column display="none"
            if preview
              column position="absolute" inset=0 z-index=10 background-color="surface.canvas" align-items="center" justify-content="center" gap=16 padding=24 box-sizing="border-box"
                row width="90%" max-width=720 align-items="center" gap=8
                  column color="ink.secondary"
                    Icon(name="play", size=14, angle=0)
                  text doc.screenName font-weight=600 flex=1
                  if clicks > 0
                    text `Clicked ${clicks}` font="type.caption" color="ink.secondary" padding="2px 8px" border-radius=10 background-color="surface.field" testId="preview-clicks"
                  IconButton(icon="x", label="Close preview", hint="Close preview", shortcut="", selected=false, disabled=editing, testId="close-preview", press=togglePreview)
                scroll width="100%" max-width=doc.width height=doc.height max-height="80%" overflow-x="scroll" border-radius="radius.panel" box-shadow="shadow.menu"
                  column position="relative" width=doc.width height=doc.height overflow="hidden" background-color="paper" testId="live-screen"
                    if doc.platform == "ios"
                      NativeFrame(id=doc.active, name="Native preview", status=native)
                    else
                      ScreenView(source=doc.previewSource, layers=doc.layers, prefix="preview", selected="", dx=0, dy=0, resizing=false, activate=previewClick)
        if entry.name == "project" or entry.name == "addScreen"
          column navigationKey=`${entry.id}` navigationPresentation="fullscreen" position="absolute" inset=0 background-color="surface.scrim" align-items="center" justify-content="center" padding=20 box-sizing="border-box"
            column class=Dialog width=420
              row height=56 flex-shrink=0 box-sizing="border-box" align-items="center" gap=10 padding="0 12px 0 16px" border-bottom="1px solid line.subtle"
                row width=28 height=28 flex-shrink=0 border-radius=6 align-items="center" justify-content="center" background-color="surface.field" color="ink.secondary"
                  Icon(name=(entry.name == "project" ? "link-2" : "frame"), size=14, angle=0)
                column flex=1 min-width=0
                  text (entry.name == "project" ? "Project" : "Add screen") font="type.heading" font-weight=600
                  text (entry.name == "project" ? "Connect a running Exact app" : (screenKind == "add" ? "Choose a route from your project" : "Start from an editable blank screen")) font="type.caption" color="ink.secondary"
                if entry.name == "addScreen" and screenKind == "add"
                  IconButton(icon="refresh-cw", label="Refresh screens", hint="Refresh screens · Reload the route list from your project", shortcut="", selected=false, disabled=pending(discovered), testId="refresh-discovery", press=refreshDiscovery)
                button id="closeLibrary" press=closeLibrary class=Tool aria-label="Close" data-tip="Close" testId="close-library"
                  Icon(name="x", size=16, angle=0)
              column padding=16 gap=16 overflow-y="auto" min-height=0
                if entry.name == "project"
                  column gap=4
                    FieldLabel(label="Name")
                    input value=projectNameValue input=projectNameInput class=Field placeholder="My app" aria-label="Project name" testId="project-name"
                  column gap=4
                    FieldLabel(label="Dev server URL")
                    row class=FieldShell
                      row width=26 align-self="stretch" flex-shrink=0 align-items="center" justify-content="center" color="ink.muted" pointer-events="none" aria-hidden=true
                        Icon(name="globe", size=14, angle=0)
                      input value=projectUrlValue input=projectUrlInput class=Field flex=1 background-color="transparent" padding-left=0 placeholder="http://127.0.0.1:5174" aria-label="Project URL" testId="project-url"
                    text "Start the app with EXACT_TOOL_PORT set to this editor's port." font="type.caption" color="ink.muted"
                  if libraryError != ""
                    row gap=8 align-items="flex-start" color="ink.danger"
                      Icon(name="circle-alert", size=14, angle=0)
                      text libraryError role="alert" color="ink.primary" font="type.caption" flex=1 testId="library-error"
                else
                  if doc.projectUrl != ""
                    row class=Segmented
                      button press=chooseKind("add") class=Segment aria-pressed=(screenKind == "add") testId="screen-project"
                        Icon(name="route", size=14, angle=0)
                        text "Project" font="type.body"
                      button press=chooseKind("blank") class=Segment aria-pressed=(screenKind == "blank") testId="screen-blank"
                        Icon(name="square-dashed", size=14, angle=0)
                        text "Blank" font="type.body"
                  if screenKind == "add"
                    column gap=4
                      FieldLabel(label="Available screens")
                      if pending(discovered)
                        row gap=8 align-items="center" padding="10px 8px" color="ink.secondary" role="status"
                          Icon(name="refresh-cw", size=14, angle=0)
                          text "Finding screens…" font="type.body"
                      if discovered.owner == doc.projectUrl and not pending(discovered)
                        if discovered.error != ""
                          row gap=8 align-items="flex-start" padding="10px 8px" color="ink.secondary"
                            Icon(name="circle-alert", size=14, angle=0)
                            text discovered.error font="type.caption" flex=1 role="status" testId="discovery-error"
                        else
                          if discovered.routes.length == 0
                            row gap=8 align-items="center" padding="10px 8px" color="ink.secondary"
                              Icon(name="info", size=14, angle=0)
                              text "No screens found. Enter a route below." font="type.caption" testId="discovery-empty"
                          else
                            scroll max-height=184 border="1px solid line.subtle" border-radius="radius.panel"
                              column gap=1 padding=4
                                for screen, i in discovered.routes key=screen.route
                                  button press=chooseScreen(screen.name, screen.route) disabled=screen.added class=TreeRow testId=`discovered-${i}` aria-label=`${screen.name}, ${screen.route}` display="flex" align-items="center" gap=10 height=40 flex-shrink=0 padding="0 8px" border-width=0 background-color=(screenPath == screen.route and screenName == screen.name ? "surface.selected" : "transparent") color=(screenPath == screen.route and screenName == screen.name ? "ink.selected" : "ink.primary") opacity=(screen.added ? 0.55 : 1)
                                    column color="ink.muted" flex-shrink=0
                                      Icon(name=(screen.added ? "check" : "route"), size=14, angle=0)
                                    column flex=1 min-width=0 gap=0 align-items="flex-start"
                                      text screen.name font="type.body" font-weight=500
                                      text screen.route font="type.mono" color="ink.secondary" text-align="left" width="100%" overflow="hidden" white-space="nowrap" text-overflow="ellipsis" data-tip=screen.route
                                    if screen.added
                                      text "Added" font="type.caption" color="ink.secondary" padding="1px 6px" border-radius=8 background-color="surface.field"
                                    else
                                      if screen.dynamic
                                        text "Set path" font="type.caption" color="ink.selected" padding="1px 6px" border-radius=8 background-color="surface.notice"
                  column gap=4
                    FieldLabel(label="Screen name")
                    input value=screenName input=screenNameInput class=Field placeholder="Settings" aria-label="Screen name" testId="new-screen-name"
                  if screenKind == "add"
                    column gap=4
                      FieldLabel(label="Route")
                      row class=FieldShell
                        row width=26 align-self="stretch" flex-shrink=0 align-items="center" justify-content="center" color="ink.muted" pointer-events="none" aria-hidden=true
                          Icon(name="route", size=14, angle=0)
                        input value=screenPath input=screenPathInput class=Field flex=1 background-color="transparent" padding-left=0 placeholder="/settings" aria-label="Route" testId="new-screen-route"
                  column gap=4
                    FieldLabel(label="Viewports")
                    row class=FieldShell
                      row width=26 align-self="stretch" flex-shrink=0 align-items="center" justify-content="center" color="ink.muted" aria-hidden=true
                        Icon(name=(doc.deviceSets.filter(s => s.name == screenPreset).length > 0 ? "monitor-smartphone" : deviceIcon(screenPreset)), size=14, angle=0)
                      select value=screenPreset change=choosePreset class=Field flex=1 background-color="transparent" padding-left=0 aria-label="Viewports" testId="new-screen-viewports"
                        for set in doc.deviceSets key=set.slug
                          option set.label value=set.name
                        for device in doc.devices key=device.slug
                          option device.label value=device.name
                  if libraryError != ""
                    row gap=8 align-items="flex-start" color="ink.danger"
                      Icon(name="circle-alert", size=14, angle=0)
                      text libraryError role="alert" color="ink.primary" font="type.caption" flex=1 testId="library-error"
              row padding="12px 16px" gap=8 align-items="center" border-top="1px solid line.subtle"
                if entry.name == "project"
                  if doc.projectUrl != ""
                    button press=disconnectProject class=SecondaryButton color="ink.danger" disabled=pending(libraryChanged) testId="disconnect-project"
                      Icon(name="unplug", size=14, angle=0)
                      text "Disconnect"
                  row flex=1
                  button press=saveProject disabled=(projectNameValue.trim() == "" or projectUrlValue.trim() == "" or pending(libraryChanged)) class=PrimaryButton testId="save-project"
                    text (doc.projectUrl == "" ? "Connect" : "Save")
                else
                  if screenKind == "add" and discovered.owner == doc.projectUrl and not pending(discovered) and addableScreens > 0
                    button press=addAllScreens disabled=pending(libraryChanged) class=SecondaryButton data-tip="Add every listed screen that is not on the canvas yet, each with the chosen viewports" testId="add-all-screens"
                      Icon(name="layout-grid", size=14, angle=0)
                      text `Add all ${addableScreens}`
                  row flex=1
                  button press=saveScreen disabled=(screenName.trim() == "" or pending(libraryChanged)) class=PrimaryButton testId="create-screen"
                    Icon(name="plus", size=14, angle=0)
                    text "Add screen"

component FileHeader
  props
    name: string
    subtitle: string
    compact: bool
    open: bool
    disabled: bool
    connect: action
    toggle: action
  view
    row height=(compact ? 40 : 48) flex-shrink=0 box-sizing="border-box" align-items="center" gap=2 padding=(compact ? "0 4px" : "0 8px") border-bottom=(compact ? "none" : "1px solid line.subtle")
      button press=connect disabled=disabled class=TreeRow display="flex" align-items="center" gap=8 flex=1 min-width=0 height=(compact ? 32 : 36) padding="0 6px" border-width=0 background-color="transparent" color="ink.primary" text-align="left" aria-label="Project connection" data-tip=(subtitle == "" ? "Project settings" : subtitle) testId="project-connection"
        row width=22 height=22 flex-shrink=0 border-radius=6 align-items="center" justify-content="center" background-color="surface.action" color="ink.on-action" aria-hidden=true
          Icon(name="layers", size=13, angle=0)
        column flex=1 min-width=0 gap=0
          row align-items="center" gap=4 min-width=0
            text name testId="document-name" font="type.body" font-weight=600 min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
            column color="ink.muted" flex-shrink=0
              Icon(name="chevron-down", size=12, angle=0)
          if not compact
            text subtitle font="type.caption" color="ink.muted" min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
      IconButton(icon="panel-left", label=(open ? "Hide screens" : "Show screens"), hint=(open ? "Hide screens panel" : "Show screens panel"), shortcut="", selected=false, disabled=false, testId="toggle-screens", press=toggle)

component ActionBar
  props
    compact: bool
    narrow: bool
    minimal: bool
    canUndo: bool
    canRedo: bool
    canExport: bool
    canPreview: bool
    open: bool
    undo: action
    redo: action
    save: action
    preview: action
    exportCode: action
    toggle: action
  view
    row height=(compact ? 40 : 48) flex-shrink=0 box-sizing="border-box" align-items="center" gap=2 padding=(compact ? "0 4px" : "0 8px") border-bottom=(compact ? "none" : "1px solid line.subtle")
      button press=undo aria-keyshortcuts="Meta+z Control+z" class=Tool display=(narrow ? "none" : "flex") disabled=not canUndo aria-label="Undo" data-tip="Undo (⌘Z)" testId="undo"
        Icon(name="undo-2", size=16, angle=0)
      button press=redo aria-keyshortcuts="Meta+Shift+z Control+Shift+z" class=Tool display=(narrow ? "none" : "flex") disabled=not canRedo aria-label="Redo" data-tip="Redo (⇧⌘Z)" testId="redo"
        Icon(name="redo-2", size=16, angle=0)
      button press=save aria-keyshortcuts="Meta+s Control+s" class=Tool display=(narrow and compact ? "none" : "flex") aria-label="Save" data-tip="Save (⌘S)" testId="save"
        Icon(name="save", size=16, angle=0)
      row flex=1 min-width=(compact ? 8 : 0) display=(minimal ? "none" : "flex")
      button press=preview disabled=not canPreview class=Tool display=(minimal ? "none" : "flex") aria-label="Preview" data-tip="Preview · Open this screen full size to use it like the app" testId="preview"
        Icon(name="play", size=16, angle=0)
      button press=exportCode disabled=not canExport class=PrimaryButton display=(minimal ? "none" : "flex") margin="0 2px" data-tip=(canExport ? "Export Contract source" : "Export is available for editable screens") testId="export"
        text "Export"
      IconButton(icon="panel-right", label=(open ? "Hide inspector" : "Show inspector"), hint=(open ? "Hide inspector panel" : "Show inspector panel"), shortcut="", selected=false, disabled=false, testId="toggle-inspector", press=toggle)

component DialogHeader
  props
    icon: string
    title: string
    subtitle: string
    closeLabel: string
    closeId: string
    close: action
  view
    row min-height=56 flex-shrink=0 box-sizing="border-box" align-items="center" gap=10 padding="10px 12px 10px 16px" border-bottom="1px solid line.subtle"
      row width=28 height=28 flex-shrink=0 border-radius=6 align-items="center" justify-content="center" background-color="surface.notice" color="ink.selected"
        Icon(name=icon, size=14, angle=0)
      column flex=1 min-width=0
        text title font="type.heading" font-weight=600
        text subtitle font="type.caption" color="ink.secondary"
      IconButton(icon="x", label=closeLabel, hint=closeLabel, shortcut="", selected=false, disabled=false, testId=closeId, press=close)

component ElementIcon
  props
    kind: string
  view
    Icon(name=(kind == "text" or kind == "span" ? "type" : kind == "button" ? "rectangle-horizontal" : kind == "row" ? "columns-2" : kind == "column" ? "rows-2" : kind == "grid" ? "grid-2x2" : kind == "image" or kind == "img" ? "image" : kind == "input" ? "text-cursor-input" : kind == "screen" or kind == "main" ? "frame" : "square"), size=14, angle=0)

component ScreenView
  props
    source: string
    layers: Layer[]
    prefix: string
    selected: string
    dx: number
    dy: number
    resizing: bool
    activate: action
  view
    column position="relative" width="100%" height="100%" overflow="hidden" background-color="paper" font-family="system-ui"
      if source != ""
        // A new frame avoids adding preview URL changes to the editor's browser history.
        for url in [source] key=url
          iframe id=prefix src=url width="100%" height="100%" border="none" outline="none" box-shadow="none" flex-shrink=0 title="Live app preview" sandbox="allow-scripts allow-same-origin allow-forms" testId=`${prefix}-app`
      else
        for n in layers key=n.id
          ScreenLayer(n=n, prefix=prefix, selected=(selected == n.id), dx=dx, dy=dy, resizing=resizing, activate=activate)

component ScreenLayer
  props
    n: Layer
    prefix: string
    selected: bool
    dx: number
    dy: number
    resizing: bool
    activate: action
  derive x = n.x + (selected and not resizing ? dx : 0)
  derive y = n.y + (selected and not resizing ? dy : 0)
  derive w = n.widthMode == "fill" ? `max(1px, calc(100% - ${x + n.right - (selected and resizing ? dx : 0)}px))` : `${max(1, n.width + (selected and resizing ? dx : 0))}px`
  derive h = max(1, n.height + (selected and resizing ? dy : 0))
  view
    if n.kind == "text"
      text n.text position="absolute" left=x top=y width=w height=h color=n.fill font-size=n.fontSize line-height=1.2 white-space="pre-wrap" overflow="hidden" testId=`${prefix}-${n.id}`
    else
      if n.kind == "button"
        button press=activate position="absolute" left=x top=y width=w height=h background-color=n.fill color="paper" border-radius=n.radius border-width=0 padding=0 display="flex" align-items="center" justify-content="center" box-sizing="border-box" overflow="hidden" testId=`${prefix}-${n.id}`
          text n.text font-size=n.fontSize line-height=1.2
      else
        column position="absolute" left=x top=y width=w height=h background-color=n.fill border-radius=n.radius testId=`${prefix}-${n.id}`

component NativeFrame
  props
    id: string
    name: string
    status: NativeStatus
  derive frame = match first(status.frames.filter(f => f.id == id)) { case some(f) => f, case none => NativeShot(id=id, state="empty", shot="", width=0, height=0, capturedAt=0, error="") }
  derive error = status.error != "" ? status.error : frame.error
  view
    column position="relative" width="100%" height="100%" overflow="hidden" background-color="surface.panel" color="ink.secondary" testId=`${id}-native`
      if frame.shot != ""
        image frame.shot width="100%" height="100%" object-fit="fill" alt=name testId=`${id}-native-shot`
      if error != "" or frame.shot == ""
        column position="absolute" inset=0 align-items="center" justify-content="center" padding=24 gap=12 background-color="surface.panel"
          Icon(name=(error != "" ? "circle-alert" : deviceIcon(name)), size=32, angle=0)
          text "Native preview" font="type.heading" color="ink.primary"
          text (error != "" ? error : frame.state == "queued" or frame.state == "capturing" ? "Waiting for the iOS build…" : "Not captured yet") font="type.body" text-align="center" testId=`${id}-native-state`
          if error == "" and frame.state == "empty"
            text "Select Refresh preview to capture." font="type.caption" text-align="center"
      if frame.state == "queued" or frame.state == "capturing" or frame.state == "stale"
        row class=FloatingBar position="absolute" top=12 left=12 padding="4px 8px" gap=8
          Icon(name=(frame.state == "stale" ? "history" : "refresh-cw"), size=14, angle=0)
          text (frame.state == "stale" ? "Stale · the app changed" : "Capturing…") font="type.caption" testId=`${id}-native-chip`
