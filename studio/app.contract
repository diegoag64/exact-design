                      Icon(name="plus", size=16, angle=0)
                row display=(panelOverlay ? "none" : "flex") position="absolute" right=16 bottom=(viewport.width >= 1000 ? 24 : 82) align-items="center" gap=4 background-color="ink.inverse" border-radius=8 padding=2 border="1px solid line.subtle"
                  IconButton(icon="minus", label="Zoom out", hint="Zoom out", shortcut="", selected=false, disabled=false, testId="zoom-out", press=zoomOut)
                  button press=resetView class=Tool width=48 aria-label="Fit all screens" title="Fit all screens" testId="zoom"
                    text `${round(zoom * 100)}%` font="type.caption" font-variant-numeric="tabular-nums"
                  IconButton(icon="plus", label="Zoom in", hint="Zoom in", shortcut="", selected=false, disabled=false, testId="zoom-in", press=zoomIn)
              if rightOpen
                scroll testId="inspector-panel" position=(viewport.width >= 700 ? "relative" : "absolute") right=0 top=0 bottom=0 z-index=3 background-color="surface.panel" width=inspectorWidth() flex-shrink=0 border-left-width=1 border-left-style="solid" border-left-color="line.subtle"
                  column gap=0
                    row class=PanelSection height=46 box-sizing="border-box" align-items="center"
                      text "Design" font="type.body" font-weight=600 flex=1
                      if doc.source != "" or editing
                        button press=toggleEditing disabled=designWriting class=Tool width="auto" height=26 padding="0 8px" background-color=(editing ? "surface.selected" : "surface.field") color=(editing ? "ink.selected" : "ink.primary") aria-label=(editing ? "Finish editing app" : "Edit app design") testId="edit-app"
                          Icon(name=(editing ? "check" : "mouse-pointer-2"), size=14, angle=0)
                          text (editing ? "Done" : "Edit") font="type.body"
                    if designError != ""
                      text designError margin=16 role="alert" font="type.body" color="ink.secondary" testId="design-error"
                    if editing
                      column gap=0
                        match designChanged
                          case some(result)
                            if result.draftCount > 0
                              column class=PanelSection
                                row align-items="center" justify-content="space-between"
                                  text `${result.draftCount} unsaved ${result.draftCount == 1 ? "change" : "changes"}` font="type.caption" color="ink.secondary" testId="draft-count"
                                  button press=discardDesign class=Tool height=26 padding=4 disabled=pending(designChanged) testId="discard-design"
                                    text "Discard" font="type.caption"
                                button press=applyDesign class=Tool background-color="surface.selected" width="100%" disabled=(not result.canApply or pending(designChanged)) testId="apply-design"
                                  text "Apply to code" font="type.body"
                                if result.draftError != ""
                                  text result.draftError role="alert" font="type.caption" color="ink.secondary" testId="draft-error"
                            for selected in result.crumbs.filter(c => c.selected) key=selected.id
                              column class=PanelSection
                                for parent in result.crumbs.filter(c => c.depth == selected.depth - 1) key=parent.id
                                  button press=selectElement(parent.id) class=Tool width="100%" height=26 padding=0 gap=6 justify-content="flex-start" aria-label=`Select parent: ${parent.label}` title=`Select parent: ${parent.label}` testId="element-parent" color="ink.secondary"
                                    Icon(name="chevron-right", size=10, angle=-90)
                                    text parent.label font="type.caption" overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
                                row align-items="flex-start" gap=8
                                  column padding-top=2 color="ink.secondary"
                                    ElementIcon(kind=selected.kind)
                                  text selected.label font="type.heading" font-weight=600 flex=1 min-width=0 hyphens="auto" testId="selected-element-name"
                                row gap=8 align-items="center"
                                  if selected.label != layerKind(selected.kind)
                                    text layerKind(selected.kind) font="type.caption" color="ink.secondary" testId="selected-element-kind"
                                  if result.source != ""
                                    text result.source font="type.caption" color="ink.muted" overflow="hidden" white-space="nowrap" text-overflow="ellipsis" min-width=0 title=result.source testId="design-source"
                                if result.instances > 1
                                  row gap=6 align-items="center" color="ink.secondary" title="These elements share one source template. Editing it updates every instance."
                                    Icon(name="layers", size=14, angle=0)
                                    text `Shared template · ${result.instances} instances` font="type.caption"
                            if result.source != ""
                              if result.crumbs.length == 0
                                button press=selectParent class=Tool width="100%" justify-content="flex-start" testId="design-parent"
                                  text "Select component" font="type.body"
                            if result.rows.length == 0
                              text (result.restoring ? result.message : result.applied ? "Applied to source." : result.message) margin=16 font="type.body" color="ink.secondary" testId="design-message"
                            if result.canUndo
                              button press=undoDesign disabled=pending(designChanged) class=Tool width="100%" justify-content="flex-start" testId="undo-app-design"
                                text "Undo draft change" font="type.body"
                          case none
                            text "Select an element in a screen." font="type.body"
                        for group in ["Layout", "Spacing", "Text", "Typography", "Appearance"] key=group
                          if designRows.filter(p => p.group == group).length > 0
                            column class=PanelSection
                              SectionHeading(label=group)
                              row flex-wrap="wrap" gap=12 align-items="flex-start"
                                for property in designRows.filter(p => p.group == group) key=`${property.binding}-${property.id}`
                                  column gap=6 min-width=0 width=((group == "Typography" and property.property != "font-family" and property.property != "color") or (group == "Layout" and (property.property.includes("width") or property.property.includes("height"))) ? "calc(50% - 6px)" : "100%")
                                    row align-items="center" gap=6
                                      text property.name font="type.caption" color="ink.secondary" flex=1 title=property.property
                                      if property.shared
                                        column color="ink.selected" title=`Shared style · ${property.binding} · updates every use` aria-label="Shared source style"
                                          Icon(name="layers", size=14, angle=0)
                                      if property.fields.length > 0 and not property.readonly
                                        button press=toggleFieldLink(property.id, property.binding, firstField(property.fields), not property.linked or independentFields.includes(property.binding)) class=Tool width=24 height=24 padding=4 aria-label=`${property.linked and not independentFields.includes(property.binding) ? "Unlink" : "Link"} ${property.name}` aria-pressed=(property.linked and not independentFields.includes(property.binding)) title=(property.linked and not independentFields.includes(property.binding) ? "Linked · one value changes all" : "Independent values · link using the first value") color=(property.linked and not independentFields.includes(property.binding) ? "ink.selected" : "ink.muted") disabled=designWriting
                                          Icon(name="link-2", size=14, angle=0)
                                    if property.readonly
