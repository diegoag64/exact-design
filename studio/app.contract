                                          text (property.property == "gap" ? "Both" : "All") width=36 font="type.caption" color="ink.muted" text-align="center"
                                          input value=firstField(property.fields) change=editDesignField(property.id, "all") class=Field background-color="transparent" flex=1 min-width=0 aria-label=`${property.name} all` disabled=designWriting
                                      else
