                                              input value=field.value change=editDesignField(property.id, field.id) class=Field aria-label=`${property.name} ${field.label}` disabled=designWriting
                                    else if property.property == "text-content"
                                      textarea value=property.value change=editDesign(property.id) class=Field height=88 padding=8 resize="vertical" aria-label="Text content" disabled=designWriting
                                    else if property.options.length > 0
                                      select value=property.value change=editDesign(property.id) class=Field aria-label=property.name testId=`design-property-${property.id}` disabled=designWriting
                                        for choice in property.options key=choice.value
                                          option choice.label value=choice.value
                                    else
                                      input value=property.value change=editDesign(property.id) class=Field aria-label=property.name testId=`design-property-${property.id}` disabled=designWriting title=property.binding
                    if not editing
                      row class=PanelSection align-items="center"
                        text (doc.frameSelected ? "Screen" : "Layer") font-weight=600 flex=1
                        if doc.selected != "" and not doc.frameSelected
                          button press=command("delete", "") class=Tool aria-label="Delete selection" testId="delete"
                            Icon(name="trash-2", size=16, angle=0)
                      if doc.selected == ""
                        text "Select a screen or layer" color="ink.secondary"
                      if doc.frameSelected
                        for v in scene.views.filter(v => v.id == doc.active) key=v.id
