routes nav
  editor "/"
    project "/project"
    addScreen "/add-screen"

shape SnapTarget
  value: number
  guide: number
  start: number
  end: number
  gap: bool

fn magnitude(n: number): number = max(n, -n)
fn panEase(t: number): number = 1 - (1 - t) * (1 - t) * (1 - t)
fn layerKind(kind: string): string = kind == "text" or kind == "span" ? "Text" : kind == "button" ? "Button" : kind == "row" ? "Row" : kind == "column" ? "Column" : kind == "scroll" ? "Scroll" : kind == "grid" ? "Grid" : kind == "image" or kind == "img" ? "Image" : kind == "screen" or kind == "main" ? "Screen" : kind == "input" ? "Input" : "Container"
fn spacingName(property: string): string = property == "padding-top" ? "Top padding" : property == "padding-right" ? "Right padding" : property == "padding-bottom" ? "Bottom padding" : property == "padding-left" ? "Left padding" : property == "row-gap" ? "Vertical gap" : "Horizontal gap"

fn snappedDelta(targets: SnapTarget[], origin: number, delta: number, zoom: number): number = match first(sortBy(targets, t => magnitude(t.value - origin - delta))) { case some(t) => magnitude(t.value - origin - delta) <= 8 / zoom ? t.value - origin : delta, case none => delta }

shape Layer
  id: string
  kind: string
  name: string
  x: number
  y: number
  width: number
  height: number
  fill: string
  text: string
  fontSize: number
  radius: number
  widthMode: string
  right: number

shape CanvasView
  canAutoHeight: bool
  autoHeight: bool
  source: string
  previewSource: string
  layers: Layer[]
  id: string
  screenId: string
  screenName: string
  name: string
  x: number
  y: number
  width: number
  height: number

shape LibraryView
  id: string
  name: string
  x: number
  y: number
  width: number
  height: number

shape ScreenGroup
  id: string
  name: string
  route: string
  source: string
  views: LibraryView[]
  layers: Layer[]

shape Document
  previewRequests: string
  projectName: string
  projectUrl: string
  route: string
  groups: ScreenGroup[]
  frameX: number
  frameY: number
  snapX: SnapTarget[]
  snapY: SnapTarget[]
  source: string
  views: CanvasView[]
  active: string
  screenId: string
  frameSelected: bool
  width: number
  height: number
  screenName: string
  minX: number
  minY: number
  maxX: number
  maxY: number
  drawing: string
  name: string
  layers: Layer[]
  selected: string
  canUndo: bool
  canRedo: bool
  code: string
  status: string
  resizing: bool

shape Reply
  error: string
  ok: bool
  fit: bool
  minX: number
  minY: number
  maxX: number
  maxY: number

shape DiscoveredScreen
  name: string
  route: string
  dynamic: bool
  added: bool

shape Discovery
  owner: string
  routes: DiscoveredScreen[]
  error: string

shape DesignRow
  id: string
  name: string
  value: string
  shared: bool
  group: string
  options: LayoutOption[]

shape LayoutOption
  value: string
  label: string

shape SpacingInput
  property: string
  value: string
  shared: bool

shape SpacingBox
  key: string
  property: string
  x: number
  y: number
  width: number
  height: number
  labelX: number
  labelY: number
  value: string
  label: bool

shape SpacingMeasurement
  frame: string
  id: string
  plan: string
  boxes: SpacingBox[]

shape PreviewSignal
  revision: number
  updateRevision: number
  measurement: SpacingMeasurement

shape DesignReply
  draftCount: number
  draftState: string
  draftError: string
  canApply: bool
  ok: bool
  error: string
  session: string
  origin: string
  source: string
  component: string
  version: number
  selectionRevision: number
  message: string
  rows: DesignRow[]
  canUndo: bool
  applied: bool
  bridgeOrigin: string
  tree: ElementNode[]
  crumbs: ElementNode[]
  selectedLabel: string
  restoring: bool
  selecting: bool
  spacingId: string
  spacingPlan: string
  spacingFrame: string
  spacingInputs: SpacingInput[]

shape ElementNode
  id: string
  label: string
  depth: number
  selected: bool
  kind: string
  ancestors: string[]
  hasChildren: bool

style Tool
  box-sizing="border-box"
  display="flex"
  align-items="center"
  justify-content="center"
  width=32
  height=32
  padding=6
  border-width=0
  border-radius=6
  background-color="transparent"
  color="ink.secondary"

style Field
  width="100%"
  box-sizing="border-box"
  height=30
  border-width=0
  border-radius=5
  background-color="surface.field"
  color="ink.primary"
  padding-left=8
  padding-right=8
  font-size=12

shape Viewport
  prefersReducedMotion: bool
  width: number
  height: number

shape PreviewSizes
  requests: string
  ready: bool
  signature: string

component Studio
  resource viewport = exactViewport() as shape Viewport
  resource doc = document() as shape Document else empty(name="Untitled")
  state discoveryRevision = 0
  resource previews = previews(doc.previewRequests) as shape PreviewSizes else empty()
  resource renderedScene = scene(doc.drawing, previews.signature) as shape Document else empty()
  derive scene = renderedScene.active != "" ? renderedScene : doc
  resource discovered = discover(doc.projectUrl, doc.groups.map(g => g.route), discoveryRevision) as shape Discovery else empty()
  mutation changed as shape Reply queue refreshes doc then afterEdit
  mutation libraryChanged as shape Reply queue refreshes doc then afterLibrary
  mutation designChanged as shape DesignReply queue then afterDesign
  mutation hoverChanged as shape DesignReply queue
  resource previewSignal = previewSignal(designSession) as shape PreviewSignal else empty()
  derive spacingMeasured = editing ? some(previewSignal.measurement) : none
  state previewUpdateSeen = -1
  action previewUpdated
    previewUpdateSeen = previewSignal.updateRevision
    pollDesign()
  task pushedPreview when editing and not pending(designChanged) and previewSignal.updateRevision != previewUpdateSeen
    after(1, previewUpdated)
  state spacingProperty = ""
  state spacingValue = ""
  state designSession = ""
  state hoveredElement = ""
  action hoverElement(id: string, on: bool)
    if editing and (on or hoveredElement == id)
      let next = on ? id : ""
      hoveredElement = next
      send hoverChanged = design("hover", designSession, "", 0, next, "")
  state collapsedElements = [""]
  state revealedLayerRevision = -1
  action revealSelectedLayer
    match designChanged
      case some(r)
        collapsedElements = collapsedElements.filter(id => not r.crumbs.map(c => c.id).includes(id))
        match first(r.tree.filter(e => e.selected))
          case some(selected)
            scrollIntoView(`layer-row-${selected.id}`, block="nearest", inline="nearest", behavior="instant")
          case none
            hand = hand
        revealedLayerRevision = r.selectionRevision
      case none
        hand = hand
  task revealLayerPanel when editing and leftOpen
    after(1, revealSelectedLayer)
  action toggleElement(id: string)
    collapsedElements = collapsedElements.includes(id) ? collapsedElements.filter(value => value != id) : collapsedElements.concat([id])
  state designOrigin = ""
  state designWriting = false
  state designVersion = 0
  derive editing = designSession != ""
  derive selectingElement = match designChanged { case some(r) => r.selecting, case none => false }
  derive designRows = match designChanged { case some(r) => r.rows, case none => [] }
  derive elementTree = match designChanged { case some(r) => r.tree, case none => [] }
  derive appCanUndo = match designChanged { case some(r) => r.canUndo, case none => false }
  state designError = ""
  action startEditing
    collapsedElements = [""]
    revealedLayerRevision = -1
    previewUpdateSeen = -1
    designWriting = true
    rightPanel = "open"
    send designChanged = design("open", "", doc.source, 0, doc.active, "")
  action finishEditing
    spacingProperty = ""
    hoveredElement = ""
    designWriting = true
    send designChanged = design("close", designSession, "", 0, "", "")
    designSession = ""
  action toggleEditing
    if editing
      finishEditing()
    else
      startEditing()
  action pollDesign
    if not pending(designChanged)
      send designChanged = design("poll", designSession, "", 0, "", "")
  task designPoll when editing and not selectingElement
    every(750, pollDesign)
  task selectionPoll when editing and selectingElement
    every(50, pollDesign)
  action editDesign(row: string, value: string)
    designWriting = true
    send designChanged = design("edit", designSession, "", designVersion, row, value)
  action editSpacing(value: string)
    spacingValue = value
  action openSpacing(property: string, value: string)
    spacingProperty = property
    spacingValue = value
    selectText("spacing-value")
  action cancelSpacing
    spacingProperty = ""
  action spacingKey(key: string)
    if key == "Escape"
      preventDefault()
      spacingProperty = ""
    if key == "Enter"
      preventDefault()
      designWriting = true
      send designChanged = design("spacing", designSession, "", designVersion, spacingProperty, spacingValue)
      spacingProperty = ""
  action undoDesign
    designWriting = true
    send designChanged = design("undo", designSession, "", 0, "", "")
  action applyDesign
    designWriting = true
    send designChanged = design("apply", designSession, "", 0, "", "")
  action discardDesign
    designWriting = true
    send designChanged = design("discard", designSession, "", 0, "", "")
  action selectParent
    send designChanged = design("parent", designSession, "", 0, "", "")
  action selectElement(id: string)
    send designChanged = design("select", designSession, "", designVersion, id, "")
  action afterDesign
    designWriting = false
    match designChanged
      case some(r)
        if r.error != ""
          designError = r.error
        if r.ok
          if leftOpen and r.selectionRevision != revealedLayerRevision
            revealSelectedLayer()
          if r.version != designVersion or r.session == ""
            spacingProperty = ""
            designError = ""
          if r.origin != ""
            designOrigin = r.origin
            refresh doc
          designSession = r.session
          designVersion = r.version
      case none
        hand = hand
  state collapsed = [""] persist
  state addingViewport = false
  action toggleViewportMenu
    addingViewport = not addingViewport
  action addViewport(preset: string)
    addingViewport = false
    command("variant", preset)
  state projectName = ""
  state projectUrl = ""
  state projectNameChanged = false
  state projectUrlChanged = false
  derive projectNameValue = projectNameChanged ? projectName : doc.projectName
  derive projectUrlValue = projectUrlChanged ? projectUrl : doc.projectUrl
  state screenName = ""
  state screenPath = "/"
  state screenPreset = "Phone"
  state screenKind = "blank"
  derive libraryError = match libraryChanged { case some(r) => r.error, case none => "" }
  action follow(url: string)
    nav = go(nav, url)
  action closeLibrary
    nav = back(nav)
  action projectSettings
    projectNameChanged = false
    projectUrlChanged = false
    libraryChanged = none
    nav = go(nav, path("project"))
  action addScreen
    screenName = ""
    screenPath = "/"
    screenPreset = "Phone"
    screenKind = doc.projectUrl == "" ? "blank" : "add"
    libraryChanged = none
    nav = go(nav, path("addScreen"))
  action projectNameInput(value: string)
    projectName = value
    projectNameChanged = true
  action projectUrlInput(value: string)
    projectUrl = value
    projectUrlChanged = true
  action screenNameInput(value: string)
    screenName = value
  action screenPathInput(value: string)
    screenPath = value
  action choosePreset(value: string)
    screenPreset = value
  action chooseKind(value: string)
    screenKind = value
  action refreshDiscovery
    discoveryRevision = discoveryRevision + 1
  action chooseScreen(name: string, route: string)
    screenName = name
    screenPath = route
    libraryChanged = none
  action saveProject
    send libraryChanged = library("connect", projectNameValue, projectUrlValue, "")
  action disconnectProject
    send libraryChanged = library("disconnect", "", "", "")
  action saveScreen
    send libraryChanged = library(screenKind, screenName, screenPath, screenPreset)
  action toggleGroup(id: string)
    collapsed = collapsed.includes(id) ? collapsed.filter(value => value != id) : collapsed.concat([id])
  state fitWhenReady = false
  state fittedSignature = ""
  action finishLoadFit
    fitWhenReady = false
  task stopLoadFit when fitWhenReady
    after(2000, finishLoadFit)
  action fitLoadedScreens
    fittedSignature = previews.signature
    resetView()
  task fitLoaded when fitWhenReady and fittedSignature != previews.signature and previews.ready and previews.requests == doc.previewRequests and not pending(doc) and not pending(renderedScene)
    after(1, fitLoadedScreens)
  action afterLibrary
    match libraryChanged
      case some(r)
        if r.ok
          if top(nav).name != "editor"
            nav = back(nav)
          if r.fit
            fitWhenReady = true
            fittedSignature = ""
            collapsed = [""]
            fitBounds(r.minX, r.minY, r.maxX, r.maxY)
      case none
        hand = hand
  state leftPanel = "auto" persist
  state rightPanel = "auto" persist
  derive leftOpen = (leftPanel == "open" or (leftPanel == "auto" and viewport.width >= 1000)) and (viewport.width >= 700 or rightPanel != "open")
  derive rightOpen = rightPanel == "open" or (rightPanel == "auto" and viewport.width >= 700)
  derive panelOverlay = (leftOpen and viewport.width < 1000) or (rightOpen and viewport.width < 700)
  state zoom = 0.85 persist
  state px = 64 persist
  state py = 80 persist
  state panning = false
  state panFromX = 0
  state panFromY = 0
  state panStarted = 0
  state panProgress = 1
  derive cameraX = panning ? panFromX + (px - panFromX) * panEase(panProgress) : px
  derive cameraY = panning ? panFromY + (py - panFromY) * panEase(panProgress) : py
  derive canvasWidth = viewport.width - (leftOpen and viewport.width >= 1000 ? 208 : 0) - (rightOpen and viewport.width >= 700 ? 232 : 0)
  derive canvasCenterX = ((leftOpen and viewport.width < 1000 ? 208 : 0) + canvasWidth - (rightOpen and viewport.width < 700 ? 232 : 0)) / 2
  action advancePan
    let next = viewport.prefersReducedMotion ? 1 : min(1, max(0, (performanceNow() - panStarted) / 280))
    panProgress = next
    if next >= 1
      panning = false
  task panFrames when panning
    every(16, advancePan)
  action cancelPan
    let x = cameraX
    let y = cameraY
    panning = false
    px = x
    py = y
  state dragging = false
  state hand = false
  state sx = 0
  state sy = 0
  state dx = 0
  state dy = 0
  state codeOpen = false
  state preview = false
  state clicks = 0
  state freeDrag = false
  derive snapping = dragging and doc.frameSelected and not doc.resizing and not hand and not freeDrag and (dx != 0 or dy != 0)
  derive dragX = snapping ? snappedDelta(scene.snapX, scene.frameX, dx, zoom) : dx
  derive dragY = snapping ? snappedDelta(scene.snapY, scene.frameY, dy, zoom) : dy
  action toggleLeft
    cancelPan()
    leftPanel = leftOpen ? "closed" : "open"
    if viewport.width >= 1000
      px = cameraX + (leftOpen ? 208 : -208)
    else
      if not leftOpen and viewport.width < 700
        rightPanel = "closed"
  action toggleRight
    cancelPan()
    rightPanel = rightOpen ? "closed" : "open"
    if not rightOpen and viewport.width < 700
      leftPanel = "closed"
  action command(op: string, key: string)
    if editing and op == "undo"
      undoDesign()
    else
      if not editing or op == "save"
        send changed = edit(op, key, "", 0, 0)
  action prop(key: string, value: string)
    send changed = edit("property", key, value, 0, 0)
  action down(e: PointerEvent)
    cancelPan()
    fitWhenReady = false
    if e.button == 0
      freeDrag = e.altKey
      dragging = true
      sx = e.offsetX
      sy = e.offsetY
      dx = 0
      dy = 0
      if not hand
        send changed = edit("hit", "", `${zoom}`, (e.offsetX - cameraX) / zoom, (e.offsetY - cameraY) / zoom)
  action move(e: PointerEvent)
    if dragging
      freeDrag = e.altKey
      dx = (e.offsetX - sx) / zoom
      dy = (e.offsetY - sy) / zoom
  action up(e: PointerEvent)
    if dragging
      if hand
        px = px + e.offsetX - sx
        py = py + e.offsetY - sy
      else
        send changed = edit("move", (e.altKey ? "free" : "snap"), `${zoom}`, (e.offsetX - sx) / zoom, (e.offsetY - sy) / zoom)
      dragging = false
      dx = 0
      dy = 0
  action wheel(e: WheelEvent)
    cancelPan()
    fitWhenReady = false
    preventDefault()
    if e.ctrlKey or e.metaKey
      let z = min(3, max(0.01, zoom * (1 - e.deltaY * 0.005)))
      let old = zoom
      zoom = z
      px = e.offsetX - (e.offsetX - cameraX) * z / old
      py = e.offsetY - (e.offsetY - cameraY) * z / old
    else
      px = cameraX - e.deltaX
      py = cameraY - e.deltaY
  action zoomIn
    cancelPan()
    zoom = min(3, zoom + 0.1)
  action zoomOut
    cancelPan()
    zoom = max(0.01, zoom - 0.1)
  action fitBounds(x: number, y: number, right: number, bottom: number)
    cancelPan()
    let available = viewport.width - ((leftOpen and viewport.width >= 1000 ? 208 : 0) + (rightOpen and viewport.width >= 700 ? 232 : 0)) - 96
    let z = min(1, max(0.01, min(available / max(1, right - x), (viewport.height - 220) / max(1, bottom - y))))
    zoom = z
    px = 48 - x * z
    py = 64 - y * z
  action resetView
    fitBounds(scene.minX, scene.minY, scene.maxX, scene.maxY)
  action afterEdit
    match changed
      case some(r)
        if r.fit
          fitWhenReady = true
          fittedSignature = ""
          fitBounds(r.minX, r.minY, r.maxX, r.maxY)
      case none
        hand = hand
  action focusView(id: string, x: number, y: number, w: number, h: number)
    fitWhenReady = false
    addingViewport = false
    send changed = edit("select", id, "", 0, 0)
    let fromX = cameraX
    let fromY = cameraY
    panFromX = fromX
    panFromY = fromY
    let targetX = canvasCenterX - (x + w / 2) * zoom
    let targetY = (viewport.height - 48) / 2 - (y + h / 2) * zoom
    px = targetX
    py = targetY
    panStarted = performanceNow()
    panProgress = 0
    panning = not viewport.prefersReducedMotion and (magnitude(targetX - fromX) > 0.5 or magnitude(targetY - fromY) > 0.5)
  action focusScreen(id: string)
    match first(scene.groups.filter(g => g.id == id))
      case some(group)
        match first(group.views.filter(v => v.id == doc.active))
          case some(v)
            focusView(v.id, v.x, v.y, v.width, v.height)
          case none
            match first(group.views)
              case some(v)
                focusView(v.id, v.x, v.y, v.width, v.height)
              case none
                hand = hand
      case none
        hand = hand
  action selectTool
    hand = false
  action handTool
    hand = true
  action toggleCode
    codeOpen = not codeOpen
  action copyCode
    copyText(doc.code)
  action togglePreview
    preview = not preview
    clicks = 0
  action previewClick
    clicks = clicks + 1
  view
    main navigationKey=`${top(nav).id}` navigationBack="closeLibrary" navigate=follow testId="editor" width="100%" height="100%" display="flex" flex-direction="column" background-color="ink.inverse" color="ink.primary" font-family="system-ui" font-size=12
      for entry in stack(nav) key=entry.id
        if entry.name == "editor"
          column navigationKey=`${entry.id}` position="absolute" inset=0
            row height=48 flex-shrink=0 align-items="center" padding-left=12 padding-right=12 gap=6 border-bottom-width=1 border-bottom-style="solid" border-bottom-color="line.subtle"
              button press=toggleLeft class=Tool aria-label=(leftOpen ? "Hide screens" : "Show screens") aria-pressed=leftOpen title="Screens" testId="toggle-screens"
                image "symbol:icon.panel-left"
              image "symbol:layers" aria-hidden=true color="ink.primary"
              if viewport.width >= 700
                text "Exact Design" font-weight=600 font-size=12
                text "/" color="ink.muted"
              text (doc.projectName == "" ? doc.name : doc.projectName) testId="document-name" min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
              row flex=1
              if doc.status != ""
                text doc.status color="ink.secondary" testId="save-status"
              button press=command("save", "") aria-keyshortcuts="Meta+s Control+s" class=Tool aria-label="Save" title="Save" testId="save"
                image "symbol:download"
              button press=command("undo", "") aria-keyshortcuts="Meta+z Control+z" class=Tool display=(viewport.width >= 700 ? "flex" : "none") disabled=(editing ? not appCanUndo : not doc.canUndo) aria-label="Undo" title="Undo" testId="undo"
                image "symbol:back"
              button press=command("redo", "") aria-keyshortcuts="Meta+Shift+z Control+Shift+z" class=Tool display=(viewport.width >= 700 ? "flex" : "none") disabled=(editing or not doc.canRedo) aria-label="Redo" title="Redo" testId="redo"
                image "symbol:forward-chevron"
              button press=togglePreview disabled=editing class=Tool aria-label="Preview" title="Preview" testId="preview"
                image "symbol:play"
              button press=toggleCode disabled=(doc.source != "") height=30 border-width=0 border-radius=6 background-color="surface.action" color="ink.inverse" padding-left=12 padding-right=12 testId="export"
                text "Export" font-size=12
              column width=1 height=20 background-color="line.subtle" margin-left=4 margin-right=4
              button press=toggleRight class=Tool aria-label=(rightOpen ? "Hide inspector" : "Show inspector") aria-pressed=rightOpen title="Inspector" testId="toggle-inspector"
                image "symbol:icon.panel-right"
            row flex=1 min-height=0 position="relative"
              if leftOpen
                column testId="screens-panel" position=(viewport.width >= 1000 ? "relative" : "absolute") left=0 top=0 bottom=0 z-index=3 background-color="surface.panel" width=208 flex-shrink=0 border-right-width=1 border-right-style="solid" border-right-color="line.subtle" padding-top=12 gap=8
                  if editing
                    row padding-left=16 padding-right=8 height=32 align-items="center"
                      text "Layers" font-weight=600
                    scroll flex=1 min-height=0 testId="element-tree"
                      column padding-left=8 padding-right=8 gap=2
                        for element, i in elementTree key=element.id
                          if element.ancestors.filter(id => collapsedElements.includes(id)).length == 0
                            row id=`layer-row-${element.id}` hover=hoverElement(element.id) align-items="center" padding-left=(min(element.depth, 8) * 10) background-color=(element.selected ? "surface.selected" : "transparent") border-radius=5
                              if element.hasChildren
                                button press=toggleElement(element.id) class=Tool width=20 height=28 padding=3 aria-label=`Toggle ${element.label}` aria-expanded=(not collapsedElements.includes(element.id)) testId=`fold-element-${i}`
                                  image "symbol:icon.disclosure" width=10 height=10 rotate=(collapsedElements.includes(element.id) ? 0 : 90)
                              else
                                column width=20 flex-shrink=0
                              button press=selectElement(element.id) testId=`element-${i}` aria-label=(element.label == layerKind(element.kind) ? element.label : `${layerKind(element.kind)}: ${element.label}`) title=element.label aria-pressed=element.selected display="flex" flex=1 min-width=0 align-items="center" gap=6 height=28 padding=0 padding-right=8 border-width=0 background-color="transparent" color=(element.selected ? "ink.selected" : "ink.secondary")
                                ElementIcon(kind=element.kind)
                                text element.label font-size=11 text-align="left" min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
                  else
                    button press=projectSettings display="flex" align-items="center" gap=8 margin-left=8 margin-right=8 padding=8 border-width=0 border-radius=6 background-color="surface.field" color="ink.primary" aria-label="Project connection" testId="project-connection"
                      image "symbol:link" aria-hidden=true
                      text (doc.projectName == "" ? "Connect project" : doc.projectName) font-size=12 flex=1 min-width=0 text-align="left" overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
                      image "symbol:adjust" aria-hidden=true color="ink.muted"
                    row padding-left=16 padding-right=8 align-items="center"
                      text "Screens" font-weight=600 flex=1
                      button press=addScreen class=Tool aria-label="Add screen" testId="add-screen"
                        image "symbol:add"
                    scroll flex=1 min-height=0
                      column gap=6 padding-left=8 padding-right=8
                        for group in scene.groups key=group.id
                          column gap=2
                            row align-items="center" gap=2 height=32
                              button press=toggleGroup(group.id) testId=`fold-group-${group.id}` class=Tool width=20 height=28 padding=4 aria-label=`Toggle ${group.name}` aria-expanded=(not collapsed.includes(group.id))
                                image "symbol:icon.disclosure" width=12 height=12 rotate=(collapsed.includes(group.id) ? 0 : 90) aria-hidden=true
                              button press=focusScreen(group.id) testId=`group-${group.id}` aria-label=group.name title="Center screen" display="flex" flex=1 min-width=0 align-items="center" height=32 padding=0 padding-right=8 border-width=0 border-radius=5 background-color="transparent" color="ink.primary"
                                text group.name font-size=12 font-weight=500 flex=1 min-width=0 text-align="left" overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
                            if not collapsed.includes(group.id)
                              for v in group.views key=v.id
                                button press=focusView(v.id, v.x, v.y, v.width, v.height) testId=`view-${v.id}` aria-label=`${group.name}, ${v.name}` display="flex" align-items="center" gap=6 height=30 padding-left=22 padding-right=8 border-width=0 border-radius=5 background-color=(doc.active == v.id ? "surface.selected" : "transparent") color=(doc.active == v.id ? "ink.selected" : "ink.secondary")
                                  text v.name font-size=11 flex=1 text-align="left"
                                  text `${v.width} × ${v.height}` font-size=10
                              for n in group.layers key=n.id
                                button press=command("select", n.id) testId=`layer-${n.id}` aria-label=n.name display="flex" align-items="center" gap=8 height=30 padding-left=28 padding-right=8 border-width=0 border-radius=5 background-color=(doc.selected == n.id ? "surface.selected" : "transparent") color=(doc.selected == n.id ? "ink.selected" : "ink.secondary")
                                  image (n.kind == "text" ? "symbol:compose" : n.kind == "button" ? "symbol:select" : "symbol:stop") aria-hidden=true
                                  text n.name font-size=12

              column flex=1 min-width=0 min-height=0 position="relative" overflow="hidden" background-color="surface.canvas"
                for v in scene.views key=v.id
                  column position="absolute" left=((hand ? cameraX + dx * zoom : cameraX) + (v.x + (not hand and doc.frameSelected and doc.active == v.id and not doc.resizing ? dragX : 0)) * zoom) top=((hand ? cameraY + dy * zoom : cameraY) + (v.y + (not hand and doc.frameSelected and doc.active == v.id and not doc.resizing ? dragY : 0)) * zoom) width=max(100, v.width + (not hand and doc.frameSelected and doc.active == v.id and doc.resizing ? dragX : 0)) height=max(100, v.height + (not hand and doc.frameSelected and doc.active == v.id and doc.resizing ? dragY : 0)) scale=zoom transform-origin="top left" pointer-events=(editing and v.source.startsWith(designOrigin + "/") ? "auto" : "none") inert=(not editing or not v.source.startsWith(designOrigin + "/")) background-color="paper" border="none" box-shadow="none" testId=`frame-${v.id}`
                    ScreenView(source=v.previewSource, layers=v.layers, prefix=v.id, selected=(doc.screenId == v.screenId and not doc.frameSelected ? doc.selected : ""), dx=(hand ? 0 : dragX), dy=(hand ? 0 : dragY), resizing=doc.resizing, activate=previewClick)
                canvas pointer-events=(editing ? "none" : "auto") surface=design(scene.drawing, doc.selected, zoom, (hand ? cameraX + dx * zoom : cameraX), (hand ? cameraY + dy * zoom : cameraY), (hand ? 0 : dragX), (hand ? 0 : dragY), doc.resizing, snapping) position="relative" flex=1 width="100%" min-height=0 pointerdown=down pointermove=move pointerup=up wheel=wheel cursor=(hand ? (dragging ? "grabbing" : "grab") : (dragging ? (doc.resizing ? "nwse-resize" : "move") : "default")) touch-action="none" testId="canvas" aria-label="Design canvas"
                if editing and not designWriting
                  match designChanged
                    case some(result)
                      match spacingMeasured
                        case some(measured)
                          if measured.id != "" and measured.id == result.spacingId and measured.plan == result.spacingPlan and measured.frame == result.spacingFrame
                            for v in scene.views.filter(v => v.id == measured.frame) key=v.id
                              column position="absolute" inset=0 pointer-events="none" testId="spacing-overlay"
                                for box in measured.boxes key=box.key
                                  column position="absolute" left=(cameraX + (v.x + box.x) * zoom) top=(cameraY + (v.y + box.y) * zoom) width=(box.width * zoom) height=(box.height * zoom) background-color="spacing.wash" border="1px solid spacing.edge" box-sizing="border-box" aria-hidden=true
                                  if box.label and max(box.width, box.height) * zoom >= 32
                                    for targets in [result.spacingInputs.filter(p => p.property == box.property)] key=box.property
                                      if targets.length == 0
                                        text box.value position="absolute" left=(cameraX + (v.x + box.labelX) * zoom) top=(cameraY + (v.y + box.labelY) * zoom) translate="-50% -50%" font-size=10 font-weight=500 color="spacing.ink" background-color="surface.panel" padding=3 border-radius=4 pointer-events="auto" title=`${spacingName(box.property)} · Computed` testId=`spacing-readonly-${box.property}`
                                      else
                                        for target in targets key=target.property
                                          if spacingProperty == target.property
                                            input id="spacing-value" value=spacingValue input=editSpacing key=spacingKey blur=cancelSpacing position="absolute" left=(cameraX + (v.x + box.labelX) * zoom) top=(cameraY + (v.y + box.labelY) * zoom) translate="-50% -50%" width=72 height=26 padding=4 box-sizing="border-box" border="1px solid spacing.ink" border-radius=5 background-color="surface.panel" color="ink.primary" font-size=11 text-align="center" pointer-events="auto" aria-label=spacingName(box.property) title="Enter to apply · Escape to cancel" testId="spacing-value"
                                          else
                                            button press=openSpacing(target.property, target.value) position="absolute" left=(cameraX + (v.x + box.labelX) * zoom) top=(cameraY + (v.y + box.labelY) * zoom) translate="-50% -50%" display="flex" align-items="center" justify-content="center" box-sizing="border-box" min-width=24 height=20 min-height=20 padding=3 border="1px solid spacing.edge" border-radius=4 background-color="surface.panel" color="spacing.ink" font-size=10 font-weight=600 pointer-events="auto" aria-label=`Edit ${spacingName(box.property)}` title=(target.shared ? `${spacingName(box.property)} · Shared style` : spacingName(box.property)) testId=`spacing-${box.property}`
                                              text box.value
                        case none
                          column display="none"
                    case none
                      column display="none"
                row display=(panelOverlay or editing ? "none" : "flex") position="absolute" bottom=20 left="50%" translate="-50% 0" padding=6 gap=4 align-items="center" border="1px solid line.subtle" background-color="ink.inverse" border-radius=10 box-shadow="0 2px 12px #00000012"
                  button press=selectTool aria-keyshortcuts="v" class=Tool background-color=(not hand ? "surface.selected" : "transparent") aria-label="Select" title="Select (V). Hold Alt to ignore snapping." testId="select-tool"
                    image "symbol:icon.pointer"
                  button press=handTool aria-keyshortcuts="h" class=Tool background-color=(hand ? "surface.selected" : "transparent") aria-label="Pan" title="Pan" testId="hand-tool"
                    image "symbol:icon.pan"
                  column width=1 height=20 background-color="line.subtle" margin-left=2 margin-right=2
                  button press=addScreen class=Tool aria-label="New screen" title="New screen" testId="new-screen"
                    image "symbol:document"
                  button press=command("add", "rectangle") disabled=(doc.source != "") class=Tool aria-label="Rectangle" title="Rectangle" testId="add-rectangle"
                    image "symbol:stop"
                  button press=command("add", "text") disabled=(doc.source != "") class=Tool aria-label="Text" title="Text" testId="add-text"
                    image "symbol:compose"
                  button press=command("add", "button") disabled=(doc.source != "") class=Tool aria-label="Button" title="Button" testId="add-button"
                    image "symbol:add"
                row display=(panelOverlay ? "none" : "flex") position="absolute" right=16 bottom=(viewport.width >= 1000 ? 24 : 82) align-items="center" gap=4 background-color="ink.inverse" border-radius=8 padding=2 border="1px solid line.subtle"
                  button press=zoomOut class=Tool aria-label="Zoom out" title="Zoom out" testId="zoom-out"
                    image "symbol:minus"
                  button press=resetView class=Tool width=48 aria-label="Fit all screens" title="Fit all screens" testId="zoom"
                    text `${round(zoom * 100)}%` font-size=11 font-variant-numeric="tabular-nums"
                  button press=zoomIn class=Tool aria-label="Zoom in" title="Zoom in" testId="zoom-in"
                    image "symbol:add"
              if rightOpen
                scroll testId="inspector-panel" position=(viewport.width >= 700 ? "relative" : "absolute") right=0 top=0 bottom=0 z-index=3 background-color="surface.panel" width=232 flex-shrink=0 border-left-width=1 border-left-style="solid" border-left-color="line.subtle"
                  column padding=16 gap=20
                    if doc.source != "" or editing
                      button press=toggleEditing disabled=designWriting class=Tool width="100%" background-color=(editing ? "surface.selected" : "surface.field") aria-label=(editing ? "Finish editing app" : "Edit app design") testId="edit-app"
                        text (editing ? "Done editing" : "Edit app") font-size=12
                    if designError != ""
                      text designError role="alert" font-size=12 color="ink.secondary" testId="design-error"
                    if editing
                      column gap=12
                        match designChanged
                          case some(result)
                            if result.draftCount > 0
                              column gap=8
                                row align-items="center" justify-content="space-between"
                                  text `${result.draftCount} unsaved ${result.draftCount == 1 ? "change" : "changes"}` font-size=11 color="ink.secondary" testId="draft-count"
                                  button press=discardDesign class=Tool height=26 padding=4 disabled=pending(designChanged) testId="discard-design"
                                    text "Discard" font-size=11
                                button press=applyDesign class=Tool background-color="surface.selected" width="100%" disabled=(not result.canApply or pending(designChanged)) testId="apply-design"
                                  text "Apply to code" font-size=12
                                if result.draftError != ""
                                  text result.draftError role="alert" font-size=11 color="ink.secondary" testId="draft-error"
                            for selected in result.crumbs.filter(c => c.selected) key=selected.id
                              column gap=10
                                for parent in result.crumbs.filter(c => c.depth == selected.depth - 1) key=parent.id
                                  button press=selectElement(parent.id) class=Tool width="100%" height=26 padding=0 gap=6 justify-content="flex-start" aria-label=`Select parent: ${parent.label}` title=`Select parent: ${parent.label}` testId="element-parent" color="ink.secondary"
                                    image "symbol:icon.disclosure" rotate=-90 width=10 height=10 aria-hidden=true
                                    text parent.label font-size=11 overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
                                row align-items="flex-start" gap=8
                                  column padding-top=2 color="ink.secondary"
                                    ElementIcon(kind=selected.kind)
                                  text selected.label font-size=13 font-weight=600 flex=1 min-width=0 hyphens="auto" testId="selected-element-name"
                                row gap=8 align-items="center"
                                  if selected.label != layerKind(selected.kind)
                                    text layerKind(selected.kind) font-size=11 color="ink.secondary" testId="selected-element-kind"
                                  if result.source != ""
                                    text result.source font-size=11 color="ink.muted" overflow="hidden" white-space="nowrap" text-overflow="ellipsis" min-width=0 title=result.source testId="design-source"
                            if result.source != ""
                              if result.crumbs.length == 0
                                button press=selectParent class=Tool width="100%" justify-content="flex-start" testId="design-parent"
                                  text "Select component" font-size=12
                            if result.rows.length == 0
                              text (result.restoring ? result.message : result.applied ? "Applied to source." : result.message) font-size=12 color="ink.secondary" testId="design-message"
                            if result.canUndo
                              button press=undoDesign disabled=pending(designChanged) class=Tool width="100%" justify-content="flex-start" testId="undo-app-design"
                                text "Undo draft change" font-size=12
                          case none
                            text "Select an element in a screen." font-size=12
                        if designRows.filter(p => p.shared).length > 0
                          text "Shared style · updates every use" font-size=11 color="ink.secondary"
                        for group in ["Layout", "Spacing", "Appearance"] key=group
                          if designRows.filter(p => p.group == group).length > 0
                            column gap=12
                              text group font-weight=600 font-size=12
                              for property in designRows.filter(p => p.group == group) key=`${designVersion}-${property.id}`
                                column gap=6
                                  text property.name font-size=11 color="ink.secondary"
                                  if property.options.length > 0
                                    select value=property.value change=editDesign(property.id) class=Field aria-label=property.name testId=`design-property-${property.id}` disabled=designWriting
                                      for choice in property.options key=choice.value
                                        option choice.label value=choice.value
                                  else
                                    input value=property.value change=editDesign(property.id) class=Field aria-label=property.name testId=`design-property-${property.id}` disabled=designWriting
                    if not editing
                      row align-items="center"
                        text (doc.frameSelected ? "Screen" : "Design") font-weight=600 flex=1
                        if doc.selected != "" and not doc.frameSelected
                          button press=command("delete", "") class=Tool aria-label="Delete selection" testId="delete"
                            image "symbol:delete"
                      if doc.selected == ""
                        text "Select a screen or layer" color="ink.secondary"
                      if doc.frameSelected
                        for v in scene.views.filter(v => v.id == doc.active) key=v.id
                          column gap=20
                            column gap=6
                              text "Name" color="ink.secondary" font-size=11
                              input value=v.screenName change=prop("name") class=Field aria-label="Screen name" testId="screen-name"
                            column gap=6
                              text (doc.route != "" ? "Route" : "Preview URL") color="ink.secondary" font-size=11
                              if doc.route != ""
                                input value=doc.route change=prop("route") class=Field placeholder="/settings" aria-label="Screen route" testId="screen-route"
                              else
                                input value=v.source change=prop("source") class=Field placeholder="https://…" aria-label="Preview URL" testId="preview-url"
                            column height=1 background-color="line.subtle"
                            column gap=12
                              row align-items="center"
                                text "Viewport" font-weight=600 flex=1
                                button press=command("delete", "") class=Tool aria-label="Delete viewport" title="Delete viewport" testId="delete" disabled=(doc.views.length == 1)
                                  image "symbol:delete"
                              select value=v.name change=prop("preset") class=Field aria-label="Viewport preset" testId="viewport-preset"
                                if v.name == "Custom"
                                  option "Custom" value="Custom" disabled=true
                                option "Phone" value="Phone"
                                option "Tablet" value="Tablet"
                                option "Desktop" value="Desktop"
                              row gap=8
                                column flex=1 min-width=0 gap=6
                                  text "Width" color="ink.secondary" font-size=11
                                  input value=`${v.width}` change=prop("width") class=Field aria-label="Viewport width" testId="frame-width"
                                column flex=1 min-width=0 gap=6
                                  row align-items="center" justify-content="space-between" height=14
                                    text "Height" color="ink.secondary" font-size=11
                                    if v.canAutoHeight
                                      button press=prop("heightMode", "content") class=Tool height=18 min-height=18 padding=0 color=(v.autoHeight ? "ink.selected" : "ink.secondary") aria-label="Fit screen height to content" aria-pressed=v.autoHeight title="Fit height to content" testId="auto-height"
                                        text "Auto" font-size=10
                                  input value=`${v.height}` change=prop("height") class=Field aria-label="Viewport height" testId="frame-height"
                            column gap=4
                              button press=toggleViewportMenu class=Tool width="100%" justify-content="flex-start" gap=8 aria-expanded=addingViewport aria-label="Add viewport" testId="add-viewport"
                                image "symbol:add"
                                text "Add viewport" font-size=12
                              if addingViewport
                                for preset in ["Phone", "Tablet", "Desktop"] key=preset
                                  button press=addViewport(preset) class=Tool width="100%" justify-content="flex-start" padding-left=28 aria-label=`Add ${preset} viewport` testId=`variant-${preset.toLowerCase()}`
                                    text preset font-size=12
                            column height=1 background-color="line.subtle"
                            button press=command("duplicate", "") class=Tool width="100%" justify-content="flex-start" gap=8 aria-label="Duplicate screen" testId="duplicate-screen"
                              image "symbol:document"
                              text "Duplicate screen" font-size=12
                      for n in doc.layers.filter(n => n.id == doc.selected) key=n.id
                        column gap=18
                          input value=n.name change=prop("name") class=Field aria-label="Layer name" testId="name"
                          column gap=10
                            text "Layout" font-weight=500
                            row gap=8
                              column flex=1 min-width=0 gap=5
                                text "X" color="ink.muted" font-size=11
                                input value=`${n.x}` change=prop("x") class=Field aria-label="X position" testId="x"
                              column flex=1 min-width=0 gap=5
                                text "Y" color="ink.muted" font-size=11
                                input value=`${n.y}` change=prop("y") class=Field aria-label="Y position" testId="y"
                            row gap=8
                              column flex=1 min-width=0 gap=5
                                text "W" color="ink.muted" font-size=11
                                input value=`${n.width}` change=prop("width") class=Field aria-label="Width" testId="width"
                              column flex=1 min-width=0 gap=5
                                text "H" color="ink.muted" font-size=11
                                input value=`${n.height}` change=prop("height") class=Field aria-label="Height" testId="height"
                          row gap=4 background-color="surface.field" border-radius=6 padding=3
                            button press=prop("widthMode", "fixed") class=Tool flex=1 width="auto" height=24 color="ink.primary" background-color=(n.widthMode == "fixed" ? "ink.inverse" : "transparent") aria-label="Fixed width" testId="width-fixed"
                              text "Fixed" font-size=11
                            button press=prop("widthMode", "fill") class=Tool flex=1 width="auto" height=24 color="ink.primary" background-color=(n.widthMode == "fill" ? "ink.inverse" : "transparent") aria-label="Fill width" testId="width-fill"
                              text "Fill" font-size=11
                          column gap=10
                            text "Fill" font-weight=500
                            row gap=8 align-items="center"
                              column width=24 height=24 border-radius=4 background-color=n.fill
                              input value=n.fill change=prop("fill") class=Field flex=1 min-width=0 aria-label="Fill color" testId="fill"
                          if n.kind != "text"
                            column gap=8
                              text "Corner radius" font-weight=500
                              input value=`${n.radius}` change=prop("radius") class=Field aria-label="Corner radius" testId="radius"
                          if n.kind != "rectangle"
                            column gap=10
                              text "Text" font-weight=500
                              input value=n.text change=prop("text") class=Field aria-label="Text content" testId="text-content"
                              input value=`${n.fontSize}` change=prop("fontSize") class=Field aria-label="Font size" testId="font-size"
            if codeOpen
              column position="absolute" inset=0 background-color="surface.scrim" align-items="center" justify-content="center"
                column width=680 max-width="90%" height=520 max-height="85%" padding=20 gap=16 border-radius=12 background-color="ink.inverse"
                  row align-items="center" gap=12
                    text "Contract" font-weight=600 flex=1
                    button press=copyCode class=Tool width=60 aria-label="Copy Contract" testId="copy-code"
                      text "Copy"
                    button press=toggleCode class=Tool aria-label="Close export" testId="close-export"
                      image "symbol:close"
                  textarea value=doc.code readonly=true flex=1 width="100%" min-height=0 font-family="monospace" font-size=12 border-width=0 background-color="surface.field" padding=12 box-sizing="border-box" aria-label="Contract source" testId="code"
            if preview
              column position="absolute" inset=0 background-color="surface.canvas" align-items="center" justify-content="center" gap=20
                row width="90%" max-width=720 align-items="center"
                  text doc.screenName flex=1
                  if clicks > 0
                    text `Clicked ${clicks}` testId="preview-clicks"
                  button press=togglePreview disabled=editing class=Tool aria-label="Close preview" testId="close-preview"
                    image "symbol:close"
                scroll width="100%" max-width=doc.width height=doc.height max-height="80%" overflow-x="scroll"
                  column position="relative" width=doc.width height=doc.height overflow="hidden" background-color="paper" testId="live-screen"
                    ScreenView(source=doc.source, layers=doc.layers, prefix="preview", selected="", dx=0, dy=0, resizing=false, activate=previewClick)
        if entry.name == "project" or entry.name == "addScreen"
          column navigationKey=`${entry.id}` navigationPresentation="fullscreen" position="absolute" inset=0 background-color="surface.scrim" align-items="center" justify-content="center" padding=20 box-sizing="border-box"
            column width=400 max-width="100%" max-height="100%" background-color="surface.panel" border-radius=12 padding=20 gap=20 box-sizing="border-box"
              row align-items="center" gap=12
                text (entry.name == "project" ? "Project" : "Add screen") font-weight=600 flex=1
                if entry.name == "addScreen" and screenKind == "add"
                  button press=refreshDiscovery disabled=pending(discovered) class=Tool aria-label="Refresh screens" title="Refresh screens" testId="refresh-discovery"
                    image "symbol:refresh"
                button id="closeLibrary" press=closeLibrary class=Tool aria-label="Close" testId="close-library"
                  image "symbol:close"
              if entry.name == "project"
                column gap=14
                  input value=projectNameValue input=projectNameInput class=Field placeholder="Project name" aria-label="Project name" testId="project-name"
                  input value=projectUrlValue input=projectUrlInput class=Field placeholder="http://127.0.0.1:5174" aria-label="Project URL" testId="project-url"
                if libraryError != ""
                  text libraryError role="alert" color="ink.primary" font-size=12 testId="library-error"
                row gap=8 align-items="center"
                  if doc.projectUrl != ""
                    button press=disconnectProject class=Tool width="auto" padding-left=8 padding-right=8 disabled=pending(libraryChanged) testId="disconnect-project"
                      text "Disconnect" font-size=12
                  row flex=1
                  button press=saveProject disabled=(projectNameValue.trim() == "" or projectUrlValue.trim() == "" or pending(libraryChanged)) height=32 padding-left=14 padding-right=14 border-width=0 border-radius=6 background-color="surface.action" color="ink.inverse" testId="save-project"
                    text (doc.projectUrl == "" ? "Connect" : "Save") font-size=12
              else
                if doc.projectUrl != ""
                  row gap=4 background-color="surface.field" border-radius=6 padding=3
                    button press=chooseKind("add") class=Tool width="auto" flex=1 background-color=(screenKind == "add" ? "surface.panel" : "transparent") color="ink.primary" testId="screen-project"
                      text "Project" font-size=12
                    button press=chooseKind("blank") class=Tool width="auto" flex=1 background-color=(screenKind == "blank" ? "surface.panel" : "transparent") color="ink.primary" testId="screen-blank"
                      text "Blank" font-size=12
                if screenKind == "add"
                  column gap=6
                    if pending(discovered)
                      text "Finding screens…" color="ink.secondary" font-size=12 role="status"
                    if discovered.owner == doc.projectUrl and not pending(discovered)
                      if discovered.error != ""
                        text discovered.error color="ink.secondary" font-size=12 role="status" testId="discovery-error"
                      else
                        if discovered.routes.length == 0
                          text "No screens found. Enter a route below." color="ink.secondary" font-size=12 testId="discovery-empty"
                        else
                          scroll max-height=176
                            column gap=2
                              for screen, i in discovered.routes key=screen.route
                                button press=chooseScreen(screen.name, screen.route) disabled=screen.added testId=`discovered-${i}` aria-label=`${screen.name}, ${screen.route}` display="flex" align-items="center" gap=8 padding=8 border-width=0 border-radius=6 background-color=(screenPath == screen.route and screenName == screen.name ? "surface.selected" : "transparent") color="ink.primary"
                                  column flex=1 min-width=0 gap=4 align-items="flex-start"
                                    text screen.name font-size=12
                                    text screen.route font-size=11 color="ink.secondary" text-align="left" width="100%" overflow="hidden" white-space="nowrap" text-overflow="ellipsis" title=screen.route
                                  if screen.added
                                    text "Added" font-size=11 color="ink.secondary"
                                  else
                                    if screen.dynamic
                                      text "Set path" font-size=11 color="ink.secondary"
                column gap=14
                  input value=screenName input=screenNameInput class=Field placeholder="Screen name" aria-label="Screen name" testId="new-screen-name"
                  if screenKind == "add"
                    input value=screenPath input=screenPathInput class=Field placeholder="/settings" aria-label="Route" testId="new-screen-route"
                  row gap=4
                    for preset in ["Phone", "Tablet", "Desktop"] key=preset
                      button press=choosePreset(preset) class=Tool flex=1 width="auto" color="ink.primary" background-color=(screenPreset == preset ? "surface.selected" : "transparent") testId=`new-preset-${preset}`
                        text preset font-size=12
                if libraryError != ""
                  text libraryError role="alert" color="ink.primary" font-size=12 testId="library-error"
                button press=saveScreen disabled=(screenName.trim() == "" or pending(libraryChanged)) height=32 border-width=0 border-radius=6 background-color="surface.action" color="ink.inverse" testId="create-screen"
                  text "Add screen" font-size=12

component ElementIcon
  props
    kind: string
  view
    image (kind == "text" or kind == "span" ? "symbol:icon.layer-text" : kind == "button" ? "symbol:icon.layer-button" : kind == "row" ? "symbol:icon.layer-row" : kind == "column" ? "symbol:icon.layer-column" : "symbol:stop") width=12 height=12 flex-shrink=0 aria-hidden=true

component ScreenView
  props
    source: string
    layers: Layer[]
    prefix: string
    selected: string
    dx: number
    dy: number
    resizing: bool
    activate: action
  view
    column position="relative" width="100%" height="100%" overflow="hidden" background-color="paper" font-family="system-ui"
      if source != ""
        // A new frame avoids adding preview URL changes to the editor's browser history.
        for url in [source] key=url
          iframe id=prefix src=url width="100%" height="100%" border="none" outline="none" box-shadow="none" flex-shrink=0 title="Live app preview" sandbox="allow-scripts allow-same-origin allow-forms" testId=`${prefix}-app`
      else
        for n in layers key=n.id
          ScreenLayer(n=n, prefix=prefix, selected=(selected == n.id), dx=dx, dy=dy, resizing=resizing, activate=activate)

component ScreenLayer
  props
    n: Layer
    prefix: string
    selected: bool
    dx: number
    dy: number
    resizing: bool
    activate: action
  derive x = n.x + (selected and not resizing ? dx : 0)
  derive y = n.y + (selected and not resizing ? dy : 0)
  derive w = n.widthMode == "fill" ? `max(1px, calc(100% - ${x + n.right - (selected and resizing ? dx : 0)}cameraX))` : `${max(1, n.width + (selected and resizing ? dx : 0))}cameraX`
  derive h = max(1, n.height + (selected and resizing ? dy : 0))
  view
    if n.kind == "text"
      text n.text position="absolute" left=x top=y width=w height=h color=n.fill font-size=n.fontSize line-height=1.2 white-space="pre-wrap" overflow="hidden" testId=`${prefix}-${n.id}`
    else
      if n.kind == "button"
        button press=activate position="absolute" left=x top=y width=w height=h background-color=n.fill color="paper" border-radius=n.radius border-width=0 padding=0 display="flex" align-items="center" justify-content="center" box-sizing="border-box" overflow="hidden" testId=`${prefix}-${n.id}`
          text n.text font-size=n.fontSize line-height=1.2
      else
        column position="absolute" left=x top=y width=w height=h background-color=n.fill border-radius=n.radius testId=`${prefix}-${n.id}`
