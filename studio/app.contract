                                  ElementIcon(kind=n.kind)
                                  text n.name font="type.body"

              column id="canvas-stage" outline="none" tabindex=-1 contextmenu=canvasMenu contextPopover="studio-menu" testId="canvas-stage" wheel=wheel flex=1 min-width=0 min-height=0 position="relative" overflow="clip" background-color="surface.canvas"
                for v in scene.views key=v.id
                  column position="absolute" left=((hand ? cameraX + dx * zoom : cameraX) + (v.x + (not hand and doc.frameSelected and doc.active == v.id and not doc.resizing ? dragX : 0)) * zoom) top=((hand ? cameraY + dy * zoom : cameraY) + (v.y + (not hand and doc.frameSelected and doc.active == v.id and not doc.resizing ? dragY : 0)) * zoom) width=max(100, v.width + (not hand and doc.frameSelected and doc.active == v.id and doc.resizing ? dragX : 0)) height=max(100, v.height + (not hand and doc.frameSelected and doc.active == v.id and doc.resizing ? dragY : 0)) scale=zoom transform-origin="top left" pointer-events=(editing and not hand and v.source.startsWith(designOrigin + "/") ? "auto" : "none") inert=(not editing or hand or not v.source.startsWith(designOrigin + "/")) background-color="paper" border="none" box-shadow="none" testId=`frame-${v.id}`
                    ScreenView(source=v.previewSource, layers=v.layers, prefix=v.id, selected=(doc.screenId == v.screenId and not doc.frameSelected ? doc.selected : ""), dx=(hand ? 0 : dragX), dy=(hand ? 0 : dragY), resizing=doc.resizing, activate=previewClick)
                canvas pointer-events=(editing and not hand ? "none" : "auto") surface=design(scene.drawing, doc.selected, zoom, (hand ? cameraX + dx * zoom : cameraX), (hand ? cameraY + dy * zoom : cameraY), (hand ? 0 : dragX), (hand ? 0 : dragY), doc.resizing, snapping) position="relative" flex=1 width="100%" min-height=0 pointerdown=down pointermove=move pointerup=up cursor=(hand ? (dragging ? "grabbing" : "grab") : (dragging ? (doc.resizing ? "nwse-resize" : "move") : "default")) touch-action="none" testId="canvas" aria-label="Design canvas"
                if editing and not hand and not designWriting and not panelOverlay
                  match designChanged
                    case some(result)
                      match spacingMeasured
                        case some(measured)
                          if measured.id != "" and measured.id == result.spacingId and measured.plan == result.spacingPlan and measured.frame == result.spacingFrame
                            for v in scene.views.filter(v => v.id == measured.frame) key=v.id
                              column position="absolute" inset=0 pointer-events="none" testId="spacing-overlay"
                                for box in measured.boxes key=box.key
                                  column position="absolute" left=(cameraX + (v.x + box.x) * zoom) top=(cameraY + (v.y + box.y) * zoom) width=(box.width * zoom) height=(box.height * zoom) background-color="spacing.wash" border="1px solid spacing.edge" box-sizing="border-box" aria-hidden=true
                                  if box.label and max(box.width, box.height) * zoom >= 32
                                    for targets in [result.spacingInputs.filter(p => p.property == box.property)] key=box.property
                                      if targets.length == 0
                                        text box.value position="absolute" left=(cameraX + (v.x + box.labelX) * zoom) top=(cameraY + (v.y + box.labelY) * zoom) translate="-50% -50%" font-size=10 font-weight=500 color="spacing.ink" background-color="surface.panel" padding=3 border-radius=4 pointer-events="auto" title=`${spacingName(box.property)} · Computed` testId=`spacing-readonly-${box.property}`
                                      else
                                        for target in targets key=target.property
                                          if spacingProperty == target.property
                                            input id="spacing-value" value=spacingValue input=editSpacing key=spacingKey blur=cancelSpacing position="absolute" left=(cameraX + (v.x + box.labelX) * zoom) top=(cameraY + (v.y + box.labelY) * zoom) translate="-50% -50%" width=72 height=26 padding=4 box-sizing="border-box" border="1px solid spacing.ink" border-radius=5 background-color="surface.panel" color="ink.primary" font="type.caption" text-align="center" pointer-events="auto" aria-label=spacingName(box.property) title="Enter to apply · Escape to cancel" testId="spacing-value"
                                          else
                                            button press=openSpacing(target.property, target.value) position="absolute" left=(cameraX + (v.x + box.labelX) * zoom) top=(cameraY + (v.y + box.labelY) * zoom) translate="-50% -50%" display="flex" align-items="center" justify-content="center" box-sizing="border-box" min-width=24 height=20 min-height=20 padding=3 border="1px solid spacing.edge" border-radius=4 background-color="surface.panel" color="spacing.ink" font-size=10 font-weight=600 pointer-events="auto" aria-label=`Edit ${spacingName(box.property)}` title=(target.shared ? `${spacingName(box.property)} · Shared style` : spacingName(box.property)) testId=`spacing-${box.property}`
                                              text box.value
                        case none
                          column display="none"
                    case none
                      column display="none"
                row display=(panelOverlay ? "none" : "flex") position="absolute" bottom=20 left="50%" translate="-50% 0" padding=6 gap=4 align-items="center" border="1px solid line.subtle" background-color="ink.inverse" border-radius=10 box-shadow="shadow.menu"
                  IconButton(icon="mouse-pointer-2", label="Select", hint="Select (V)", shortcut="v", selected=not hand, disabled=false, testId="select-tool", press=selectTool)
                  IconButton(icon="hand", label="Pan", hint="Pan (H) · Hold Space to pan", shortcut="h", selected=hand, disabled=false, testId="hand-tool", press=handTool)
                  if not editing
                    column width=1 height=20 background-color="line.subtle" margin-left=2 margin-right=2
                    button press=addScreen class=Tool aria-label="New screen" title="New screen" testId="new-screen"
                      Icon(name="frame", size=16, angle=0)
                    button press=command("add", "rectangle") disabled=(doc.source != "") class=Tool aria-label="Rectangle" title="Rectangle" testId="add-rectangle"
                      Icon(name="square", size=16, angle=0)
                    button press=command("add", "text") disabled=(doc.source != "") class=Tool aria-label="Text" title="Text" testId="add-text"
                      Icon(name="type", size=16, angle=0)
