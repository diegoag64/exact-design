  clock data
  expect state doc.views.0.width == 760
  expect state doc.views.0.height == 540
  tap "undo"
  clock data
  expect state doc.views.0.width == 720

test "Exact layers resize independently and preserve responsive settings"
  size 1440x900
  tap "view-view-1"
  clock data
  tap "add-viewport"
  tap "variant-phone"
  clock data
  expect tree has "view-1-card"
  expect tree has "view-2-card"
  expect text "view-2-card-title" == "Start with something simple"
  tap "layer-card"
  clock data
  expect state doc.layers.2.width == 278
  tap "width-fixed"
  clock data
  tap "view-view-1"
  clock data
  expect state doc.layers.2.width == 278
  tap "undo"
  clock data
  expect state doc.layers.2.width == 608
  tap "view-view-2"
  clock data
  tap "layer-card"
  clock data
  expect state doc.layers.2.width == 278
  tap "save"
  clock data
  reload
  clock data
  expect state doc.layers.2.widthMode == "fill"

test "connect a live app and persist its linked viewports"
  size 1440x900
  tap "view-view-1"
  clock data
  type "preview-url" "http://127.0.0.1:5174/"
  type "preview-url" key "Enter"
  clock data
  expect tree has "view-1-app"
  expect tree missing "layer-title"
  tap "add-viewport"
  tap "variant-phone"
  clock data
  expect tree has "view-2-app"
  expect state doc.source == "http://127.0.0.1:5174/"
  tap "preview"
  expect tree has "preview-app"
  tap "close-preview"
  reload
  clock data
  expect state doc.source == "http://127.0.0.1:5174/"
  expect state doc.views.length == 2
  tap "view-view-1"
  clock data
  type "preview-url" ""
  type "preview-url" key "Enter"
  clock data
  expect tree has "layer-title"
  expect tree missing "view-1-app"

test "sidebar visibility is independent and remembered"
  size 1440x900
  tap "toggle-screens"
  expect tree missing "screens-panel"
  expect tree has "inspector-panel"
  tap "toggle-inspector"
  expect tree missing "inspector-panel"
  reload
  clock data
  expect tree missing "screens-panel"
  expect tree missing "inspector-panel"
  tap "toggle-screens"
  expect tree has "screens-panel"
  tap "toggle-inspector"
  expect tree has "inspector-panel"
  tap "new-screen"
  clock settle
  type "new-screen-name" "Draft"
  tap "create-screen"
  clock data
  clock settle
  expect state doc.views.length == 2

test "sidebars can open on a narrow window"
  size 390x844
  expect tree missing "screens-panel"
  expect tree missing "inspector-panel"
  tap "toggle-screens"
  expect tree has "screens-panel"
  tap "view-view-1"
  clock data
  tap "toggle-inspector"
  expect tree missing "screens-panel"
  expect tree has "inspector-panel"
  expect tree has "screen-name"
  tap "toggle-inspector"
  expect tree missing "inspector-panel"

test "frames snap into place as one undo step"
  size 1440x900
  tap "view-view-1"
  clock data
  tap "add-viewport"
  tap "variant-phone"
  clock data
  tap "canvas" drag 71 71 from 680 52 mouse
  clock data
  expect state doc.views.1.x == 900
  expect state doc.views.1.y == 100
  tap "canvas" drag -68 -68 from 751 123 mouse
  clock data
  expect state doc.views.1.x == 800
  expect state doc.views.1.y == 0
  tap "undo"
  clock data
  expect state doc.views.1.x == 900
  expect state doc.views.1.y == 100
  reload
  clock data
  expect state doc.views.1.x == 900
  expect state doc.views.1.y == 100

test "canvas pan and zoom restore without saving"
  size 1440x900
  // Land the workspace and finish the loading veil before pointer input.
  clock data
  clock settle
  expect state booting == false
  expect tree missing "canvas-loading"
  tap "hand-tool"
  tap "canvas" drag 120 60 from 150 150 mouse
  tap "zoom-in"
  expect state px == 184
  expect state py == 140
  expect text "zoom" == "95%"
  reload
  clock data
  expect state px == 184
  expect state py == 140
  expect text "zoom" == "95%"

test "reduced preview effects toggle and persist"
  size 1440x900
  expect state reducedEffects == false
  tap "reduce-effects"
  expect state reducedEffects == true
  reload
  clock data
  expect state reducedEffects == true
  tap "reduce-effects"
  expect state reducedEffects == false

test "project screens share a server and group their viewports"
  size 1440x900
  tap "project-connection"
  clock settle
  type "project-name" "Ember"
  type "project-url" "http://127.0.0.1:5174/"
  tap "save-project"
  clock data
  clock settle
  expect state doc.projectName == "Ember"
  tap "add-screen"
  clock settle
  type "new-screen-name" "Compose"
  type "new-screen-route" "/note"
  tap "create-screen"
  clock data
  clock settle
  expect state doc.source == "http://127.0.0.1:5174/note"
  expect state doc.groups.length == 2
  tap "add-viewport"
  tap "variant-tablet"
  clock data
  expect state doc.groups.1.views.length == 2
  tap "fold-group-screen-2"
  expect tree missing "view-view-2"
  expect tree missing "view-view-3"
  tap "fold-group-screen-2"
  expect tree has "view-view-2"
  expect tree has "view-view-3"
  tap "project-connection"
  clock settle
  type "project-url" "http://127.0.0.1:6000"
  tap "save-project"
  clock data
  clock settle
  expect state doc.views.1.source == "http://127.0.0.1:6000/note"
  expect state doc.views.2.source == "http://127.0.0.1:6000/note"
  tap "undo"
  clock data
  expect state doc.source == "http://127.0.0.1:5174/note"
  reload
  clock data
  expect state doc.projectName == "Ember"
  expect state doc.groups.1.views.length == 2
  clock settle
  tap "view-view-2"
  clock data
  expect state doc.route == "/note"
  type "screen-route" "/note?state=empty"
  type "screen-route" key "Enter"
  clock data
  expect state doc.views.2.source == "http://127.0.0.1:5174/note?state=empty"
  tap "project-connection"
  clock settle
  reload
  clock data
  clock settle
  expect text "project-name" == "Ember"
  expect text "project-url" == "http://127.0.0.1:5174"

test "project setup and viewport settings restore automatically without Save"
  size 1440x900
  tap "project-connection"
  clock settle
  type "project-name" "Ember"
  type "project-url" "http://127.0.0.1:5176"
  tap "save-project"
  clock data
  clock settle
  tap "add-screen"
  clock settle
  type "new-screen-name" "Library"
  type "new-screen-route" "/"
  tap "create-screen"
  clock data
  clock settle
  tap "add-viewport"
  tap "variant-tablet"
  clock data
  type "frame-width" "820"
  type "frame-width" key "Enter"
  clock data
  tap "zoom-in"
  reload
  clock data
  expect state doc.projectName == "Ember"
  expect state doc.projectUrl == "http://127.0.0.1:5176"
  expect state doc.groups.length == 2
  expect state doc.groups.1.views.length == 2
  expect state doc.active == "view-3"
  expect state doc.selected == "view-3"
  expect state doc.source == "http://127.0.0.1:5176/"
  expect state doc.width == 820
  expect state doc.height == 1024
  tap "delete"
  clock data
  reload
  clock data
  expect state doc.views.length == 2
  expect state doc.groups.1.views.length == 1

test "invalid connections and duplicate routes stay in the form"
  size 1440x900
  tap "project-connection"
  clock settle
  type "project-name" "Ember"
  type "project-url" "javascript:bad"
  tap "save-project"
  clock data
  expect tree has "library-error"
  expect state doc.projectUrl == ""
  type "project-url" "http://127.0.0.1:5174"
  tap "save-project"
  clock data
  clock settle
  tap "add-screen"
  clock settle
  type "new-screen-name" "Library"
  tap "create-screen"
  clock data
  clock settle
  tap "add-screen"
  clock settle
  type "new-screen-name" "Again"
  tap "create-screen"
  clock data
  expect text "library-error" == "That route is already in your screen library."
  expect state doc.groups.length == 2
  tap "close-library"
  clock settle
  tap "project-connection"
  clock settle
  tap "disconnect-project"
  clock data
  clock settle
  expect state doc.projectUrl == ""
  expect state doc.source == "http://127.0.0.1:5174/"
  expect state doc.route == ""

test "discover screens, resolve parameters, and refresh the manifest"
  size 1440x900
  request POST "http://127.0.0.1:5176/mode" {"mode":"normal"}
  tap "project-connection"
  type "project-name" "Discovered app"
  type "project-url" "http://127.0.0.1:5176"
  tap "save-project"
  clock data
  tap "add-screen"
  clock data
  expect state discovered.routes.length == 3
  tap "discovered-0"
  expect text "new-screen-name" == "Library"
  expect text "new-screen-route" == "/"
  type "new-screen-viewports" "Tablet"
  tap "create-screen"
  clock data
  expect state doc.route == "/"
  expect state doc.width == 768
  tap "add-screen"
  clock data
  expect disabled "discovered-0"
  tap "discovered-1"
  tap "create-screen"
  clock data
  expect tree has "library-error"
  expect state doc.groups.length == 2
  type "new-screen-route" "/note/7"
  tap "create-screen"
  clock data
  expect state doc.route == "/note/7"
  tap "undo"
  clock data
  expect state doc.groups.length == 2
  tap "add-screen"
  clock data
  request POST "http://127.0.0.1:5176/mode" {"mode":"updated"}
  tap "refresh-discovery"
  clock data
  expect state discovered.routes.length == 4
  expect tree has "discovered-3"

test "discovery errors retry and keep manual entry available"
  size 1440x900
  request POST "http://127.0.0.1:5176/mode" {"mode":"invalid"}
  tap "project-connection"
  type "project-name" "Discovered app"
  type "project-url" "http://127.0.0.1:5176"
  tap "save-project"
  clock data
  tap "add-screen"
  clock data
  expect tree has "discovery-error"
  type "new-screen-name" "Manual"
  type "new-screen-route" "/manual"
  tap "create-screen"
  clock data
  expect state doc.route == "/manual"
  tap "add-screen"
  request POST "http://127.0.0.1:5176/mode" {"mode":"normal"}
  tap "refresh-discovery"
  clock data
  expect tree missing "discovery-error"
  expect tree has "discovered-0"
  fail fetch "http://127.0.0.1:5175"
  tap "refresh-discovery"
  clock data
  expect tree has "discovery-error"
  expect tree missing "discovered-0"
  pass fetch "http://127.0.0.1:5175"
  tap "refresh-discovery"
  clock data
  expect tree missing "discovery-error"
  tap "close-library"
  tap "project-connection"
  type "project-url" "http://127.0.0.1:5177"
  tap "save-project"
  clock data
  tap "add-screen"
  clock data
  expect state discovered.owner == "http://127.0.0.1:5177"
  expect tree has "discovery-error"
  expect tree missing "discovered-0"

test "an empty manifest still offers a blank or manual screen"
