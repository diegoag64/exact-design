test "navigate rendered layers and keep selection through edits and undo"
  size 1440x900
  request POST "http://127.0.0.1:5176/mode" {"mode":"elements"}
  tap "view-view-1"
  clock data
  type "preview-url" "http://127.0.0.1:5176/"
  type "preview-url" key "Enter"
  clock data
  tap "edit-app"
  clock data
  clock +3500 real
  clock data
  expect state elementTree.length == 4
  tap "fold-element-1"
  expect tree missing "element-2"
  request POST "http://127.0.0.1:5176/fixture/select" {"site":2}
  clock +1000 real
  clock data
  expect tree has "element-2"
  expect state revealedLayerRevision == 1
  tap "element-2"
  clock +300 real
  clock data
  expect text "selected-element-name" == "Save"
  expect text "selected-element-kind" == "Button"
  expect state revealedLayerRevision == 2
  expect tree missing "element-breadcrumbs"
  expect text "design-property-0" == "#ffffff"
  clock +1000 real
  expect tree has "spacing-overlay"
  expect text "spacing-readonly-padding-top" == "20"
  tap "element-1" hover
  clock data
  expect state hoveredElement == "root/0:main/0:section"
  expect text "selected-element-name" == "Save"
  expect text "design-property-0" == "#ffffff"
  tap "selected-element-name" hover
  clock data
  expect state hoveredElement == ""
  request POST "http://127.0.0.1:5176/fixture/mark" {}
  type "design-property-0" "#123456"
  type "design-property-0" key "Enter"
  clock data
  clock +150 real
  expect text "design-property-0" == "#123456"
  expect text "selected-element-name" == "Save"
  expect tree has "apply-design"
  expect text "draft-count" == "1 unsaved change"
  request POST "http://127.0.0.1:5176/fixture/assert-draft" {}
  tap "undo-app-design"
  clock data
  expect text "design-property-0" == "#ffffff"
  expect tree missing "apply-design"
  request POST "http://127.0.0.1:5176/fixture/assert-draft" {}
  type "design-property-0" "#123456"
  type "design-property-0" key "Enter"
  clock data
  tap "apply-design"
  clock data
  clock +1800 real
  clock data
  expect text "design-property-0" == "#123456"
  expect tree missing "apply-design"
  request POST "http://127.0.0.1:5176/fixture/assert-applied" {}
  tap "element-parent"
  clock +1300 real
  clock data
  expect text "selected-element-name" == "Header"
  expect text "selected-element-kind" == "Container"
  expect tree missing "design-property-0"
  tap "edit-app"
  clock data
  expect state editing == false
  expect tree missing "spacing-overlay"
  expect tree has "screens-panel"

test "reveal an offscreen canvas selection and reveal it again after manual scrolling"
  size 1440x900
  request POST "http://127.0.0.1:5176/mode" {"mode":"elements-long"}
  tap "view-view-1"
  clock data
  type "preview-url" "http://127.0.0.1:5176/"
  type "preview-url" key "Enter"
  clock data
  tap "edit-app"
  clock data
  clock +3500 real
  expect state elementTree.length == 44
  tap "fold-element-0"
  expect tree missing "element-43"
  request POST "http://127.0.0.1:5176/fixture/select" {"site":139}
  clock +1000 real
  expect tree has "element-43"
  expect text "selected-element-name" == "Layer 40"
  expect state revealedLayerRevision == 1
  tap "element-tree" wheel 0 -2000
  clock +1000 real
  expect state revealedLayerRevision == 1
  request POST "http://127.0.0.1:5176/fixture/select" {"site":139}
  clock +1000 real
  expect state revealedLayerRevision == 2
  tap "toggle-screens"
  tap "toggle-screens"
  clock +100 real
  expect tree has "element-43"
  expect state revealedLayerRevision == 2


test "save a design draft across editor reloads and discard without writing code"
  size 1440x900
  request POST "http://127.0.0.1:5176/mode" {"mode":"elements"}
  tap "view-view-1"
  clock data
  type "preview-url" "http://127.0.0.1:5176/"
  type "preview-url" key "Enter"
  clock data
  tap "edit-app"
  clock data
  clock +1800 real
  tap "element-2"
  clock +300 real
  clock data
  type "design-property-0" "#123456"
  type "design-property-0" key "Enter"
  clock data
  expect tree has "apply-design"
  tap "edit-app"
  clock data
  tap "edit-app"
  clock data
  clock +500 real
  expect tree has "apply-design"
  reload
  clock data
  tap "edit-app"
  clock data
  clock +1800 real
  expect tree has "apply-design"
  tap "element-2"
  clock +300 real
  clock data
  expect text "design-property-0" == "#123456"
