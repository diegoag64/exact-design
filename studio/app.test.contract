test "edit a layer and undo"
  size 1440x900
  tap "layer-title"
  clock data
  type "text-content" "A clearer idea."
  type "text-content" key "Enter"
  clock data
  expect state doc.layers.0.text == "A clearer idea."
  tap "undo"
  clock data
  expect state doc.layers.0.text == "A little room to think."
  tap "redo"
  clock data
  expect state doc.layers.0.text == "A clearer idea."

test "create and delete a button"
  size 1440x900
  tap "add-button"
  clock data
  expect state doc.layers.length == 7
  tap "delete"
  clock data
  expect state doc.layers.length == 6

test "preview uses working Exact controls"
  size 1440x900
  tap "preview"
  tap "preview-button"
  expect text "preview-clicks" == "Clicked 1"
  tap "close-preview"
  tap "export"
  expect tree has "code"
  tap "close-export"

test "save and reopen a document"
  size 1440x900
  tap "layer-title"
  clock data
  type "text-content" "Saved design"
  type "text-content" key "Enter"
  clock data
  tap "save"
  clock data
  expect text "save-status" == "Saved"
  reload
  clock data
  expect state doc.layers.0.text == "Saved design"

test "drag and resize on the canvas"
  size 1440x900
  tap "canvas" drag 34 17 from 150 145 mouse
  clock data
  expect state doc.layers.0.x == 96
  expect state doc.layers.0.y == 80
  tap "layer-button"
  clock data
  tap "canvas" drag 34 17 from 241 466 mouse
  clock data
  expect state doc.layers.5.width == 192
  expect state doc.layers.5.height == 64
  tap "undo"
  clock data
  expect state doc.layers.5.width == 152

test "linked viewports share edits and persist dimensions"
  size 1440x900
  tap "view-view-1"
  clock data
  tap "add-viewport"
  tap "variant-phone"
  clock data
  expect state doc.views.length == 2
  expect state doc.width == 390
  tap "layer-title"
  clock data
  type "text-content" "Shared heading"
  type "text-content" key "Enter"
  clock data
  tap "view-view-1"
  clock data
  expect state doc.layers.0.text == "Shared heading"
  tap "view-view-2"
  clock data
  type "frame-width" "430"
  type "frame-width" key "Enter"
  clock data
  reload
  clock data
  expect state doc.views.1.width == 430
  expect state doc.layers.0.text == "Shared heading"

test "create rename duplicate and delete screens"
  size 1440x900
  tap "add-screen"
  clock settle
  type "new-screen-name" "Draft"
  tap "create-screen"
  clock data
  clock settle
  expect state doc.views.length == 2
  expect state doc.layers.length == 0
  type "screen-name" "Settings"
  type "screen-name" key "Enter"
  clock data
  tap "add-text"
  clock data
  tap "view-view-2"
  clock data
  tap "duplicate-screen"
  clock data
  expect state doc.screenName == "Settings copy"
  expect state doc.layers.length == 1
  type "viewport-preset" "Tablet"
  clock data
  expect state doc.views.length == 3
  expect state doc.width == 768
  expect state doc.height == 1024
  tap "delete"
  clock data
  expect state doc.views.length == 2
  tap "undo"
  clock data
  expect state doc.views.length == 3

test "move and resize a screen frame"
  size 1440x900
  tap "canvas" drag 34 17 from 80 68 mouse
  clock data
  expect state doc.views.0.x == 40
  expect state doc.views.0.y == 20
  tap "canvas" drag 34 17 from 710 539 mouse
  clock data
  expect state doc.views.0.width == 760
  expect state doc.views.0.height == 540
  tap "undo"
  clock data
  expect state doc.views.0.width == 720

test "Exact layers resize independently and preserve responsive settings"
  size 1440x900
  tap "view-view-1"
  clock data
  tap "add-viewport"
  tap "variant-phone"
  clock data
  expect tree has "view-1-card"
  expect tree has "view-2-card"
  expect text "view-2-card-title" == "Start with something simple"
  tap "layer-card"
  clock data
  expect state doc.layers.2.width == 278
  tap "width-fixed"
  clock data
  tap "view-view-1"
  clock data
  expect state doc.layers.2.width == 278
  tap "undo"
  clock data
  expect state doc.layers.2.width == 608
  tap "view-view-2"
  clock data
  tap "layer-card"
  clock data
  expect state doc.layers.2.width == 278
  tap "save"
  clock data
  reload
  clock data
  expect state doc.layers.2.widthMode == "fill"

test "connect a live app and persist its linked viewports"
  size 1440x900
  tap "view-view-1"
  clock data
  type "preview-url" "http://127.0.0.1:5174/"
  type "preview-url" key "Enter"
  clock data
  expect tree has "view-1-app"
  expect tree missing "layer-title"
  tap "add-viewport"
  tap "variant-phone"
  clock data
  expect tree has "view-2-app"
  expect state doc.source == "http://127.0.0.1:5174/"
  tap "preview"
  expect tree has "preview-app"
  tap "close-preview"
  reload
  clock data
  expect state doc.source == "http://127.0.0.1:5174/"
  expect state doc.views.length == 2
  tap "view-view-1"
  clock data
  type "preview-url" ""
  type "preview-url" key "Enter"
  clock data
  expect tree has "layer-title"
  expect tree missing "view-1-app"

test "sidebar visibility is independent and remembered"
  size 1440x900
  tap "toggle-screens"
  expect tree missing "screens-panel"
  expect tree has "inspector-panel"
  tap "toggle-inspector"
  expect tree missing "inspector-panel"
  reload
  clock data
  expect tree missing "screens-panel"
  expect tree missing "inspector-panel"
  tap "toggle-screens"
  expect tree has "screens-panel"
  tap "toggle-inspector"
  expect tree has "inspector-panel"
  tap "new-screen"
  clock settle
  type "new-screen-name" "Draft"
  tap "create-screen"
  clock data
  clock settle
  expect state doc.views.length == 2

test "sidebars can open on a narrow window"
  size 390x844
  expect tree missing "screens-panel"
  expect tree missing "inspector-panel"
  tap "toggle-screens"
  expect tree has "screens-panel"
  tap "view-view-1"
  clock data
  tap "toggle-inspector"
  expect tree missing "screens-panel"
  expect tree has "inspector-panel"
  expect tree has "screen-name"
  tap "toggle-inspector"
  expect tree missing "inspector-panel"

test "frames snap into place as one undo step"
  size 1440x900
  tap "view-view-1"
  clock data
  tap "add-viewport"
  tap "variant-phone"
  clock data
  tap "canvas" drag 76 76 from 680 52 mouse
  clock data
  expect state doc.views.1.x == 900
  expect state doc.views.1.y == 100
  tap "canvas" drag -73 -73 from 756 128 mouse
  clock data
  expect state doc.views.1.x == 800
  expect state doc.views.1.y == 0
  tap "undo"
  clock data
  expect state doc.views.1.x == 900
  expect state doc.views.1.y == 100
  reload
  clock data
  expect state doc.views.1.x == 900
  expect state doc.views.1.y == 100

test "canvas pan and zoom restore without saving"
  size 1440x900
  tap "hand-tool"
  tap "canvas" drag 120 60 from 150 150 mouse
  tap "zoom-in"
  expect state px == 184
  expect state py == 140
  expect text "zoom" == "95%"
  reload
  clock data
  expect state px == 184
  expect state py == 140
  expect text "zoom" == "95%"

test "project screens share a server and group their viewports"
  size 1440x900
  tap "project-connection"
  clock settle
  type "project-name" "Morrow"
  type "project-url" "http://127.0.0.1:5174/"
  tap "save-project"
  clock data
  clock settle
  expect state doc.projectName == "Morrow"
  tap "add-screen"
  clock settle
  type "new-screen-name" "Compose"
  type "new-screen-route" "/note"
  tap "create-screen"
  clock data
  clock settle
  expect state doc.source == "http://127.0.0.1:5174/note"
  expect state doc.groups.length == 2
  tap "add-viewport"
  tap "variant-tablet"
  clock data
  expect state doc.groups.1.views.length == 2
  tap "group-screen-2"
  expect tree missing "view-view-2"
  expect tree missing "view-view-3"
  tap "group-screen-2"
  expect tree has "view-view-2"
  expect tree has "view-view-3"
  tap "project-connection"
  clock settle
  type "project-url" "http://127.0.0.1:6000"
  tap "save-project"
  clock data
  clock settle
  expect state doc.views.1.source == "http://127.0.0.1:6000/note"
  expect state doc.views.2.source == "http://127.0.0.1:6000/note"
  tap "undo"
  clock data
  expect state doc.source == "http://127.0.0.1:5174/note"
  reload
  clock data
  expect state doc.projectName == "Morrow"
  expect state doc.groups.1.views.length == 2
  clock settle
  tap "view-view-2"
  clock data
  expect state doc.route == "/note"
  type "screen-route" "/note?state=empty"
  type "screen-route" key "Enter"
  clock data
  expect state doc.views.2.source == "http://127.0.0.1:5174/note?state=empty"
  tap "project-connection"
  clock settle
  reload
  clock data
  clock settle
  expect text "project-name" == "Morrow"
  expect text "project-url" == "http://127.0.0.1:5174"

test "project setup and viewport settings restore automatically without Save"
  size 1440x900
  tap "project-connection"
  clock settle
  type "project-name" "Morrow"
  type "project-url" "http://127.0.0.1:5176"
  tap "save-project"
  clock data
  clock settle
  tap "add-screen"
  clock settle
  type "new-screen-name" "Library"
  type "new-screen-route" "/"
  tap "create-screen"
  clock data
  clock settle
  tap "add-viewport"
  tap "variant-tablet"
  clock data
  type "frame-width" "820"
  type "frame-width" key "Enter"
  clock data
  tap "zoom-in"
  reload
  clock data
  expect state doc.projectName == "Morrow"
  expect state doc.projectUrl == "http://127.0.0.1:5176"
  expect state doc.groups.length == 2
  expect state doc.groups.1.views.length == 2
  expect state doc.active == "view-3"
  expect state doc.selected == "view-3"
  expect state doc.source == "http://127.0.0.1:5176/"
  expect state doc.width == 820
  expect state doc.height == 1024
  tap "delete"
  clock data
  reload
  clock data
  expect state doc.views.length == 2
  expect state doc.groups.1.views.length == 1

test "invalid connections and duplicate routes stay in the form"
  size 1440x900
  tap "project-connection"
  clock settle
  type "project-name" "Morrow"
  type "project-url" "javascript:bad"
  tap "save-project"
  clock data
  expect tree has "library-error"
  expect state doc.projectUrl == ""
  type "project-url" "http://127.0.0.1:5174"
  tap "save-project"
  clock data
  clock settle
  tap "add-screen"
  clock settle
  type "new-screen-name" "Library"
  tap "create-screen"
  clock data
  clock settle
  tap "add-screen"
  clock settle
  type "new-screen-name" "Again"
  tap "create-screen"
  clock data
  expect text "library-error" == "That route is already in your screen library."
  expect state doc.groups.length == 2
  tap "close-library"
  clock settle
  tap "project-connection"
  clock settle
  tap "disconnect-project"
  clock data
  clock settle
  expect state doc.projectUrl == ""
  expect state doc.source == "http://127.0.0.1:5174/"
  expect state doc.route == ""

test "discover screens, resolve parameters, and refresh the manifest"
  size 1440x900
  request POST "http://127.0.0.1:5176/mode" {"mode":"normal"}
  tap "project-connection"
  type "project-name" "Discovered app"
  type "project-url" "http://127.0.0.1:5176"
  tap "save-project"
  clock data
  tap "add-screen"
  clock data
  expect state discovered.routes.length == 3
  tap "discovered-0"
  expect text "new-screen-name" == "Library"
  expect text "new-screen-route" == "/"
  tap "new-preset-Tablet"
  tap "create-screen"
  clock data
  expect state doc.route == "/"
  expect state doc.width == 768
  tap "add-screen"
  clock data
  expect disabled "discovered-0"
  tap "discovered-1"
  tap "create-screen"
  clock data
  expect tree has "library-error"
  expect state doc.groups.length == 2
  type "new-screen-route" "/note/7"
  tap "create-screen"
  clock data
  expect state doc.route == "/note/7"
  tap "undo"
  clock data
  expect state doc.groups.length == 2
  tap "add-screen"
  clock data
  request POST "http://127.0.0.1:5176/mode" {"mode":"updated"}
  tap "refresh-discovery"
  clock data
  expect state discovered.routes.length == 4
  expect tree has "discovered-3"

test "discovery errors retry and keep manual entry available"
  size 1440x900
  request POST "http://127.0.0.1:5176/mode" {"mode":"invalid"}
  tap "project-connection"
  type "project-name" "Discovered app"
  type "project-url" "http://127.0.0.1:5176"
  tap "save-project"
  clock data
  tap "add-screen"
  clock data
  expect tree has "discovery-error"
  type "new-screen-name" "Manual"
  type "new-screen-route" "/manual"
  tap "create-screen"
  clock data
  expect state doc.route == "/manual"
  tap "add-screen"
  request POST "http://127.0.0.1:5176/mode" {"mode":"normal"}
  tap "refresh-discovery"
  clock data
  expect tree missing "discovery-error"
  expect tree has "discovered-0"
  fail fetch "http://127.0.0.1:5175"
  tap "refresh-discovery"
  clock data
  expect tree has "discovery-error"
  expect tree missing "discovered-0"
  pass fetch "http://127.0.0.1:5175"
  tap "refresh-discovery"
  clock data
  expect tree missing "discovery-error"
  tap "close-library"
  tap "project-connection"
  type "project-url" "http://127.0.0.1:5177"
  tap "save-project"
  clock data
  tap "add-screen"
  clock data
  expect state discovered.owner == "http://127.0.0.1:5177"
  expect tree has "discovery-error"
  expect tree missing "discovered-0"

test "an empty manifest still offers a blank or manual screen"
  size 390x844
  request POST "http://127.0.0.1:5176/mode" {"mode":"empty"}
  tap "toggle-screens"
  tap "project-connection"
  type "project-name" "Empty app"
  type "project-url" "http://127.0.0.1:5176"
  tap "save-project"
  clock data
  tap "add-screen"
  clock data
  expect tree has "discovery-empty"

test "source editing refuses a server without Exact editing support"
  size 1440x900
  tap "view-view-1"
  clock data
  type "preview-url" "http://127.0.0.1:5176/"
  type "preview-url" key "Enter"
  clock data
  tap "edit-app"
  clock data
  expect tree has "design-error"
  expect state editing == false
  expect tree has "viewport-preset"

test "navigate rendered layers and keep selection through edits and undo"
  size 1440x900
  request POST "http://127.0.0.1:5176/mode" {"mode":"elements"}
  tap "view-view-1"
  clock data
  type "preview-url" "http://127.0.0.1:5176/"
  type "preview-url" key "Enter"
  clock data
  tap "edit-app"
  clock data
  clock +3500 real
  clock data
  expect state elementTree.length == 4
  tap "fold-element-1"
  expect tree missing "element-2"
  tap "fold-element-1"
  tap "element-2"
  clock +300 real
  clock data
  expect text "selected-element-name" == "Save"
  expect text "selected-element-kind" == "Button"
  expect tree missing "element-breadcrumbs"
  expect text "design-property-0" == "#ffffff"
  clock +1000 real
  expect tree has "spacing-overlay"
  expect text "spacing-readonly-padding-top" == "20"
  tap "element-1" hover
  clock data
  expect state hoveredElement == "root/0:main/0:section"
  expect text "selected-element-name" == "Save"
  expect text "design-property-0" == "#ffffff"
  tap "selected-element-name" hover
  clock data
  expect state hoveredElement == ""
  type "design-property-0" "#123456"
  type "design-property-0" key "Enter"
  clock data
  clock +3500 real
  clock data
  expect text "design-property-0" == "#123456"
  expect text "selected-element-name" == "Save"
  tap "undo-app-design"
  clock data
  clock +3500 real
  clock data
  expect text "design-property-0" == "#ffffff"
  tap "element-parent"
  clock +1300 real
  clock data
  expect text "selected-element-name" == "Header"
  expect text "selected-element-kind" == "Container"
  expect tree missing "design-property-0"
  tap "edit-app"
  clock data
  expect state editing == false
  expect tree missing "spacing-overlay"
  expect tree has "screens-panel"
