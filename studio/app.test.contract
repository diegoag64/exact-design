  clock data
  expect tree missing "apply-design"
  expect text "design-property-0" == "#ffffff"
  request POST "http://127.0.0.1:5176/fixture/assert-color?value=%23ffffff" {}

test "load full screens at each width and switch between automatic and fixed height"
  size 1440x900
  request POST "http://127.0.0.1:5176/mode" {"mode":"full-height"}
  tap "view-view-1"
  clock data
  type "preview-url" "http://127.0.0.1:5176/"
  type "preview-url" key "Enter"
  clock data
  clock +1500 real
  expect state scene.views.0.width == 720
  expect state scene.views.0.height == 1670
  expect text "frame-height" == "1670"
  expect state doc.views.0.autoHeight == true
  type "frame-height" "600"
  type "frame-height" key "Enter"
  clock data
  clock +700 real
  expect state scene.views.0.height == 600
  expect state scene.views.0.autoHeight == false
  tap "auto-height"
  clock data
  clock +1000 real
  expect state scene.views.0.height == 1670
  type "frame-width" "390"
  type "frame-width" key "Enter"
  clock data
  clock +1000 real
  expect state scene.views.0.width == 390
  expect state scene.views.0.height == 3206
  type "frame-width" "1440"
  type "frame-width" key "Enter"
  clock data
  clock +1000 real
  expect state scene.views.0.height == 1158
  request POST "http://127.0.0.1:5176/fixture/content" {"short":true}
  clock +700 real
  expect state scene.views.0.height == 600
  request POST "http://127.0.0.1:5176/fixture/content" {"short":false}
  clock +700 real
  expect state scene.views.0.height == 1158
  type "preview-url" "http://127.0.0.1:5176/short"
  type "preview-url" key "Enter"
  clock data
  clock +1000 real
  expect state scene.views.0.height == 600
  reload
  clock data
  clock +1500 real
  expect state scene.views.0.autoHeight == true
  expect state scene.views.0.height == 600


test "sidebar screen clicks pan smoothly to the screen top without changing zoom"
  size 1440x900
  clock data
  tap "view-view-1"
  clock data
  expect state panning == true
  expect state zoom == 0.85
  expect state cameraX == 64
  clock +140
  expect state cameraX == 148.00233236151603
  expect state panning == true
  clock +160
  expect state panning == false
  expect state cameraX == 164
  expect state cameraY == 64
  tap "canvas" wheel 100 50
  expect state px == 64
  expect state py == 14
  tap "group-screen-1"
  clock data
  expect state panning == true
  clock +80
  tap "canvas" wheel 20 10
  expect state panning == false
  expect state px == 107.55685131195335
  clock +400
  expect state panning == false
  tap "toggle-inspector"
  tap "group-screen-1"
  clock +300
  expect state cameraX == 294
  expect state cameraY == 64
  expect state zoom == 0.85

test "screen centering respects reduced motion and overlay sidebars"
  size 900x900
  prefer prefers-reduced-motion reduce
  clock data
  tap "toggle-screens"
  tap "view-view-1"
  clock data
  expect state panning == false
  expect state cameraX == 134
  expect state cameraY == 64
  expect state zoom == 0.85

test "pan tools remain available while editing an app"
  size 1440x900
  prefer prefers-reduced-motion reduce
  request POST "http://127.0.0.1:5176/mode" {"mode":"elements"}
  tap "view-view-1"
  clock data
  type "preview-url" "http://127.0.0.1:5176/"
  type "preview-url" key "Enter"
  clock data
  tap "edit-app"
  clock data
  clock +1500 real
  clock data
  expect state editing == true
  expect tree has "select-tool"
  expect tree has "hand-tool"
  expect tree missing "add-rectangle"
  expect state hand == false
  expect state px == 48
  tap "canvas-stage" wheel 100 50
  expect state px == -52
  expect state py == 14
  tap "hand-tool"
  expect state hand == true
  tap "canvas" drag 120 60 from 150 150 mouse
  expect state px == 68
  expect state py == 74
  expect state doc.views.0.x == 0
  expect state doc.views.0.y == 0
  tap "select-tool"
  expect state hand == false
  expect state editing == true
  expect tree has "element-tree"


test "context actions select the clicked layer and keep screen operations separate"
  size 1440x900
  tap "layer-title"
  clock data
  tap "layer-description" contextmenu
  clock settle
  expect state doc.selected == "description"
  tap "menu-delete"
  clock data
  expect state doc.layers.length == 5
  tap "undo"
  clock data
  expect state doc.layers.length == 6
  tap "view-view-1" contextmenu
  clock settle
  expect state doc.frameSelected == true
  tap "menu-variant-phone"
  clock data
  expect state doc.views.length == 2

test "review pending design changes and revert one before applying"
  size 1440x900
  request POST "http://127.0.0.1:5176/mode" {"mode":"elements"}
  tap "view-view-1"
  clock data
  type "preview-url" "http://127.0.0.1:5176/"
  type "preview-url" key "Enter"
  clock data
  tap "edit-app"
  clock data
  clock +1800 real
  tap "element-2"
  clock +300 real
  clock data
  type "design-property-0" "#123456"
  type "design-property-0" key "Enter"
  clock data
  expect text "draft-count" == "1 unsaved change"
  tap "review-design"
  expect tree has "review-dialog"
  expect tree has "review-change-0-0"
  tap "review-cancel"
  expect tree missing "review-dialog"
  expect tree has "apply-design"
  tap "review-design"
  tap "review-revert-0-0"
  clock data
  expect tree missing "review-dialog"
  expect tree missing "apply-design"
  expect text "design-property-0" == "#ffffff"
  request POST "http://127.0.0.1:5176/fixture/assert-color?value=%23ffffff" {}

test "add a device set to a screen and tidy up"
  size 1440x900
  tap "view-view-1"
  clock data
  tap "add-viewport"
  tap "variant-set-core"
  clock data
  expect state doc.views.length == 4
  expect state doc.views.3.width == 1440
  tap "add-viewport"
  tap "variant-set-core"
  clock data
  expect state doc.views.length == 4
  tap "add-viewport"
  tap "variant-ipad-mini"
  clock data
  expect state doc.views.length == 5
  expect state doc.width == 744
  tap "tidy-up"
  clock data
  expect state doc.views.1.x == 800

test "add every discovered screen with a device set"
  size 1440x900
  request POST "http://127.0.0.1:5176/mode" {"mode":"normal"}
  tap "project-connection"
  type "project-name" "Discovered app"
  type "project-url" "http://127.0.0.1:5176"
  tap "save-project"
  clock data
  tap "add-screen"
  clock data
  type "new-screen-viewports" "Core"
  expect text "add-all-screens" == "Add all 2"
  tap "add-all-screens"
  clock data
  expect state doc.groups.length == 3
  expect state doc.views.length == 7
  tap "add-screen"
  clock data
  expect tree missing "add-all-screens"

test "presented modal routes keep the device height in automatic mode"
  size 1440x900
  request POST "http://127.0.0.1:5176/mode" {"mode":"full-height"}
  tap "view-view-1"
  clock data
  type "preview-url" "http://127.0.0.1:5176/sheet"
  type "preview-url" key "Enter"
  clock data
  clock +1500 real
  expect state doc.views.0.autoHeight == true
  expect state scene.views.0.height == 520
  type "preview-url" "http://127.0.0.1:5176/"
  type "preview-url" key "Enter"
  clock data
  clock +1500 real
  expect state scene.views.0.height == 1670

test "a setup link connects a project and adds its screens once"
  size 1440x900
  at "/?connect=http://127.0.0.1:5176&name=Discovered%20app&viewports=Core"
  request POST "http://127.0.0.1:5176/mode" {"mode":"normal"}
  reload
  clock data
  clock +600 real
  clock data
  expect tree missing "setup-error"
  expect state doc.projectName == "Discovered app"
  expect state doc.groups.length == 2
  expect state doc.views.length == 6
  tap "undo"
  clock data
  expect state doc.projectUrl == ""
  expect state doc.groups.length == 1
  tap "redo"
  clock data
  expect state doc.views.length == 6
  reload
  clock data
  clock +600 real
  clock data
  expect state doc.groups.length == 2
  expect state doc.views.length == 6

test "a setup link with a show list adds every screen and leaves only the listed ones visible"
  size 1440x900
  at "/?connect=http://127.0.0.1:5176&name=Discovered%20app&viewports=Core&show=/settings"
  request POST "http://127.0.0.1:5176/mode" {"mode":"normal"}
  reload
  clock data
  clock +600 real
  clock data
  expect tree missing "setup-error"
  expect state doc.groups.length == 2
  expect state doc.views.length == 6
  expect state doc.groups.0.hidden == true
  expect state doc.groups.1.hidden == false
  tap "undo"
  clock data
  expect state doc.groups.length == 1

test "a setup link to an unreachable app explains the failure"
  size 1440x900
  at "/?connect=http://127.0.0.1:9&name=Nowhere"
  clock data
  clock +600 real
  clock data
  expect tree has "setup-error"
  expect state doc.projectUrl == ""
  tap "setup-dismiss"
  expect tree missing "setup-error"

test "the native preview drawer shows the selected screen beside editable web frames"
  size 1440x900
  at "/?connect=http://127.0.0.1:5176&name=Native%20app&viewports=Phone"
  request POST "http://127.0.0.1:5175/native" {"mode":"reset"}
  clock data
  clock settle
  expect tree missing "native-drawer"
  expect state native.state == "idle"
  expect tree has "edit-app"
  tap "toggle-native"
  clock data
  expect tree has "native-drawer"
  expect text "native-route" == "/"
  expect text "native-state" == "Not captured yet"
  expect text "native-refresh" == "Capture"
  expect tree has "edit-app"
  expect tree has "frame-view-2"
  tap "native-refresh"
  clock data
  expect state native.total == 1
  expect tree has "native-steps"
  expect text "native-step-build-detail" == "Compiling Swift · ExactKit"
  expect tree has "native-progress-bar"
  expect text "native-step-device-detail" == "Already running"
  clock until state native.phase == "capture" within 3000
  expect text "native-step-build-detail" == "Built in 1 s"
  expect text "native-step-capture-detail" == "1 of 1"
  clock until state native.message == "Native previews updated." within 5000
  expect tree missing "native-steps"
  expect tree has "native-shot"
  expect text "native-refresh" == "Refresh"
  clock +100
  tap "native-refresh"
  clock data
  clock until state native.state == "working" within 2000
  expect text "native-step-build-detail" == "Up to date"
  clock until state native.state == "idle" within 5000
  tap "native-close"
  expect tree missing "native-drawer"
  tap "screen-native"
  clock data
  expect tree has "native-shot"

test "native preview failures and stale captures keep the screen editable"
  size 1440x900
  at "/?connect=http://127.0.0.1:5176&name=Native%20app&viewports=Phone"
  request POST "http://127.0.0.1:5175/native" {"mode":"reset"}
  clock data
  clock settle
  tap "toggle-native"
  clock data
  type "screen-route" "/fail"
  type "screen-route" key "Enter"
  clock data
  expect text "native-route" == "/fail"
  tap "native-refresh"
  clock data
  clock until state native.state == "idle" within 5000
  expect text "native-state" == "Capture failed"
  expect text "native-frame-error-detail" == "Fixture capture failed."
  expect tree has "edit-app"
  type "screen-route" "/stale"
  type "screen-route" key "Enter"
  clock data
  tap "native-refresh"
  clock data
  clock until state native.state == "idle" within 5000
  expect text "native-chip" == "Stale · the app changed"

test "refresh all captures every connected screen and reports when they are up to date"
  size 1440x900
  at "/?connect=http://127.0.0.1:5176&name=Native%20app&viewports=Phone"
  request POST "http://127.0.0.1:5175/native" {"mode":"reset"}
  clock data
  clock settle
  tap "canvas-stage" contextmenu
  clock settle
  tap "menu-native"
  clock data
  expect tree has "native-drawer"
  tap "native-refresh-all"
  clock data
  expect state native.state == "working"
  expect state native.total == 2
  expect disabled "native-refresh"
  expect disabled "native-refresh-all"
  clock until state native.message == "Native previews updated." within 5000
  expect text "native-progress" == "Native previews updated."
  expect tree has "native-shot"
  clock +2500
  expect tree missing "native-progress"
  tap "native-refresh-all"
  clock until state native.message == "Native previews are up to date." within 3000
  expect state native.total == 0
  tap "native-dark"
  clock data
  expect text "native-state" == "Not captured yet"
  tap "native-light"
  clock data
  expect tree has "native-shot"

test "the native drawer says unapplied draft changes are not in the native build"
  size 1440x900
  at "/?connect=http://127.0.0.1:5176&name=Native%20app&viewports=Phone"
  request POST "http://127.0.0.1:5175/native" {"mode":"reset"}
  clock data
  clock settle
  request POST "http://127.0.0.1:5176/mode" {"mode":"elements"}
  reload
  clock data
  clock settle
  tap "toggle-native"
  clock data
  tap "edit-app"
  clock data
  clock +1800 real
  expect tree missing "native-drafts"
  tap "element-2"
  clock +300 real
  clock data
  type "design-property-0" "#123456"
  type "design-property-0" key "Enter"
  clock data
  expect tree has "apply-design"
  expect text "native-drafts" == "1 unapplied change isn't in the native build. Apply to code, then refresh."
  tap "discard-design"
  clock data
  expect tree missing "native-drafts"
