tamber editor

theme
  surface.panel = light-dark(#ffffff, #242426)
  surface.field = light-dark(#f5f5f6, #303034)
  surface.canvas = light-dark(#ededee, #1c1c1e)
  surface.action = light-dark(#292a2d, #e8e8eb)
  surface.selected = light-dark(#edf0ff, #333c60)
  surface.scrim = #00000040 scheme=fixed
  line.subtle = light-dark(#e8e8eb, #38383c)
  ink.primary = light-dark(#35363b, #ededf0)
  ink.secondary = light-dark(#707178, #b2b2ba)
  ink.muted = light-dark(#73747b, #95959f)
  ink.selected = light-dark(#4563d6, #b4c1ff)
  ink.inverse = light-dark(#ffffff, #242426)
  paper = #ffffff scheme=fixed

icons
  icon.panel-left = icon(sf "sidebar.left", svg "icons/panel-left.svg")
  icon.panel-right = icon(sf "sidebar.right", svg "icons/panel-right.svg")
  icon.pointer = icon(sf "cursorarrow", svg "icons/pointer.svg")
  icon.pan = icon(sf "arrow.up.and.down.and.arrow.left.and.right", svg "icons/pan.svg")
  icon.disclosure = icon(sf "chevron.right", svg "icons/disclosure.svg")
