tamber editor

theme
  accent = #0d99ff scheme=fixed
  AccentColor = accent
  surface.panel = light-dark(#ffffff, #2c2c2c)
  surface.field = light-dark(#f5f5f5, #383838)
  surface.canvas = light-dark(#e5e5e5, #1e1e1e)
  surface.hover = light-dark(#f0f0f0, #383838)
  surface.pressed = light-dark(#e5e5e5, #444444)
  surface.action = light-dark(#0877c9, #0d99ff)
  surface.selected = light-dark(#e5f4ff, #164b70)
  surface.scrim = #00000040 scheme=fixed
  line.subtle = light-dark(#e6e6e6, #3e3e3e)
  line.strong = light-dark(#d4d4d4, #505050)
  ink.primary = light-dark(#242424, #f5f5f5)
  ink.secondary = light-dark(#595959, #bfbfbf)
  ink.muted = light-dark(#6c6c6c, #a5a5a5)
  ink.selected = light-dark(#075c9a, #e5f4ff)
  ink.inverse = light-dark(#ffffff, #2c2c2c)
  ink.on-action = #ffffff scheme=fixed
  ink.danger = light-dark(#bd2828, #ff9b9b)
  paper = #ffffff scheme=fixed
  spacing.wash = #d946ef14 scheme=fixed
  spacing.edge = #c026d34d scheme=fixed
  spacing.ink = light-dark(#a21caf, #efabf5)
  radius.control: length = 4px
  radius.panel: length = 8px
  radius.menu: length = 10px
  shadow.menu: box-shadow = 0px 8px 32px #00000030
  type.body = 12px/1.4 system-ui
  type.caption = 11px/1.4 system-ui
  type.heading = 13px/1.4 system-ui
