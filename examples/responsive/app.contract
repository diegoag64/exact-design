shape Viewport
  width: number

component App
  resource viewport = exactViewport() as shape Viewport
  state count = 0
  action add
    count = count + 1
  view
    scroll width="100%" height="100%" background-color="page" color="ink" font-family="system-ui"
      column max-width=1000 margin-left="auto" margin-right="auto" padding=(viewport.width < 600 ? 24 : 48) gap=32
        row align-items="center"
          text "Studio" font-size=16 font-weight=600 flex=1
          text "Workspace" color="secondary" font-size=13
        column gap=10
          text "A little room to think." font-size=(viewport.width < 600 ? 28 : 40) font-weight=600 line-height=1.15
          text "Keep your ideas together. Make something good." color="secondary" font-size=16 line-height=1.5
        column flex-direction=(viewport.width < 600 ? "column" : "row") gap=16 testId="cards"
          column flex=1 min-width=0 padding=24 gap=12 background-color="card" border-radius=16
            text "Your next idea" font-size=20 font-weight=500
            text "Space for the things you haven’t quite figured out yet." color="secondary" font-size=15 line-height=1.5
          column flex=1 min-width=0 padding=24 gap=12 background-color="accent" border-radius=16
            text "In good company" font-size=20 font-weight=500
            text "Bring a few people along. Great work starts with a conversation." color="secondary" font-size=15 line-height=1.5
        row align-items="center" gap=16
          button press=add background-color="action" color="on-action" border-width=0 border-radius=8 padding=12 testId="create"
            text "New idea" font-size=14
          text `${count} ${count == 1 ? "idea" : "ideas"}` font-size=14 color="secondary" testId="count"
