// Lumen: a personal finance app. One file draws the iPhone app (UIKit's tab bar, sheets and
// Liquid Glass), the Mac and wide web windows (a sidebar beside a dashboard), and a phone-width
// browser. Each tab, sheet and the welcome screen is a route of its own.
use EmptyState from "exact:content"

routes nav
  tab home "/"
    opening "/open"
    welcome "/welcome"
    profile "/profile"
    send "/send"
  tab activity "/activity"
    transaction "/activity/transaction"
  tab cards "/cards"
  tab budgets "/budgets"
  tab goals "/goals"
    deposit "/goals/add"

shape Viewport
  width: number
  prefersReducedMotion: bool

shape Time
  epochAtZero: number
  utcOffset: number

shape Profile
  name: string
  first: string
  email: string
  plan: string
  since: string

shape Account
  id: string
  name: string
  kind: string
  number: string
  balance: number
  tint: string
  icon: string

shape Category
  id: string
  spent: number
  limit: number
  count: number
  share: number
  start: number

shape Tx
  id: string
  day: string
  date: string
  when: string
  merchant: string
  category: string
  amount: number
  account: string
  card: string
  note: string
  status: string

shape Card
  id: string
  name: string
  number: string
  network: string
  kind: string
  style: string
  limit: number
  expires: string
  spent: number
  frozen: bool
  holder: string

shape Goal
  id: string
  name: string
  icon: string
  tint: string
  target: number
  saved: number
  due: string
  monthly: number

shape Contact
  id: string
  name: string
  handle: string
  tint: string

shape Spend
  day: string
  label: string
  spent: number

shape Board
  profile: Profile
  label: string
  month: string
  net: number
  change: number
  spark: string
  area: string
  sparkEnd: number
  accounts: Account[]
  income: number
  spent: number
  budget: number
  categories: Category[]
  daysLeft: number
  dayOfMonth: number
  week: Spend[]
  weekTop: number
  recent: Tx[]
  cards: Card[]
  goals: Goal[]
  saved: number
  contacts: Contact[]

shape Group
  day: string
  label: string
  total: number
  items: Tx[]

shape Reply
  ok: bool
  error: string

keyframes rise
  from opacity=0 translate="0px 16px"

keyframes ringIn
  from stroke-dashoffset=100

keyframes drift
  from translate="0px 0px" scale=1
  to translate="-28px 18px" scale=1.16

keyframes grow
  from translate="-100% 0px"

keyframes lift
  from translate="0px 100%"

keyframes draw
  from stroke-dashoffset=1

// The look, named once so the design editor shows each as a shared style.
style Card
  display="flex"
  flex-direction="column"
  box-sizing="border-box"
  min-width=0
  padding=20
  border-radius=28
  background-color="card"
  border="1px solid line"
  box-shadow="0 1px 2px glass-shade, 0 24px 48px -32px glass-shade"

style Glass
  backgroundMaterial="glass"
  background-color="glass"
  backdrop-filter="blur(30px) saturate(1.8)"
  border="1px solid glass-edge"
  box-shadow="inset 0 1px 0 glass-edge, 0 24px 60px -32px glass-shade"

style Tile
  display="flex"
  align-items="center"
  justify-content="center"
  flex-shrink=0
  width=44
  height=44
  border-radius=14

style Round
  display="flex"
  align-items="center"
  justify-content="center"
  flex-shrink=0
  width=36
  height=36
  padding=0
  border-width=0
  border-radius=18
  font-size="min(-exact-subheadline, 20px)"

style Pill
  display="flex"
  align-items="center"
  justify-content="center"
  gap=8
  min-height=56
  padding="12px 24px"
  text-align="center"
  border-width=0
  border-radius=28
  background-color="cta"
  background-image="linear-gradient(135deg, var(--cta) 0%, var(--cta-2) 100%)"
  color="on-accent"
  font-size="min(-exact-body, 30px)"
  font-weight=700
  box-shadow="0 16px 32px -14px cta"

style Chip
  display="flex"
  align-items="center"
  gap=6
  min-height=32
  padding="4px 12px 4px 10px"
  border-width=0
  border-radius=16
  font-size="min(-exact-footnote, 30px)"
  font-weight=650

style GlassChip
  display="flex"
  align-items="center"
  gap=6
  min-height=36
  padding="6px 14px 6px 12px"
  border-radius=18
  font-size="0.875rem"
  font-weight=650
  backgroundMaterial="glass"
  background-color="glass"
  backdrop-filter="blur(30px) saturate(1.8)"
  border="1px solid glass-edge"
  box-shadow="inset 0 1px 0 glass-edge, 0 10px 30px -18px glass-shade"

style Num
  font-variant-numeric="tabular-nums"
  font-weight=700
  letter-spacing="-0.4px"

style Caption
  font-size="0.8125rem"
  color="ink-2"

style Eyebrow
  font-size="0.75rem"
  font-weight=700
  letter-spacing="0.8px"
  color="ink-2"

// A deep link `web+lumen://cards` arrives as `/open?u=<the whole link>`. Its route is the
// text after the scheme, with any authority slashes folded into one leading slash.
fn linkPath(u: string): string = u.startsWith("web+lumen:") ? folded(u.slice(10)) : "/"
fn folded(rest: string): string = rest.startsWith("///") ? rest.slice(2) : rest.startsWith("//") ? `/${rest.slice(2)}` : rest.startsWith("/") ? rest : `/${rest}`
fn absolute(c: number): number = max(c, 0 - c)
fn money(c: number): string = formatNumber(c / 100, "currency", "USD")
fn signed(c: number): string = c > 0 ? `+${money(c)}` : money(c)
fn whole(c: number): string = `${c < 0 ? "-" : ""}$${formatNumber(floor(absolute(c) / 100), "decimal")}`
fn centsOf(c: number): string = `.${round(absolute(c) - floor(absolute(c) / 100) * 100) < 10 ? "0" : ""}${round(absolute(c) - floor(absolute(c) / 100) * 100)}`
fn rounded(c: number): string = `${c < 0 ? "-" : ""}$${formatNumber(round(absolute(c) / 100), "decimal")}`
fn veil(hidden: bool, s: string): string = hidden ? "••••••" : s
fn count(n: number, one: string, many: string): string = `${n} ${n == 1 ? one : many}`
fn frac(part: number, whole: number): number = whole <= 0 ? 0 : max(0, min(1, part / whole))
fn pct(part: number, whole: number): string = `${round(frac(part, whole) * 100)}%`
fn topOf(xs: number[]): number = match first(sortBy(xs, x => x, "desc")) { case some(x) => x, case none => 0 }
fn hourOf(ms: number, offset: number): number = floor(ms / 3600000 + offset / 60) - 24 * floor((ms / 3600000 + offset / 60) / 24)
fn greeting(hour: number): string = hour < 5 ? "Good evening" : hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening"
fn firstName(name: string): string = match name.split(" ").at(0) { case some(w) => w, case none => name }
fn initials(name: string): string = name.split(" ").map(w => w.slice(0, 1)).join("").slice(0, 2).toUpperCase()
fn catTitle(id: string): string = id == "dining" ? "Dining" : id == "groceries" ? "Groceries" : id == "transport" ? "Transport" : id == "shopping" ? "Shopping" : id == "bills" ? "Bills" : id == "fun" ? "Entertainment" : id == "health" ? "Health" : id == "income" ? "Income" : id == "transfer" ? "Transfer" : "Other"
fn catIcon(id: string): string = id == "dining" ? "symbol:icon.dining" : id == "groceries" ? "symbol:icon.groceries" : id == "transport" ? "symbol:icon.transport" : id == "shopping" ? "symbol:icon.shopping" : id == "bills" ? "symbol:icon.bills" : id == "fun" ? "symbol:icon.fun" : id == "health" ? "symbol:icon.health" : id == "income" ? "symbol:icon.receive" : "symbol:icon.send"
fn catTint(id: string): string = id == "dining" ? "amber" : id == "groceries" ? "mint" : id == "transport" ? "sky" : id == "shopping" ? "rose" : id == "bills" ? "grape" : id == "fun" ? "flame" : id == "health" ? "tide" : id == "income" ? "mint" : "accent"
fn goalIcon(icon: string): string = `symbol:icon.${icon}`
fn amountTint(c: number): string = c > 0 ? "mint" : "ink"
fn typedCents(typed: string): number = match parseNumber(typed == "" ? "0" : typed.endsWith(".") ? typed.slice(0, typed.length - 1) : typed) { case some(n) => round(n * 100), case none => 0 }
fn typedShown(typed: string): string = typed == "" ? "0" : typed

component App
  resource viewport = exactViewport() as shape Viewport
  resource time = exactTime() as shape Time
  state now = 0
  derive today = formatDate(time.epochAtZero + now, time.utcOffset, "iso")
  resource board = loadBoard(today) as shape Board else empty()
  state query = ""
  state filter = "all"
  resource groups = loadActivity(today, query, filter) as shape Group[] else empty()
  state txId = ""
  resource tx = loadTx(today, txId) as shape Tx else empty()
  mutation sent as shape Reply queue refreshes board, groups, tx then afterSend
  mutation moved as shape Reply queue refreshes board, groups, tx then afterMove
  mutation changed as shape Reply queue refreshes board, groups, tx
  state hidden = false persist
  state cardId = "metal"
  state payee = "maya"
  state typed = ""
  state note = ""
  state goalId = "japan"
  state addCents = 10000
  state alerts = true persist
  state faceId = true persist
  derive w = viewport.width
  derive cols = (w >= 900 ? w - 240 : w) >= 1040 ? 3 : (w >= 900 ? w - 240 : w) >= 640 ? 2 : 1
  derive phone = w < 600
  derive pad = w < 600 ? 16 : 32
  derive still = viewport.prefersReducedMotion
  derive flow = top(nav).name == "welcome"
  derive hello = `${greeting(hourOf(time.epochAtZero + now, time.utcOffset))}, ${board.profile.first}`
  derive sendCents = typedCents(typed)
  derive sendError = match sent { case some(r) => r.error, case none => "" }
  derive moveError = match moved { case some(r) => r.error, case none => "" }
  derive card = match first(board.cards.filter(c => c.id == cardId)) { case some(c) => c, case none => Card(id="", name="", number="", network="", kind="", style="midnight", limit=0, expires="", spent=0, frozen=false, holder="") }
  derive goal = match first(board.goals.filter(g => g.id == goalId)) { case some(g) => g, case none => Goal(id="", name="", icon="target", tint="tide", target=0, saved=0, due="", monthly=0) }
  derive person = match first(board.contacts.filter(c => c.id == payee)) { case some(c) => c, case none => Contact(id="", name="", handle="", tint="accent") }
  derive checking = match first(board.accounts.filter(a => a.id == "checking")) { case some(a) => a.balance, case none => 0 }
  task tick mount
    every(60000, step)
  // A link opens `/open` first, cold or warm; this leaves it for the route it names.
  task deepLink when top(nav).name == "opening"
    after(1, followLink)
  action step
    now = performanceNow()
  action follow(url: string)
    nav = go(nav, url)
  action back
    nav = back(nav)
  action followLink
    nav = open(back(nav), linkPath(searchParam(top(nav), "u")))
  action pick(tab: string)
    nav = select(nav, tab)
  action toggleHidden
    hidden = not hidden
  action search(v: string)
    query = v
  action setFilter(f: string)
    filter = f
  action openTx(id: string)
    txId = id
    nav = go(nav, path("transaction"))
  action openProfile
    nav = go(nav, path("profile"))
  action openSend(who: string)
    payee = who
    typed = ""
    note = ""
    nav = go(nav, path("send"))
  action choosePayee(who: string)
    payee = who
  action key(k: string)
    if k == "del"
      typed = typed.slice(0, max(0, typed.length - 1))
    else if k == "."
      if not typed.includes(".")
        typed = typed == "" ? "0." : `${typed}.`
    else if typed.includes(".")
      if typed.length - typed.indexOf(".") <= 2
        typed = `${typed}${k}`
    else if typed == "0"
      typed = k
    else if typed.length < 5
      typed = `${typed}${k}`
  action editNote(v: string)
    note = v
  action pay
    send sent = sendMoney(today, payee, sendCents, note, formatTime(time.epochAtZero + performanceNow(), time.utcOffset, "short"))
  action afterSend
    if sendError == ""
      typed = ""
      nav = back(nav)
  action openDeposit(id: string)
    goalId = id
    addCents = 10000
    nav = go(nav, path("deposit"))
  action chooseGoal(id: string)
    goalId = id
  action setAdd(c: number)
    addCents = c
  action nudgeAdd(by: number)
    addCents = max(1000, min(500000, addCents + by))
  action deposit
    send moved = moveToGoal(today, goalId, addCents, formatTime(time.epochAtZero + performanceNow(), time.utcOffset, "short"))
  action afterMove
    if moveError == ""
      nav = back(nav)
  action chooseCard(id: string)
    cardId = id
  action freeze(on: bool)
    send changed = setFrozen(today, cardId, on)
  action setAlerts(on: bool)
    alerts = on
  action setFaceId(on: bool)
    faceId = on
  action welcome
    nav = go(nav, path("welcome"))
  // Leaving the welcome pops whichever tab it was opened on, then shows Home.
  action begin
    nav = select(select(nav, nav.tab), "home")
  action reset
    send changed = resetDemo(today)
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" display="flex" flex-direction="column" background-color="page" color="ink" font-family="system-ui" testId="app"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              if e.name == "home" or e.name == "activity" or e.name == "cards" or e.name == "budgets" or e.name == "goals"
                column navigationKey=`${e.id}` navigationScroll=`content-${e.id}` navigationBar="none" position="absolute" inset=0 background-color="page" background-image=(e.name == "home" ? "radial-gradient(120% 460px at 50% 0%, var(--accent-soft) 0%, transparent 100%)" : e.name == "activity" ? "radial-gradient(120% 420px at 50% 0%, var(--sky-soft) 0%, transparent 100%)" : e.name == "cards" ? "radial-gradient(120% 420px at 50% 0%, var(--grape-soft) 0%, transparent 100%)" : e.name == "budgets" ? "radial-gradient(120% 420px at 50% 0%, var(--amber-soft) 0%, transparent 100%)" : "radial-gradient(120% 420px at 50% 0%, var(--tide-soft) 0%, transparent 100%)")
                  scroll id=`content-${e.id}` flex=1 min-height=0
                    column width="100%" max-width="77.5rem" box-sizing="border-box" margin-left="auto" margin-right="auto" padding-left=pad padding-right=pad padding-bottom=(phone ? 120 : 48) gap=18
                      if e.name == "home"
                        HomeView(b=board, cols=cols, phone=phone, still=still, hello=hello, hidden=hidden, toggleHidden=toggleHidden, pick=pick, openSend=openSend, openTx=openTx, openProfile=openProfile, openDeposit=openDeposit)
                      else if e.name == "activity"
                        ActivityView(b=board, groups=groups, query=query, filter=filter, loading=(not current(groups)), phone=phone, search=search, setFilter=setFilter, openTx=openTx)
                      else if e.name == "cards"
                        CardsView(b=board, card=card, cols=cols, phone=phone, still=still, busy=pending(changed), chooseCard=chooseCard, freeze=freeze)
                      else if e.name == "budgets"
                        BudgetsView(b=board, cols=cols, phone=phone, still=still)
                      else
                        GoalsView(b=board, cols=cols, phone=phone, still=still, openDeposit=openDeposit)
              if e.name == "transaction"
                column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll=`content-${e.id}` navigationDetent="large" position="absolute" inset=0 background-color="page"
                  header appearance="none" display="flex" flex-direction="column" padding="20px 20px 8px" background-color="page"
                    SheetTitle(icon="symbol:icon.receipt", tint="accent", title="Payment", detail=tx.date)
                      button id="back" press=back class=Round background-color="card-2" color="ink" aria-label="Close" testId="tx-close"
                        image "symbol:icon.close" font-size="min(-exact-subheadline, 18px)"
                  scroll id=`content-${e.id}` flex=1 min-height=0
                    Receipt(t=tx, still=still, again=openSend)
              if e.name == "send"
                column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll=`content-${e.id}` navigationDetent="large" position="absolute" inset=0 background-color="page"
                  header appearance="none" display="flex" flex-direction="column" padding="20px 20px 12px" background-color="page"
                    SheetTitle(icon="symbol:icon.send", tint="accent", title="Send money", detail=`From Everyday · ${money(checking)} available`)
                      button id="back" press=back class=Round background-color="card-2" color="ink" aria-label="Close" testId="send-close"
                        image "symbol:icon.close" font-size="min(-exact-subheadline, 18px)"
                  scroll id=`content-${e.id}` flex=1 min-height=0
                    SendForm(contacts=board.contacts, payee=payee, typed=typed, note=note, error=sendError, phone=phone, choose=choosePayee, key=key, editNote=editNote)
                  column width="100%" max-width="30rem" box-sizing="border-box" margin-left="auto" margin-right="auto" padding="10px 20px 20px"
                    button press=pay class=Pill disabled=(sendCents < 100 or pending(sent)) opacity=(sendCents < 100 or pending(sent) ? 0.5 : 1) testId="send-confirm"
                      image "symbol:icon.send" aria-hidden=true
                      text (sendCents < 100 ? "Enter an amount" : `Send ${money(sendCents)} to ${firstName(person.name)}`)
              if e.name == "deposit"
                column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll=`content-${e.id}` navigationDetent="large" position="absolute" inset=0 background-color="page"
                  header appearance="none" display="flex" flex-direction="column" padding="20px 20px 12px" background-color="page"
                    SheetTitle(icon=goalIcon(goal.icon), tint=goal.tint, title="Add to a goal", detail=`${goal.name} · ${money(goal.saved)} of ${money(goal.target)}`)
                      button id="back" press=back class=Round background-color="card-2" color="ink" aria-label="Close" testId="deposit-close"
                        image "symbol:icon.close" font-size="min(-exact-subheadline, 18px)"
                  scroll id=`content-${e.id}` flex=1 min-height=0
                    DepositForm(goals=board.goals, goal=goal, cents=addCents, checking=checking, error=moveError, still=still, choose=chooseGoal, set=setAdd, nudge=nudgeAdd)
                  column width="100%" max-width="30rem" box-sizing="border-box" margin-left="auto" margin-right="auto" padding="10px 20px 20px"
                    button press=deposit class=Pill disabled=pending(moved) testId="deposit-confirm"
                      image "symbol:icon.plus" aria-hidden=true
                      text `Add ${money(addCents)}`
              if e.name == "profile"
                column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll=`content-${e.id}` navigationDetent="large" position="absolute" inset=0 background-color="page" overflow="hidden"
                  header appearance="none" display="flex" flex-direction="column" padding="20px 20px 8px" background-color="page"
                    SheetTitle(icon="symbol:icon.person", tint="accent", title="Account", detail=`${board.profile.plan} · ${board.profile.since}`)
                      button id="back" press=back class=Round background-color="card-2" color="ink" aria-label="Close" testId="profile-close"
                        image "symbol:icon.close" font-size="min(-exact-subheadline, 18px)"
                  scroll id=`content-${e.id}` flex=1 min-height=0
                    ProfileView(b=board, still=still, alerts=alerts, faceId=faceId, setAlerts=setAlerts, setFaceId=setFaceId)
                      column class=Card gap=0 padding="4px 20px"
                        button press=welcome appearance="none" display="flex" align-items="center" gap=14 padding="14px 0" border-width=0 background-color="transparent" color="ink" text-align="left" testId="replay-welcome"
                          column class=Tile width=34 height=34 border-radius=11 background-color="accent-soft" color="accent"
                            image "symbol:icon.sparkle" font-size="min(-exact-callout, 20px)" aria-hidden=true
                          text "Replay welcome" flex=1 font-size="1rem" font-weight=600
                          image "symbol:icon.next" color="ink-3" font-size="0.8125rem" aria-hidden=true
                        button commandfor="reset-demo" command="show-modal" appearance="none" display="flex" align-items="center" gap=14 padding="14px 0" border-width=0 border-top="1px solid line" background-color="transparent" color="flame" text-align="left" testId="reset"
                          column class=Tile width=34 height=34 border-radius=11 background-color="flame-soft" color="flame"
                            image "symbol:icon.refresh" font-size="min(-exact-callout, 20px)" aria-hidden=true
                          text "Reset demo data" flex=1 font-size="1rem" font-weight=600
                      dialog id="reset-demo" role="alertdialog" aria-label="Reset demo data?"
                        text "Balances, goals and the payments you made return to the sample."
                        button press=reset destructive=true commandfor="reset-demo" command="close" testId="confirm-reset"
                          text "Reset"
                        button commandfor="reset-demo" command="close"
                          text "Cancel"
              if e.name == "opening"
                column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 background-color="page" testId="opening"
              if e.name == "welcome"
                column navigationKey=`${e.id}` navigationPresentation="fullscreen" navigationBar="none" position="absolute" inset=0 background-color="page" overflow="hidden"
                  Aurora(kind="bloom", still=still)
                  scroll flex=1 min-height=0 position="relative"
                    Welcome(phone=phone, still=still, begin=begin)
      row role="tablist" display=(flow ? "none" : "flex") testId="tabs"
        button role="tab" aria-controls="panel-home" aria-selected=(nav.tab == "home") press=pick("home") testId="tab-home" flex=1
          image "symbol:icon.home"
          text "Home"
        button role="tab" aria-controls="panel-activity" aria-selected=(nav.tab == "activity") press=pick("activity") testId="tab-activity" flex=1
          image "symbol:icon.swap"
          text "Activity"
        button role="tab" aria-controls="panel-cards" aria-selected=(nav.tab == "cards") press=pick("cards") testId="tab-cards" flex=1
          image "symbol:icon.card"
          text "Cards"
        button role="tab" aria-controls="panel-budgets" aria-selected=(nav.tab == "budgets") press=pick("budgets") testId="tab-budgets" flex=1
          image "symbol:icon.pie"
          text "Budgets"
        button role="tab" aria-controls="panel-goals" aria-selected=(nav.tab == "goals") press=pick("goals") testId="tab-goals" flex=1
          image "symbol:icon.target"
          text "Goals"

// Soft colour behind glass: three drifting pools of light. The glass is drawn as this
// layer's next sibling, which is how the Mac samples a backdrop too.
component Aurora
  props
    kind: string
    still: bool
  view
    column position="absolute" inset=-40 aria-hidden=true animation=(still ? "none" : "drift 18s ease-in-out infinite alternate") background-image=(kind == "mint" ? "radial-gradient(55% 45% at 18% 18%, var(--aura-4) 0%, transparent 100%), radial-gradient(50% 50% at 86% 22%, var(--aura-3) 0%, transparent 100%), radial-gradient(70% 55% at 55% 100%, var(--aura-1) 0%, transparent 100%)" : kind == "dusk" ? "radial-gradient(55% 45% at 18% 18%, var(--aura-2) 0%, transparent 100%), radial-gradient(50% 50% at 86% 22%, var(--aura-5) 0%, transparent 100%), radial-gradient(70% 55% at 55% 100%, var(--aura-1) 0%, transparent 100%)" : kind == "dawn" ? "radial-gradient(55% 45% at 18% 18%, var(--aura-6) 0%, transparent 100%), radial-gradient(50% 50% at 86% 22%, var(--aura-5) 0%, transparent 100%), radial-gradient(70% 55% at 55% 100%, var(--aura-2) 0%, transparent 100%)" : kind == "bloom" ? "radial-gradient(55% 45% at 18% 18%, var(--aura-1) 0%, transparent 100%), radial-gradient(50% 50% at 86% 22%, var(--aura-5) 0%, transparent 100%), radial-gradient(70% 55% at 55% 100%, var(--aura-3) 0%, transparent 100%)" : "radial-gradient(55% 45% at 18% 18%, var(--aura-1) 0%, transparent 100%), radial-gradient(50% 50% at 86% 22%, var(--aura-2) 0%, transparent 100%), radial-gradient(70% 55% at 55% 100%, var(--aura-3) 0%, transparent 100%)")

component Ring
  props
    size: number
    width: number
    fraction: number
    from: string
    to: string
    track: string
    gid: string
    still: bool
  slot
  view
    column position="relative" width=size height=size flex-shrink=0 align-items="center" justify-content="center"
      svg position="absolute" left=0 top=0 width=size height=size viewBox=`0 0 ${size} ${size}` aria-hidden=true
        defs
          linearGradient id=gid x1="0%" y1="0%" x2="100%" y2="100%"
            stop offset="0%" stop-color=from
            stop offset="100%" stop-color=to
        circle cx=(size / 2) cy=(size / 2) r=((size - width) / 2) fill="none" stroke=track stroke-width=width
        if fraction > 0
          circle cx=(size / 2) cy=(size / 2) r=((size - width) / 2) fill="none" stroke=`url(#${gid})` stroke-width=width stroke-linecap="round" pathLength=100 stroke-dasharray="100 100" stroke-dashoffset=(100 - min(1, fraction) * 100) transform=`rotate(-90 ${size / 2} ${size / 2})` animation=(still ? "none" : "ringIn 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) both")
      column position="relative" align-items="center"
        children

component TopBar
  props
    eyebrow: string
    title: string
    phone: bool
  slot
  view
    row flex-wrap="wrap" align-items="flex-end" gap=12 padding-top=(phone ? 14 : 40) padding-bottom=2
      column flex="1 1 12rem" min-width=0 gap=4
        text eyebrow class=Eyebrow
        if phone
          text title role="heading" aria-level=1 font-size="min(-exact-title1, 46px)" font-weight=800 letter-spacing="-1px" line-height=1.2
        else
          text title role="heading" aria-level=1 font-size="min(-exact-large-title, 56px)" font-weight=800 letter-spacing="-1px" line-height=1.2
      children

component Head
  props
    title: string
    detail: string
  view
    row flex-wrap="wrap" align-items="baseline" column-gap=8 row-gap=2 flex="1 1 auto" min-width=0
      text title role="heading" aria-level=2 flex="1 1 8rem" font-size="1.125rem" font-weight=700 letter-spacing="-0.3px"
      text detail class=Caption

component CatTile
  props
    category: string
    size: number
  view
    column class=Tile width=size height=size border-radius=(size * 0.32) background-color=`${catTint(category)}-soft` color=catTint(category)
      if size >= 56
        image catIcon(category) font-size="min(-exact-title1, 34px)" aria-hidden=true
      else
        image catIcon(category) font-size="min(-exact-body, 22px)" aria-hidden=true

component Avatar
  props
    name: string
    tint: string
    size: number
  view
    column width=size height=size flex-shrink=0 border-radius=(size / 2) align-items="center" justify-content="center" background-color=`${tint}-soft` color=tint
      if size >= 56
        text initials(name) class=Num font-size="min(-exact-title3, 26px)" aria-hidden=true
      else
        text initials(name) class=Num font-size="min(-exact-subheadline, 18px)" aria-hidden=true

component TxRow
  props
    t: Tx
    first: bool
    scope: string
    open: action
  view
    button press=open(t.id) appearance="none" display="flex" flex-wrap="wrap" align-items="center" column-gap=14 row-gap=4 padding="12px 0" border-width=0 border-top=(first ? "none" : "1px solid line") background-color="transparent" color="ink" text-align="left" testId=`${scope}-${t.id}`
      if t.category == "transfer"
        Avatar(name=t.merchant, tint="accent", size=44)
      else
        CatTile(category=t.category, size=44)
      column flex="1 1 9rem" min-width=0 gap=2
        text t.merchant font-size="1rem" font-weight=650 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        text `${catTitle(t.category)} · ${t.when}` class=Caption white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      column align-items="flex-end" gap=2 margin-left="auto"
        text signed(t.amount) class=Num font-size="1rem" color=amountTint(t.amount) testId=`${scope}-amount-${t.id}`
        if t.status == "Pending"
          text "Pending" font-size="0.6875rem" font-weight=650 color="amber"

component HomeView
  props
    b: Board
    cols: number
    phone: bool
    still: bool
    hello: string
    hidden: bool
    toggleHidden: action
    pick: action
    openSend: action
    openTx: action
    openProfile: action
    openDeposit: action
  view
    column gap=18
      TopBar(eyebrow=b.label.toUpperCase(), title=hello, phone=phone)
        button press=openProfile appearance="none" width=44 height=44 padding=0 border-radius=22 border="2px solid glass-edge" background-image="linear-gradient(135deg, var(--cta) 0%, var(--cta-2) 100%)" color="on-accent" box-shadow="0 10px 24px -12px cta" aria-label="Account" testId="open-profile"
          text initials(b.profile.name) class=Num font-size="min(-exact-subheadline, 18px)"
      if cols == 1
        Worth(b=b, wide=false, still=still, hidden=hidden, toggle=toggleHidden)
        Actions(b=b, openSend=openSend, openDeposit=openDeposit, pick=pick)
        Accounts(items=b.accounts, hidden=hidden)
        Spending(b=b, still=still, pick=pick)
        Recent(items=b.recent, pick=pick, open=openTx)
      else
        row gap=18 align-items="flex-start"
          column flex=3 min-width=0 gap=18
            Worth(b=b, wide=true, still=still, hidden=hidden, toggle=toggleHidden)
            Recent(items=b.recent, pick=pick, open=openTx)
          column flex=2 min-width=0 gap=18
            Actions(b=b, openSend=openSend, openDeposit=openDeposit, pick=pick)
            Accounts(items=b.accounts, hidden=hidden)
            Spending(b=b, still=still, pick=pick)

// The focal point: net worth and its month, on glass over an indigo aurora.
component Worth
  props
    b: Board
    wide: bool
    still: bool
    hidden: bool
    toggle: action
  view
    column position="relative" border-radius=34 overflow="hidden" testId="worth" animation=(still ? "none" : "rise 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both")
      Aurora(kind="indigo", still=still)
      column position="relative" class=Glass margin=8 border-radius=28 padding=(wide ? 28 : 22) gap=14
        row flex-wrap="wrap" align-items="center" gap=10
          row class=Chip flex-shrink=1 min-width=0 background-color="glass-strong" color="accent"
            image "symbol:icon.wallet" aria-hidden=true
            text "Net worth" color="ink"
          button press=toggle margin-left="auto" class=Round background-color="glass-strong" color="ink-2" aria-label=(hidden ? "Show balances" : "Hide balances") testId="toggle-hidden"
            image "symbol:icon.eye" font-size="min(-exact-callout, 20px)"
        row align-items="baseline" gap=0 min-width=0
          text veil(hidden, whole(b.net)) class=Num font-size=(wide ? "3.5rem" : "2.875rem") letter-spacing="-2px" line-height=1.2 -exact-fit="shrink" white-space="nowrap" flex="0 1 auto" min-width=0 testId="net"
          if not hidden
            if wide
              text centsOf(b.net) class=Num font-size="min(-exact-title1, 36px)" color="ink-2" letter-spacing="-0.5px" flex-shrink=0
            else
              text centsOf(b.net) class=Num font-size="min(-exact-title2, 32px)" color="ink-2" letter-spacing="-0.5px" flex-shrink=0
        row align-items="center" gap=8 flex-wrap="wrap"
          row class=Chip background-color=(b.change >= 0 ? "mint-soft" : "flame-soft") color=(b.change >= 0 ? "mint" : "flame")
            image (b.change >= 0 ? "symbol:icon.up" : "symbol:icon.down") aria-hidden=true
            text veil(hidden, signed(b.change)) testId="change"
          text "in the last 30 days" class=Caption font-weight=600
        svg width="100%" height=(wide ? 120 : 96) viewBox="0 0 300 96" preserveAspectRatio="none" aria-hidden=true
          defs
            linearGradient id="worth-fill" x1="0%" y1="0%" x2="0%" y2="100%"
              stop offset="0%" stop-color="accent" stop-opacity=0.32
              stop offset="100%" stop-color="accent" stop-opacity=0
          path d=b.area fill="url(#worth-fill)"
          path d=b.spark fill="none" stroke="accent" stroke-width=2.5 stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" pathLength=1 stroke-dasharray="1 1" animation=(still ? "none" : "draw 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) both")
        row
          text "30 days ago" flex=1 font-size="0.6875rem" color="ink-2"
          text "Today" font-size="0.6875rem" font-weight=700 color="ink"

component Actions
  props
    b: Board
    openSend: action
    openDeposit: action
    pick: action
  view
    row flex-wrap="wrap" gap=10 testId="actions"
      Action(icon="symbol:icon.send", label="Send", tint="accent", press=openSend("maya"), id="send")
      Action(icon="symbol:icon.target", label="Save", tint="tide", press=openDeposit("japan"), id="save")
      Action(icon="symbol:icon.card", label="Cards", tint="grape", press=pick("cards"), id="cards")
      Action(icon="symbol:icon.pie", label="Budgets", tint="amber", press=pick("budgets"), id="budgets")

component Action
  props
    icon: string
    label: string
    tint: string
    press: action
    id: string
  view
    button press=press appearance="none" flex="1 1 4.5rem" min-width=0 display="flex" flex-direction="column" align-items="center" gap=8 padding="14px 4px 12px" border-radius=22 class=Glass color="ink" testId=`action-${id}`
      column class=Tile width=42 height=42 border-radius=21 background-color=`${tint}-soft` color=tint
        image icon font-size="min(-exact-body, 22px)" aria-hidden=true
      text label font-size="0.8125rem" font-weight=650 text-align="center"

component Accounts
  props
    items: Account[]
    hidden: bool
  view
    column class=Card gap=4 testId="accounts"
      Head(title="Accounts", detail=`${items.length} linked`)
      for a, i in items key=a.id
        row flex-wrap="wrap" align-items="center" column-gap=14 row-gap=4 padding-top=12 padding-bottom=12 border-top=(i == 0 ? "none" : "1px solid line")
          column class=Tile background-color=`${a.tint}-soft` color=a.tint
            image `symbol:icon.${a.icon}` font-size="min(-exact-title3, 26px)" aria-hidden=true
          column flex="1 1 9rem" min-width=0 gap=2
            text a.name font-size="1rem" font-weight=650
            text `${a.kind} ${a.number}` class=Caption white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          text veil(hidden, money(a.balance)) class=Num font-size="1rem" margin-left="auto" color=(a.balance < 0 ? "flame" : "ink") testId=`balance-${a.id}`

component Spending
  props
    b: Board
    still: bool
    pick: action
  view
    column class=Card gap=16 testId="spending"
      row flex-wrap="wrap" align-items="center" gap=8
        Head(title=`Spent in ${b.month}`, detail="")
        button press=pick("budgets") appearance="none" display="flex" align-items="center" gap=4 padding=0 border-width=0 background-color="transparent" color="accent-ink" font-size="0.875rem" font-weight=600 testId="see-budgets"
          text "Budgets"
          image "symbol:icon.next" font-size="0.75rem" aria-hidden=true
      row flex-wrap="wrap" align-items="baseline" column-gap=6
        text money(b.spent) class=Num font-size="min(-exact-title1, 40px)" letter-spacing="-1px" white-space="nowrap" testId="month-spent"
        text `of ${rounded(b.budget)}` class=Caption
      row height=12 gap=3 border-radius=6 overflow="hidden" background-color="card-2"
        for c in b.categories.filter(x => x.spent > 0) key=c.id
          column height="100%" width=`${c.share * frac(b.spent, b.budget)}%` background-color=catTint(c.id) animation=(still ? "none" : "grow 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both")
      row flex-wrap="wrap" gap=14 row-gap=8
        for c in sortBy(b.categories, x => x.spent, "desc").slice(0, 4) key=c.id
          row align-items="center" gap=6
            column width=8 height=8 border-radius=4 background-color=catTint(c.id)
            text catTitle(c.id) class=Caption font-weight=600
            text rounded(c.spent) class=Caption

component Recent
  props
    items: Tx[]
    pick: action
    open: action
  view
    column class=Card gap=4 testId="recent"
      row flex-wrap="wrap" align-items="center" gap=8 padding-bottom=4
        Head(title="Recent activity", detail="")
        button press=pick("activity") appearance="none" display="flex" align-items="center" gap=4 padding=0 border-width=0 background-color="transparent" color="accent-ink" font-size="0.875rem" font-weight=600 testId="see-activity"
          text "See all"
          image "symbol:icon.next" font-size="0.75rem" aria-hidden=true
      for t, i in items key=t.id
        TxRow(t=t, first=(i == 0), scope="recent", open=open)

component ActivityView
  props
    b: Board
    groups: Group[]
    query: string
    filter: string
    loading: bool
    phone: bool
    search: action
    setFilter: action
    openTx: action
  view
    column gap=18 width="100%" max-width="48rem" margin-left="auto" margin-right="auto"
      TopBar(eyebrow=b.month.toUpperCase(), title="Activity", phone=phone)
      row flex-wrap="wrap" gap=10
        InOut(label="Money in", value=money(b.income), tint="mint", icon="symbol:icon.receive", id="in")
        InOut(label="Money out", value=money(b.spent), tint="flame", icon="symbol:icon.send", id="out")
      row align-items="center" gap=10 min-height=48 padding-left=16 padding-right=8 border-radius=16 class=Glass
        image "symbol:icon.search" color="ink-2" font-size="min(-exact-body, 22px)" aria-hidden=true
        input value=query input=search placeholder="Search payments" aria-label="Search payments" autocomplete="off" enterkeyhint="search" outline="none" flex=1 min-width=0 min-height=46 padding="8px 0" border="none" background-color="transparent" color="ink" font-size="1rem" testId="tx-search"
        if query != ""
          button press=search("") class=Round width=30 height=30 background-color="ink-3" color="page" aria-label="Clear search" testId="clear-search"
            image "symbol:icon.close" font-size="min(-exact-caption1, 16px)"
      row role="radiogroup" aria-label="Show" flex-wrap="wrap" gap=4 padding=4 border-radius=18 background-color="card-2"
        for f in ["all", "spending", "income", "transfers"] key=f
          button role="radio" aria-checked=(filter == f) press=setFilter(f) appearance="none" flex="1 1 5rem" min-width=0 min-height=36 padding="4px 6px" border-width=0 border-radius=14 background-color=(filter == f ? "card" : "transparent") box-shadow=(filter == f ? "0 1px 2px glass-shade, 0 6px 16px -8px glass-shade" : "none") color=(filter == f ? "ink" : "ink-2") font-size="0.8125rem" font-weight=650 testId=`filter-${f}`
            text (f == "all" ? "All" : f == "spending" ? "Spending" : f == "income" ? "Income" : "Transfers") white-space="nowrap"
      if groups.length == 0 and not loading
        EmptyState(symbol="symbol:search", title="No payments", message=(query.trim() == "" ? "Nothing here yet. Payments you make land in this list." : `Nothing matches “${query.trim()}”.`))
      for g in groups key=g.day
        column gap=8 testId=`group-${g.day}`
          row flex-wrap="wrap" align-items="baseline" column-gap=8 padding-left=4 padding-right=4
            text g.label.toUpperCase() class=Eyebrow flex="1 1 8rem"
            text signed(g.total) class=Caption font-variant-numeric="tabular-nums"
          column class=Card gap=0 padding="4px 18px"
            for t, i in g.items key=t.id
              TxRow(t=t, first=(i == 0), scope="tx", open=openTx)

component InOut
  props
    label: string
    value: string
    tint: string
    icon: string
    id: string
  view
    column flex="1 1 9rem" min-width=0 gap=10 padding=16 border-radius=22 class=Card
      row align-items="center" gap=8
        column class=Tile width=28 height=28 border-radius=14 background-color=`${tint}-soft` color=tint
          image icon font-size="min(-exact-subheadline, 18px)" aria-hidden=true
        text label class=Caption font-weight=600
      text value class=Num font-size="min(-exact-title3, 32px)" white-space="nowrap" testId=`month-${id}`

component Receipt
  props
    t: Tx
    still: bool
    again: action
  view
    column width="100%" max-width="32.5rem" box-sizing="border-box" margin-left="auto" margin-right="auto" padding="12px 20px 28px" gap=18
      column position="relative" border-radius=32 overflow="hidden" animation=(still ? "none" : "rise 600ms cubic-bezier(0.2, 0.8, 0.2, 1) both")
        Aurora(kind=(t.amount > 0 ? "mint" : "indigo"), still=still)
        column position="relative" class=Glass margin=8 border-radius=26 padding="26px 20px" gap=12 align-items="center" text-align="center"
          if t.category == "transfer"
            Avatar(name=t.merchant, tint="accent", size=64)
          else
            CatTile(category=t.category, size=64)
          text t.merchant role="heading" aria-level=2 font-size="1.25rem" font-weight=750 testId="tx-merchant"
          text signed(t.amount) class=Num font-size="2.75rem" letter-spacing="-1.5px" -exact-fit="shrink" white-space="nowrap" max-width="100%" color=amountTint(t.amount) testId="tx-amount"
          row class=Chip background-color="glass-strong" color=(t.status == "Pending" ? "amber" : "mint")
            image (t.status == "Pending" ? "symbol:icon.lock" : "symbol:icon.check") aria-hidden=true
            text t.status color="ink" testId="tx-status"
      dl class=Card gap=0 padding="4px 20px" margin=0
        Fact(term="Category", detail=catTitle(t.category), first=true)
        Fact(term="Account", detail=t.account, first=false)
        if t.card != ""
          Fact(term="Card", detail=t.card, first=false)
        if t.note != ""
          Fact(term="Note", detail=t.note, first=false)
        Fact(term="When", detail=t.date, first=false)
        Fact(term="Reference", detail=t.id.toUpperCase().slice(0, 18), first=false)
      if t.category == "transfer" and t.amount < 0
        button press=again("maya") class=GlassChip align-self="center" color="accent-ink" testId="send-again"
          image "symbol:icon.refresh" aria-hidden=true
          text "Send again"

component Fact
  props
    term: string
    detail: string
    first: bool
  view
    row flex-wrap="wrap" align-items="center" column-gap=12 row-gap=2 padding-top=13 padding-bottom=13 border-top=(first ? "none" : "1px solid line")
      dt flex="1 1 7rem" class=Caption font-weight=600
        text term
      dd margin=0 margin-left="auto" font-size="0.9375rem" font-weight=600 text-align="right"
        text detail

component CardsView
  props
    b: Board
    card: Card
    cols: number
    phone: bool
    still: bool
    busy: bool
    chooseCard: action
    freeze: action
  view
    column gap=18
      TopBar(eyebrow=count(b.cards.length, "CARD", "CARDS"), title="Cards", phone=phone)
      column flex-direction=(cols == 1 ? "column" : "row") gap=18 align-items=(cols == 1 ? "stretch" : "flex-start")
        column flex=1 min-width=0 gap=16
          column width="100%" max-width="26.25rem" align-self="center"
            BankCard(c=card, still=still)
          row role="radiogroup" aria-label="Card" gap=10 justify-content="center"
            for c in b.cards key=c.id
              button role="radio" aria-checked=(c.id == card.id) press=chooseCard(c.id) appearance="none" flex="0 1 6.5rem" min-width=0 display="flex" flex-direction="column" gap=6 padding=6 border-radius=16 border=(c.id == card.id ? "2px solid accent" : "2px solid transparent") background-color="transparent" color="ink" testId=`card-${c.id}`
                column height=44 border-radius=9 background-image=(c.style == "midnight" ? "linear-gradient(135deg, var(--midnight-1) 0%, var(--midnight-2) 100%)" : c.style == "iris" ? "linear-gradient(135deg, var(--iris-1) 0%, var(--iris-2) 100%)" : "linear-gradient(135deg, var(--lagoon-1) 0%, var(--lagoon-2) 100%)") opacity=(c.frozen ? 0.45 : 1)
                text c.name font-size="min(-exact-caption2, 15px)" font-weight=650 color=(c.id == card.id ? "ink" : "ink-2") white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="center"
        column flex=1 min-width=0 gap=18
          column class=Card gap=14 testId="card-spend"
            Head(title="This month", detail=card.kind)
            row flex-wrap="wrap" align-items="baseline" column-gap=6
              text money(card.spent) class=Num font-size="min(-exact-title1, 40px)" letter-spacing="-1px" testId="card-spent"
              text `of ${rounded(card.limit)} limit` class=Caption
            column height=10 border-radius=5 background-color="accent-soft" overflow="hidden"
              column height="100%" width=pct(card.spent, card.limit) border-radius=5 background-image="linear-gradient(90deg, var(--accent) 0%, var(--accent-2) 100%)" animation=(still ? "none" : "grow 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both")
            text `${rounded(max(0, card.limit - card.spent))} left to spend this month` class=Caption
          column class=Card gap=0 padding="4px 20px" testId="card-controls"
            row flex-wrap="wrap" align-items="center" column-gap=14 row-gap=8 padding-top=12 padding-bottom=12
              column class=Tile width=34 height=34 border-radius=11 background-color="sky-soft" color="sky"
                image "symbol:icon.freeze" font-size="min(-exact-callout, 20px)" aria-hidden=true
              column flex="1 1 9rem" min-width=0 gap=2
                text "Freeze card" font-size="1rem" font-weight=600
                text (card.frozen ? "Payments are declined until you unfreeze." : "Stop new payments in a tap.") class=Caption
              input type="checkbox" switch checked=card.frozen change=freeze disabled=busy aria-label="Freeze card" testId="freeze"
            CardRow(icon="symbol:icon.lock", tint="grape", label="Card number", value=`•••• ${card.number}`)
            CardRow(icon="symbol:icon.globe", tint="tide", label="Online payments", value=(card.kind == "Virtual" ? "Only online" : "Allowed"))
            CardRow(icon="symbol:icon.shield", tint="mint", label="Expires", value=card.expires)

component CardRow
  props
    icon: string
    tint: string
    label: string
    value: string
  view
    row flex-wrap="wrap" align-items="center" column-gap=14 row-gap=2 padding-top=12 padding-bottom=12 border-top="1px solid line"
      column class=Tile width=34 height=34 border-radius=11 background-color=`${tint}-soft` color=tint
        image icon font-size="min(-exact-callout, 20px)" aria-hidden=true
      text label flex="1 1 8rem" font-size="1rem" font-weight=600
      text value class=Num font-size="0.9375rem" color="ink-2" margin-left="auto"

// A payment card drawn at the ISO card's 1.586 aspect, with a sheen; frozen cards wear frost.
component BankCard
  props
    c: Card
    still: bool
  view
    column position="relative" width="100%" aspect-ratio=1.586 border-radius=24 overflow="hidden" box-shadow="0 30px 60px -30px glass-shade" background-image=(c.style == "midnight" ? "linear-gradient(135deg, var(--midnight-1) 0%, var(--midnight-2) 100%)" : c.style == "iris" ? "linear-gradient(135deg, var(--iris-1) 0%, var(--iris-2) 100%)" : "linear-gradient(135deg, var(--lagoon-1) 0%, var(--lagoon-2) 100%)") color="card-ink" testId="bank-card" animation=(still ? "none" : "rise 600ms cubic-bezier(0.2, 0.8, 0.2, 1) both")
      column position="absolute" inset=0 aria-hidden=true background-image="radial-gradient(80% 60% at 85% 0%, var(--card-sheen) 0%, transparent 100%), radial-gradient(60% 50% at 0% 100%, var(--card-sheen) 0%, transparent 100%)"
      if not c.frozen
        column position="relative" flex=1 padding=22 justify-content="space-between"
          row align-items="center" gap=8
            text "Lumen" font-size="min(-exact-body, 22px)" font-weight=800 letter-spacing="-0.4px" flex=1
            text c.kind.toUpperCase() font-size="min(-exact-caption2, 13px)" font-weight=700 letter-spacing="1.2px" color="card-ink-2"
          column width=42 height=32 border-radius=7 background-image="linear-gradient(135deg, var(--chip-1) 0%, var(--chip-2) 100%)" aria-hidden=true
          column gap=10
            text `••••  ••••  ••••  ${c.number}` class=Num font-size="min(-exact-body, 20px)" white-space="nowrap" letter-spacing="1.5px" testId="card-number"
            row align-items="flex-end" gap=12
              column flex=1 min-width=0 gap=2
                text c.holder font-size="min(-exact-caption1, 14px)" font-weight=650 letter-spacing="1px" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                text `EXP ${c.expires}` font-size="min(-exact-caption2, 13px)" color="card-ink-2"
              text c.network font-size="min(-exact-callout, 20px)" font-weight=800 font-style="italic" letter-spacing="0.5px"
      else
        column position="relative" flex=1 align-items="center" justify-content="center" gap=6 backgroundMaterial="glass" background-color="glass" backdrop-filter="blur(14px) saturate(1.4)" color="ink" testId="frozen"
          image "symbol:icon.freeze" font-size="min(-exact-large-title, 40px)" color="sky" aria-hidden=true
          text "Frozen" font-size="min(-exact-body, 22px)" font-weight=750
          text `${c.name} ·· ${c.number}` font-size="min(-exact-footnote, 16px)" font-weight=600 font-variant-numeric="tabular-nums"

component BudgetsView
  props
    b: Board
    cols: number
    phone: bool
    still: bool
  view
    column gap=18
      TopBar(eyebrow=b.month.toUpperCase(), title="Budgets", phone=phone)
      BudgetHero(b=b, wide=(cols > 1), still=still)
      if cols == 1
        Categories(b=b, still=still)
        Week(b=b, still=still)
      else
        row gap=18 align-items="flex-start"
          column flex=3 min-width=0
            Categories(b=b, still=still)
          column flex=2 min-width=0 gap=18
            Week(b=b, still=still)

component BudgetHero
  props
    b: Board
    wide: bool
    still: bool
  view
    column position="relative" border-radius=34 overflow="hidden" testId="budget-hero" animation=(still ? "none" : "rise 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both")
      Aurora(kind="dawn", still=still)
      column position="relative" class=Glass margin=8 border-radius=28 padding=(wide ? 28 : 22) gap=22 flex-direction=(wide ? "row" : "column") align-items="center"
        column position="relative" width=200 height=200 flex-shrink=0 align-items="center" justify-content="center"
          svg position="absolute" left=0 top=0 width=200 height=200 viewBox="0 0 200 200" aria-hidden=true
            circle cx=100 cy=100 r=86 fill="none" stroke="glass-edge" stroke-width=20
            for c in b.categories.filter(x => x.spent > 0) key=c.id
              circle cx=100 cy=100 r=86 fill="none" stroke=catTint(c.id) stroke-width=20 pathLength=100 stroke-dasharray=`${max(0, c.share * frac(b.spent, b.budget) - 0.8)} 100` stroke-dashoffset=(0 - c.start * frac(b.spent, b.budget)) transform="rotate(-90 100 100)" animation=(still ? "none" : "ringIn 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) both")
          column align-items="center" gap=2
            text rounded(max(0, b.budget - b.spent)) class=Num font-size="min(-exact-large-title, 44px)" letter-spacing="-1.5px" testId="budget-left"
            text (b.spent <= b.budget ? "left to spend" : "over budget") class=Caption font-size="min(-exact-footnote, 16px)" font-weight=600
        column flex=1 width="100%" gap=14
          row flex-wrap="wrap" row-gap=14 gap=12
            Stat(icon="symbol:icon.pie", tint="amber", label="Spent", value=rounded(b.spent))
            Stat(icon="symbol:icon.target", tint="accent", label="Budget", value=rounded(b.budget))
            Stat(icon="symbol:icon.growth", tint="mint", label="Per day", value=rounded(round(max(0, b.budget - b.spent) / max(1, b.daysLeft))))
          column height=1 background-color="glass-edge"
          row align-items="center" gap=10
            image "symbol:icon.sparkle" color="accent" aria-hidden=true
            text (b.spent > b.budget ? "You are over for the month. Pause shopping until the 1st." : frac(b.spent, b.budget) > frac(b.dayOfMonth, b.dayOfMonth + b.daysLeft - 1) ? `Spending is running ahead of the month. ${count(b.daysLeft, "day", "days")} to go.` : `On pace. ${count(b.daysLeft, "day", "days")} left and room to spare.`) flex=1 font-size="0.875rem" line-height=1.4 color="ink-2" testId="budget-pace"

component Stat
  props
    icon: string
    tint: string
    label: string
    value: string
  view
    column flex="1 1 5.5rem" min-width=0 gap=6
      row align-items="center" gap=6
        image icon color=tint font-size="0.875rem" aria-hidden=true
        text label class=Caption font-weight=600
      text value class=Num font-size="1.25rem"

component Categories
  props
    b: Board
    still: bool
  view
    column class=Card gap=4 testId="categories"
      Head(title="Categories", detail=`${b.categories.length} budgets`)
      for c, i in b.categories key=c.id
        column gap=10 padding-top=14 padding-bottom=14 border-top=(i == 0 ? "none" : "1px solid line") testId=`budget-${c.id}`
          row flex-wrap="wrap" align-items="center" column-gap=12 row-gap=4
            CatTile(category=c.id, size=40)
            column flex="1 1 8rem" min-width=0 gap=2
              text catTitle(c.id) font-size="1rem" font-weight=650
              text `${c.count} ${c.count == 1 ? "payment" : "payments"}` class=Caption
            column align-items="flex-end" gap=2 margin-left="auto"
              text rounded(c.spent) class=Num font-size="1rem" color=(c.spent > c.limit ? "flame" : "ink")
              text `of ${rounded(c.limit)}` class=Caption
          column height=8 border-radius=4 background-color=`${catTint(c.id)}-soft` overflow="hidden"
            column height="100%" width=pct(c.spent, c.limit) border-radius=4 background-color=(c.spent > c.limit ? "flame" : catTint(c.id)) animation=(still ? "none" : "grow 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both")

component Week
  props
    b: Board
    still: bool
  view
    column class=Card gap=16 testId="week"
      Head(title="Last 7 days", detail=`avg ${rounded(sum(b.week.map(d => d.spent)) / max(1, b.week.length))} a day`)
      column gap=10
        row height=140 align-items="flex-end" gap=8
          for d, i in b.week key=d.day
            column flex=1 height="100%" justify-content="flex-end" align-items="center" overflow="hidden"
              column width="100%" max-width=30 height=pct(d.spent, max(1, b.weekTop)) min-height=4 border-radius=9 background-color=(i == b.week.length - 1 ? "accent" : "card-2") background-image=(i == b.week.length - 1 ? "linear-gradient(180deg, var(--accent-2) 0%, var(--accent) 100%)" : "none") animation=(still ? "none" : `lift 700ms ${i * 50}ms cubic-bezier(0.2, 0.8, 0.2, 1) both`)
        row gap=8
          for d, i in b.week key=d.day
            text d.label flex=1 min-width=0 text-align="center" font-size="min(-exact-caption1, 15px)" font-weight=(i == b.week.length - 1 ? 700 : 500) color=(i == b.week.length - 1 ? "ink" : "ink-2")

component GoalsView
  props
    b: Board
    cols: number
    phone: bool
    still: bool
    openDeposit: action
  view
    column gap=18
      TopBar(eyebrow=count(b.goals.length, "GOAL", "GOALS"), title="Goals", phone=phone)
        button press=openDeposit("japan") class=GlassChip color="ink" testId="add-money"
          image "symbol:icon.plus" color="tide" aria-hidden=true
          text "Add money"
      column position="relative" border-radius=34 overflow="hidden" testId="goals-hero" animation=(still ? "none" : "rise 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both")
        Aurora(kind="mint", still=still)
        column position="relative" class=Glass margin=8 border-radius=28 padding=22 gap=14
          row class=Chip align-self="flex-start" background-color="glass-strong" color="tide"
            image "symbol:icon.piggy" aria-hidden=true
            text "Saved toward goals" color="ink"
          row align-items="baseline" gap=0 min-width=0
            text whole(b.saved) class=Num font-size="2.75rem" letter-spacing="-2px" -exact-fit="shrink" white-space="nowrap" flex="0 1 auto" min-width=0 testId="goals-saved"
            text centsOf(b.saved) class=Num font-size="min(-exact-title2, 32px)" color="ink-2" flex-shrink=0
          column height=10 border-radius=5 background-color="glass-edge" overflow="hidden"
            column height="100%" width=pct(b.saved, sum(b.goals.map(g => g.target))) border-radius=5 background-image="linear-gradient(90deg, var(--tide) 0%, var(--mint-2) 100%)" animation=(still ? "none" : "grow 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both")
          text `${pct(b.saved, sum(b.goals.map(g => g.target)))} of ${rounded(sum(b.goals.map(g => g.target)))} across ${count(b.goals.length, "goal", "goals")}` class=Caption font-weight=600
      row flex-wrap="wrap" gap=18
        for g in b.goals key=g.id
          GoalCard(g=g, still=still, add=openDeposit)

component GoalCard
  props
    g: Goal
    still: bool
    add: action
  view
    column class=Card flex="1 1 18rem" gap=16 testId=`goal-${g.id}`
      row flex-wrap="wrap" align-items="center" gap=16
        Ring(size=76, width=8, fraction=frac(g.saved, g.target), from=g.tint, to=g.tint, track=`${g.tint}-soft`, gid=`goal-ring-${g.id}`, still=still)
          image goalIcon(g.icon) color=g.tint font-size="min(-exact-title2, 30px)" aria-hidden=true
        column flex="1 1 9rem" min-width=0 gap=4
          text g.name font-size="1.0625rem" font-weight=700
          row flex-wrap="wrap" align-items="baseline" column-gap=4
            text money(g.saved) class=Num font-size="min(-exact-title3, 32px)" testId=`goal-saved-${g.id}`
            text `of ${rounded(g.target)}` class=Caption
          text `${pct(g.saved, g.target)} · by ${g.due}` class=Caption
      row flex-wrap="wrap" align-items="center" gap=10 padding-top=12 border-top="1px solid line"
        image "symbol:icon.sparkle" color=g.tint font-size="0.875rem" aria-hidden=true
        text (g.monthly <= 0 ? "Reached. Nicely done." : `${rounded(g.monthly)} a month gets you there`) flex="1 1 8rem" class=Caption
        button press=add(g.id) class=Chip background-color=`${g.tint}-soft` color=g.tint aria-label=`Add money to ${g.name}` testId=`goal-add-${g.id}`
          image "symbol:icon.plus" aria-hidden=true
          text "Add" color="ink"

// A sheet's own title bar: the subject's icon, a title with a live detail, and a close button.
component SheetTitle
  props
    icon: string
    tint: string
    title: string
    detail: string
  slot
  view
    row width="100%" max-width="40rem" box-sizing="border-box" margin-left="auto" margin-right="auto" align-items="center" gap=14
      column class=Tile width=46 height=46 border-radius=15 background-color=`${tint}-soft` color=tint
        image icon font-size="min(-exact-title2, 28px)" aria-hidden=true
      column flex=1 min-width=0 gap=2
        text title role="heading" aria-level=1 font-size="1.375rem" font-weight=800 letter-spacing="-0.4px"
        text detail class=Caption white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId="sheet-detail"
      children

component SendForm
  props
    contacts: Contact[]
    payee: string
    typed: string
    note: string
    error: string
    phone: bool
    choose: action
    key: action
    editNote: action
  view
    column width="100%" max-width="30rem" box-sizing="border-box" margin-left="auto" margin-right="auto" padding="8px 20px 12px" gap=18
      row role="radiogroup" aria-label="Pay" flex-wrap="wrap" gap=6 justify-content="space-between"
        for c in contacts key=c.id
          button role="radio" aria-checked=(c.id == payee) press=choose(c.id) appearance="none" flex="1 1 3.75rem" min-width=0 display="flex" flex-direction="column" align-items="center" gap=6 padding="8px 2px" border-radius=18 border-width=0 background-color=(c.id == payee ? "accent-soft" : "transparent") color="ink" testId=`payee-${c.id}`
            column border-radius=28 border=(c.id == payee ? "2px solid accent" : "2px solid transparent")
              Avatar(name=c.name, tint=c.tint, size=48)
            text firstName(c.name) max-width="100%" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" font-weight=(c.id == payee ? 700 : 550) color=(c.id == payee ? "ink" : "ink-2") white-space="nowrap"
      column align-items="center" gap=4 padding="6px 0"
        row align-items="baseline" justify-content="center" gap=2 max-width="100%"
          text "$" class=Num font-size="min(-exact-large-title, 40px)" color=(typed == "" ? "ink-3" : "ink-2") flex-shrink=0
          text typedShown(typed) class=Num font-size="4rem" letter-spacing="-2.5px" line-height=1.2 -exact-fit="shrink" white-space="nowrap" flex="0 1 auto" min-width=0 color=(typed == "" ? "ink-3" : "ink") testId="send-amount"
        input value=note input=editNote placeholder="Add a note" aria-label="Note" maxlength=80 autocomplete="off" outline="none" width="100%" max-width="16rem" min-height=36 padding="6px 0" border="none" background-color="transparent" color="ink" font-size="0.9375rem" text-align="center" testId="send-note"
      if error != ""
        text error role="alert" color="flame" font-size="0.875rem" text-align="center" testId="send-error"
      column gap=8 role="group" aria-label="Amount keypad"
        for r in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"], [".", "0", "del"]] key=r.join("")
          row gap=8
            for k in r key=k
              button press=key(k) appearance="none" flex=1 min-width=0 min-height=(phone ? 54 : 58) display="flex" align-items="center" justify-content="center" padding=0 border-radius=18 class=Glass color="ink" aria-label=(k == "del" ? "Delete" : k == "." ? "Decimal point" : k) testId=`key-${k == "." ? "dot" : k}`
                if k == "del"
                  image "symbol:icon.backspace" font-size="min(-exact-title3, 26px)" aria-hidden=true
                else
                  text k class=Num font-size="min(-exact-title1, 34px)" font-weight=600

component DepositForm
  props
    goals: Goal[]
    goal: Goal
    cents: number
    checking: number
    error: string
    still: bool
    choose: action
    set: action
    nudge: action
  view
    column width="100%" max-width="30rem" box-sizing="border-box" margin-left="auto" margin-right="auto" padding="8px 20px 12px" gap=20
      row role="radiogroup" aria-label="Goal" flex-wrap="wrap" gap=8
        for g in goals key=g.id
          button role="radio" aria-checked=(g.id == goal.id) press=choose(g.id) class=Chip min-height=36 background-color=(g.id == goal.id ? g.tint : "card-2") color=(g.id == goal.id ? "on-accent" : "ink") testId=`pick-goal-${g.id}`
            image goalIcon(g.icon) aria-hidden=true
            text g.name
      column position="relative" border-radius=32 overflow="hidden"
        Aurora(kind="mint", still=still)
        column position="relative" class=Glass margin=8 border-radius=26 padding=22 gap=18 align-items="center"
          Ring(size=150, width=14, fraction=frac(goal.saved + cents, goal.target), from=goal.tint, to="accent", track="glass-edge", gid="deposit-ring", still=still)
            column align-items="center" gap=0
              text pct(goal.saved + cents, goal.target) class=Num font-size="min(-exact-title1, 36px)" letter-spacing="-1px" testId="deposit-pct"
              text "after this" class=Caption font-size="min(-exact-footnote, 16px)" font-weight=600
          row align-items="center" justify-content="center" gap=14 width="100%"
            button press=nudge(-1000) class=Round width=48 height=48 border-radius=24 background-color="glass-strong" color="ink" aria-label="Ten dollars less" testId="deposit-less"
              image "symbol:icon.minus"
            text money(cents) class=Num font-size="min(-exact-large-title, 40px)" letter-spacing="-1px" -exact-fit="shrink" white-space="nowrap" flex="0 1 auto" min-width=0 text-align="center" testId="deposit-amount"
            button press=nudge(1000) class=Round width=48 height=48 border-radius=24 background-color="glass-strong" color="ink" aria-label="Ten dollars more" testId="deposit-more"
              image "symbol:icon.plus"
      row flex-wrap="wrap" gap=8
        for c in [2500, 5000, 10000, 25000] key=c
          button press=set(c) appearance="none" flex="1 1 4rem" min-height=40 padding="6px 4px" border-radius=14 border=(cents == c ? "2px solid accent" : "1px solid line") background-color=(cents == c ? "accent-soft" : "card") color="ink" font-size="0.875rem" font-weight=650 testId=`quick-${c}`
            text rounded(c)
      text `From Everyday · ${money(checking)} available` class=Caption text-align="center"
      if error != ""
        text error role="alert" color="flame" font-size="0.875rem" text-align="center" testId="deposit-error"

component ProfileView
  props
    b: Board
    still: bool
    alerts: bool
    faceId: bool
    setAlerts: action
    setFaceId: action
  slot
  view
    column width="100%" max-width="32.5rem" box-sizing="border-box" margin-left="auto" margin-right="auto" padding="12px 20px 28px" gap=18
      column position="relative" border-radius=34 overflow="hidden" testId="profile-card"
        Aurora(kind="dusk", still=still)
        column position="relative" class=Glass margin=8 border-radius=28 padding=22 gap=18
          row flex-wrap="wrap" align-items="center" gap=16
            column width=68 height=68 flex-shrink=0 border-radius=34 align-items="center" justify-content="center" background-image="linear-gradient(135deg, var(--cta) 0%, var(--cta-2) 100%)" box-shadow="0 0 0 4px glass-edge"
              text initials(b.profile.name) class=Num font-size="min(-exact-title2, 28px)" color="on-accent"
            column flex="1 1 10rem" min-width=0 gap=4
              text b.profile.name font-size="1.375rem" font-weight=800 letter-spacing="-0.5px" testId="profile-name"
              text b.profile.email class=Caption
          row flex-wrap="wrap" row-gap=14 gap=12
            Stat(icon="symbol:icon.wallet", tint="accent", label="Net worth", value=rounded(b.net))
            Stat(icon="symbol:icon.card", tint="grape", label="Cards", value=`${b.cards.length}`)
            Stat(icon="symbol:icon.target", tint="tide", label="Goals", value=`${b.goals.length}`)
      column class=Card gap=0 padding="4px 20px" testId="settings"
        row flex-wrap="wrap" align-items="center" column-gap=14 row-gap=8 padding-top=12 padding-bottom=12
          column class=Tile width=34 height=34 border-radius=11 background-color="rose-soft" color="rose"
            image "symbol:icon.bell" font-size="min(-exact-callout, 20px)" aria-hidden=true
          column flex="1 1 9rem" min-width=0 gap=2
            text "Payment alerts" font-size="1rem" font-weight=600
            text "Every card payment, as it happens." class=Caption
          input type="checkbox" switch checked=alerts change=setAlerts aria-label="Payment alerts" testId="alerts"
        row flex-wrap="wrap" align-items="center" column-gap=14 row-gap=8 padding-top=12 padding-bottom=12 border-top="1px solid line"
          column class=Tile width=34 height=34 border-radius=11 background-color="mint-soft" color="mint"
            image "symbol:icon.scan" font-size="min(-exact-callout, 20px)" aria-hidden=true
          column flex="1 1 9rem" min-width=0 gap=2
            text "Unlock with Face ID" font-size="1rem" font-weight=600
            text "Asked each time Lumen opens." class=Caption
          input type="checkbox" switch checked=faceId change=setFaceId aria-label="Unlock with Face ID" testId="face-id"
        CardRow(icon="symbol:icon.bank", tint="accent", label="Linked banks", value="2")
        CardRow(icon="symbol:icon.receipt", tint="amber", label="Statements", value="Monthly")
      children

component Welcome
  props
    phone: bool
    still: bool
    begin: action
  view
    column min-height="100%" width="100%" max-width="32.5rem" box-sizing="border-box" margin-left="auto" margin-right="auto" padding=(phone ? "56px 22px 28px" : "72px 28px 40px") gap=30 justify-content="space-between" testId="welcome"
      column align-items="center" gap=22 text-align="center" animation=(still ? "none" : "rise 800ms cubic-bezier(0.2, 0.8, 0.2, 1) both")
        column class=Glass width="6rem" height="6rem" border-radius=30 align-items="center" justify-content="center" color="accent"
          image "symbol:icon.sparkle" font-size="3rem" aria-hidden=true
        column align-items="center" gap=14
          text "LUMEN" class=Eyebrow letter-spacing="5px" color="ink"
          text "Money, in a clearer light." role="heading" aria-level=1 font-size="min(-exact-large-title, 56px)" font-weight=800 letter-spacing="-1.5px" line-height=1.1
          text "Every account, card and goal in one calm place, with budgets that keep pace with you." font-size="1.0625rem" line-height=1.45 color="ink-2" max-width="25rem"
      column class=Glass border-radius=28 padding="6px 18px" animation=(still ? "none" : "rise 800ms 120ms cubic-bezier(0.2, 0.8, 0.2, 1) both")
        Feature(icon="symbol:icon.growth", tint="accent", title="See your whole picture", detail="Net worth across every account, day by day.", first=true)
        Feature(icon="symbol:icon.pie", tint="amber", title="Budgets that pace you", detail="Know what is left before you tap to pay.", first=false)
        Feature(icon="symbol:icon.target", tint="tide", title="Goals you can feel", detail="Set money aside for what matters next.", first=false)
      column gap=10 animation=(still ? "none" : "rise 800ms 240ms cubic-bezier(0.2, 0.8, 0.2, 1) both")
        button press=begin class=Pill testId="get-started"
          text "Get started"
          image "symbol:icon.arrow" aria-hidden=true

component Feature
  props
    icon: string
    tint: string
    title: string
    detail: string
    first: bool
  view
    row align-items="center" gap=14 padding-top=14 padding-bottom=14 border-top=(first ? "none" : "1px solid glass-edge")
      column class=Tile width=40 height=40 border-radius=13 background-color=`${tint}-soft` color=tint
        image icon font-size="min(-exact-title3, 24px)" aria-hidden=true
