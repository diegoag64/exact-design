forma lumen

theme
  AccentColor = light-dark(#4b45e0, #5f58f0)
  page = light-dark(#f3f4f9, #05060b)
  card = light-dark(#ffffff, #11121a)
  card-2 = light-dark(#eceef6, #1a1c27)
  line = light-dark(#e3e5ef, #232634)
  ink = light-dark(#0d0f1f, #f2f3fa)
  ink-2 = light-dark(#535872, #b7bbd1)
  ink-3 = light-dark(#7d8299, #868aa3)
  glass = light-dark(#ffffff8f, #151722a3)
  glass-strong = light-dark(#ffffffd1, #1c1f2ec9)
  glass-edge = light-dark(#ffffffe6, #ffffff24)
  glass-shade = light-dark(#1b20521c, #00000073)
  accent = light-dark(#4b45e0, #8e8cff)
  accent-2 = light-dark(#8b3ff0, #b78cff)
  accent-soft = light-dark(#e9e8ff, #1b1a3f)
  accent-ink = light-dark(#3d36c4, #aeacff)
  cta = light-dark(#4b45e0, #5852ee)
  cta-2 = light-dark(#8b3ff0, #8f45ea)
  mint = light-dark(#06704c, #3ee3a4)
  mint-2 = light-dark(#14b886, #7ff0c4)
  mint-soft = light-dark(#dcf5ea, #0b2a1f)
  flame = light-dark(#bd282e, #ff7a7e)
  flame-soft = light-dark(#fde5e5, #331415)
  amber = light-dark(#8f5300, #ffc14d)
  amber-soft = light-dark(#fdf0d9, #2e2208)
  sky = light-dark(#065c9b, #5cc8ff)
  sky-soft = light-dark(#dff0fb, #0a2333)
  rose = light-dark(#a8215f, #ff6fae)
  rose-soft = light-dark(#fce4ef, #33112a)
  grape = light-dark(#6a2fd0, #b48dff)
  grape-soft = light-dark(#efe6fe, #221539)
  tide = light-dark(#056a75, #4fdde9)
  tide-soft = light-dark(#dcf3f5, #082a2e)
  aura-1 = light-dark(#8f8bff, #3d32e6)
  aura-2 = light-dark(#e3a3ff, #8a2be2)
  aura-3 = light-dark(#8fe3ff, #0b7fc4)
  aura-4 = light-dark(#9ff2cf, #0c9a6c)
  aura-5 = light-dark(#ffb4d0, #c21f6a)
  aura-6 = light-dark(#ffd5a8, #c76a12)
  on-accent = #ffffff  scheme=fixed
  card-ink = #ffffff  scheme=fixed
  card-ink-2 = #ffffffb8  scheme=fixed
  card-sheen = #ffffff2e  scheme=fixed
  midnight-1 = #1d1f3a  scheme=fixed
  midnight-2 = #050611  scheme=fixed
  iris-1 = #6b5cff  scheme=fixed
  iris-2 = #c04be8  scheme=fixed
  lagoon-1 = #0fb5a4  scheme=fixed
  lagoon-2 = #1d5fd6  scheme=fixed
  chip-1 = #f3d38a  scheme=fixed
  chip-2 = #b88a2e  scheme=fixed

icons
  icon.home = icon(sf "house.fill", svg "icons/house.svg")
  icon.swap = icon(sf "arrow.left.arrow.right", svg "icons/arrows-left-right.svg")
  icon.card = icon(sf "creditcard.fill", svg "icons/credit-card.svg")
  icon.pie = icon(sf "chart.pie.fill", svg "icons/chart-pie-slice.svg")
  icon.target = icon(sf "target", svg "icons/target.svg")
  icon.send = icon(sf "arrow.up.right", svg "icons/arrow-up-right.svg")
  icon.receive = icon(sf "arrow.down.left", svg "icons/arrow-down-left.svg")
  icon.plus = icon(sf "plus", svg "icons/plus.svg")
  icon.minus = icon(sf "minus", svg "icons/minus.svg")
  icon.close = icon(sf "xmark", svg "icons/x.svg")
  icon.check = icon(sf "checkmark", svg "icons/check.svg")
  icon.next = icon(sf "chevron.right", svg "icons/caret-right.svg")
  icon.search = icon(sf "magnifyingglass", svg "icons/magnifying-glass.svg")
  icon.arrow = icon(sf "arrow.right", svg "icons/arrow-right.svg")
  icon.bank = icon(sf "building.columns.fill", svg "icons/bank.svg")
  icon.wallet = icon(sf "wallet.pass.fill", svg "icons/wallet.svg")
  icon.piggy = icon(sf "dollarsign.circle.fill", svg "icons/piggy-bank.svg")
  icon.growth = icon(sf "chart.line.uptrend.xyaxis", svg "icons/chart-line-up.svg")
  icon.up = icon(sf "arrow.up.right", svg "icons/trend-up.svg")
  icon.down = icon(sf "arrow.down.right", svg "icons/trend-down.svg")
  icon.freeze = icon(sf "snowflake", svg "icons/snowflake.svg")
  icon.lock = icon(sf "lock.fill", svg "icons/lock.svg")
  icon.eye = icon(sf "eye.fill", svg "icons/eye.svg")
  icon.bell = icon(sf "bell.fill", svg "icons/bell.svg")
  icon.person = icon(sf "person.fill", svg "icons/user.svg")
  icon.sparkle = icon(sf "sparkles", svg "icons/sparkle.svg")
  icon.dining = icon(sf "fork.knife", svg "icons/fork-knife.svg")
  icon.groceries = icon(sf "cart.fill", svg "icons/shopping-cart.svg")
  icon.transport = icon(sf "car.fill", svg "icons/car.svg")
  icon.shopping = icon(sf "bag.fill", svg "icons/shopping-bag.svg")
  icon.bills = icon(sf "bolt.fill", svg "icons/lightning.svg")
  icon.fun = icon(sf "popcorn.fill", svg "icons/popcorn.svg")
  icon.travel = icon(sf "airplane", svg "icons/airplane.svg")
  icon.health = icon(sf "heart.fill", svg "icons/heartbeat.svg")
  icon.laptop = icon(sf "laptopcomputer", svg "icons/laptop.svg")
  icon.umbrella = icon(sf "umbrella.fill", svg "icons/umbrella.svg")
  icon.shield = icon(sf "checkmark.shield.fill", svg "icons/shield-check.svg")
  icon.globe = icon(sf "globe", svg "icons/globe.svg")
  icon.receipt = icon(sf "receipt.fill", svg "icons/receipt.svg")
  icon.refresh = icon(sf "arrow.clockwise", svg "icons/arrow-clockwise.svg")
