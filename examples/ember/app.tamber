tamber ember

theme
  AccentColor = light-dark(#e8461f, #e5461d)
  page = light-dark(#f6f4f1, #07070a)
  card = light-dark(#ffffff, #141419)
  card-2 = light-dark(#f2efeb, #1d1d24)
  line = light-dark(#ebe7e2, #26262e)
  ink = light-dark(#141317, #f4f3f6)
  ink-2 = light-dark(#57535d, #c4c1cf)
  ink-3 = light-dark(#a6a2ab, #5f5d68)
  glass = light-dark(#ffffff9e, #17171fa6)
  glass-strong = light-dark(#ffffffd1, #1b1b23c7)
  glass-edge = light-dark(#ffffffe6, #ffffff24)
  glass-shade = light-dark(#2a1a1014, #00000066)
  ember = light-dark(#e8461f, #ff6a45)
  ember-2 = light-dark(#ff9a3c, #ffab55)
  ember-soft = light-dark(#ffe9e1, #2e140c)
  ember-ink = light-dark(#b8340f, #ff8a66)
  cta = light-dark(#e64a1e, #e2481f)
  cta-2 = light-dark(#d6336b, #d0306a)
  rose = light-dark(#e23a74, #ff5c93)
  rose-soft = light-dark(#fde6ee, #33121f)
  amber = light-dark(#e99a0c, #ffbe3d)
  amber-soft = light-dark(#fdf1d8, #2e2209)
  iris = light-dark(#6a5af9, #8f83ff)
  iris-soft = light-dark(#ebe9ff, #1d1a3a)
  fern = light-dark(#4f9e17, #a3e84a)
  fern-2 = light-dark(#16b38a, #3fe0b0)
  fern-soft = light-dark(#e7f5dc, #16240c)
  sky = light-dark(#1b8fd6, #4cc3ff)
  sky-2 = light-dark(#6a5af9, #8f83ff)
  sky-soft = light-dark(#e1f1fb, #0b2231)
  aura-1 = light-dark(#ff8a5c, #ff4f1f)
  aura-2 = light-dark(#ff6fa8, #d6246a)
  aura-3 = light-dark(#ffc56b, #ff9c1a)
  aura-4 = light-dark(#b9a8ff, #5b3df5)
  aura-5 = light-dark(#8ee6c4, #0fb07f)
  aura-6 = light-dark(#9fd8ff, #1d7fd6)
  on-accent = #ffffff  scheme=fixed

